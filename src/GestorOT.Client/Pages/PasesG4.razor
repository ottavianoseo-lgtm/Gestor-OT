@page "/pases-g4"
@using GestorOT.Shared.Dtos
@using GestorOT.Client.Components.Pases
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IJSRuntime JS
@inject IMessageService Message

<PageTitle>Pases G4 - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Pases G4</h2>
        <span class="page-subtitle">Exportación de Órdenes de Trabajo y Labores al modelo contable de GestorMax G4</span>
    </div>
    <div style="display: flex; gap: 8px;">
        <Button Type="@ButtonType.Primary" Icon="plus" OnClick="AbrirModalGenerar"
                Style="background: #2ECC71; border-color: #2ECC71; border-radius: 8px; font-weight: 600;">
            Generar Lote de Pases
        </Button>
    </div>
</div>

<Tabs DefaultActiveKey="lotes">
    <TabPane Key="lotes" Tab="Lotes Generados">
        @if (_loading)
        {
            <div style="text-align: center; padding: 60px;">
                <Spin Size="AntDesign.SpinSize.Large" Tip="Cargando historial de lotes G4..." />
            </div>
        }
        else if (!_lotes.Any())
        {
            <div class="glass-card" style="text-align: center; padding: 60px;">
                <Icon Type="inbox" Theme="IconThemeType.Outline" Style="font-size: 48px; color: rgba(255,255,255,0.4); margin-bottom: 16px; display: block;" />
                <h3 style="color: #fff; font-size: 18px; font-weight: 700; margin-bottom: 8px;">Sin lotes de pases generados</h3>
                <p style="color: rgba(255,255,255,0.5); font-size: 13px; max-width: 400px; margin: 0 auto 20px;">
                    Generá tu primer lote de pases a partir de Órdenes de Trabajo o labores sueltas finalizadas para importar a GestorMax G4.
                </p>
                <Button Type="@ButtonType.Primary" Icon="plus" OnClick="AbrirModalGenerar"
                        Style="background: #2ECC71; border-color: #2ECC71; border-radius: 8px;">
                    Generar primer lote
                </Button>
            </div>
        }
        else
        {
            <div class="glass-card">
                <Table DataSource="_lotes" Size="@TableSize.Middle">
                    <PropertyColumn Property="c => c.Id" Title="Lote ID" Sortable>
                        <span style="font-family: monospace; color: rgba(255,255,255,0.7);">@context.Id.ToString()[..8]...</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Descripcion" Title="Descripción">
                        <span style="font-weight: 600; color: #fff;">@(string.IsNullOrEmpty(context.Descripcion) ? "—" : context.Descripcion)</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.TotalPases" Title="Total Pases" Sortable>
                        <span style="font-family: monospace; font-weight: 700; color: #2ECC71;">@context.TotalPases</span>
                    </PropertyColumn>
                    <Column TData="string" Title="Estado">
                        <Tag Color="@("green")">@context.Estado</Tag>
                    </Column>
                    <PropertyColumn Property="c => c.GeneradoEn" Title="Generado El" Sortable Format="dd/MM/yyyy HH:mm" />
                    <ActionColumn Title="Acciones">
                        <Button Size="@ButtonSize.Small" Icon="download" OnClick="() => DescargarXlsx(context.Id)"
                                Style="border-radius: 6px; background: rgba(46, 204, 113, 0.15); border-color: rgba(46, 204, 113, 0.3); color: #2ECC71;">
                            Descargar XLSX
                        </Button>
                    </ActionColumn>
                </Table>
            </div>
        }
    </TabPane>

    <TabPane Key="configs" Tab="Configuración Contable G4">
        <div class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <div>
                    <h3 style="color: #fff; font-weight: 700; font-size: 16px; margin: 0;">Configuración de Cuentas y Perfiles por Tipo de Labor</h3>
                    <span style="font-size: 12px; color: rgba(255,255,255,0.5);">Definí cómo imputa cada tipo de labor en GestorMax G4 (Perfiles de Imputación o Cuentas Directas)</span>
                </div>
                <Button Type="@ButtonType.Default" Icon="plus" OnClick="AgregarNuevaConfiguracion">
                    Nueva Regla
                </Button>
            </div>

            @if (_loadingConfigs)
            {
                <div style="text-align: center; padding: 40px;">
                    <Spin Tip="Cargando configuraciones contables..." />
                </div>
            }
            else
            {
                <Table DataSource="_configs" Size="@TableSize.Middle">
                    <PropertyColumn Property="c => c.LaborTypeName" Title="Tipo de Labor">
                        <span style="font-weight: 700; color: #fff;">@(string.IsNullOrEmpty(context.LaborTypeName) ? "General / Defecto" : context.LaborTypeName)</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.Description" Title="Nombre / Descripción">
                        <span style="color: rgba(255,255,255,0.9);">@(string.IsNullOrEmpty(context.Description) ? "—" : context.Description)</span>
                    </PropertyColumn>
                    <PropertyColumn Property="c => c.CodEmpresa" Title="Empresa" />
                    <PropertyColumn Property="c => c.CodComprobante" Title="Comprobante" />
                    <Column TData="string" Title="Modo de Imputación">
                        @if (context.CodPerfilDebe.HasValue || context.CodPerfilHaber.HasValue)
                        {
                            <Tag Color="@("blue")">Perfil Imputación (@context.CodPerfilDebe / @context.CodPerfilHaber)</Tag>
                        }
                        else if (context.CodCuentaDebeGestion.HasValue || context.CodCuentaHaberGestion.HasValue)
                        {
                            <Tag Color="@("gold")">Cuenta Directa (@context.CodCuentaDebeGestion / @context.CodCuentaHaberGestion)</Tag>
                        }
                        else
                        {
                            <Tag Color="@("green")">Defecto Estándar</Tag>
                        }
                    </Column>
                    <ActionColumn Title="Acciones">
                        <Button Size="@ButtonSize.Small" Icon="setting" OnClick="() => EditarConfiguracion(context)"
                                Style="border-radius: 6px;">
                            Configurar
                        </Button>
                    </ActionColumn>
                </Table>
            }
        </div>
    </TabPane>
</Tabs>

<GenerarLotePasesDrawer IsOpen="@_modalGenerarVisible"
                        IsOpenChanged="v => _modalGenerarVisible = v"
                        OnLoteGenerado="RecargarLotes" />

<ConfiguracionG4Modal Visible="@_modalConfigVisible"
                      VisibleChanged="v => _modalConfigVisible = v"
                      Configuration="_selectedConfig"
                      OnSaved="RecargarConfigs" />

@code {
    private List<PaseLoteDto> _lotes = new();
    private List<AccountConfigurationDto> _configs = new();
    private bool _loading = true;
    private bool _loadingConfigs = true;
    private bool _modalGenerarVisible;
    private bool _modalConfigVisible;
    private AccountConfigurationDto? _selectedConfig;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RecargarLotes(), RecargarConfigs());
    }

    private async Task RecargarLotes()
    {
        _loading = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<PaseLoteDto>>("api/pases/lotes");
            _lotes = res?.OrderByDescending(l => l.GeneradoEn).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar lotes: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RecargarConfigs()
    {
        _loadingConfigs = true;
        try
        {
            var res = await Http.GetFromJsonAsync<List<AccountConfigurationDto>>("api/pases/account-configurations");
            _configs = res?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar configuraciones: {ex.Message}");
        }
        finally
        {
            _loadingConfigs = false;
            StateHasChanged();
        }
    }

    private void AbrirModalGenerar() => _modalGenerarVisible = true;

    private void EditarConfiguracion(AccountConfigurationDto config)
    {
        _selectedConfig = config;
        _modalConfigVisible = true;
    }

    private void AgregarNuevaConfiguracion()
    {
        _selectedConfig = new AccountConfigurationDto(
            Guid.Empty, Guid.Empty, null, "General / Defecto",
            "", "", "", true, 1, 1, 1, 1, null, null, null,
            false, false, false, false, null, null, null, null, null, null, null, null
        );
        _modalConfigVisible = true;
    }

    private async Task DescargarXlsx(Guid loteId)
    {
        try
        {
            var url = $"api/pases/lotes/{loteId}/export";
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Message.Error($"Error al solicitar descarga: {ex.Message}");
        }
    }
}
