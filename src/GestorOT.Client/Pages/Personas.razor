@page "/personas"
@using GestorOT.Shared.Dtos
@using GestorOT.Shared
@using GestorOT.Domain.Enums
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.TenantState TenantState
@implements IDisposable

<PageTitle>Personas - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Personas</h2>
        <span class="page-subtitle">Gestión de personas operativas. Active personas del ERP y administre su modalidad.</span>
    </div>
    <div style="display: flex; gap: 8px;">
        <Button Icon="user-add" OnClick="OpenActivationModal">Activar persona del ERP</Button>
        <Button Icon="sync" OnClick="SyncFromErp" Loading="_syncing">Sincronizar con ERP</Button>
    </div>
</div>

@* La sincronización ya deja como contacto a toda persona habilitada en el ERP, así que la
   tabla lista contactos (paginados en la API: son miles). Activar a mano queda para las que no. *@
<div class="glass-card">
    <RemoteTable @ref="_table"
                 TItem="ContactDto"
                 Load="LoadContacts"
                 SortKeys="@SortKeys"
                 StateKey="personas"
                 SearchPlaceholder="Buscar por nombre, razón social, email o CUIT..."
                 ItemLabel="personas"
                 RowKey="c => c.Id.ToString()">
        <Filters>
            <SelectFilter Param="roles" Placeholder="Modalidad" Options="@RoleOptions" Style="width: 160px;" />
        </Filters>
        <ChildContent>
            <PropertyColumn Property="c => c.FullName" Title="Nombre Completo" Sortable DefaultSortOrder="@SortDirection.Ascending" />
            <PropertyColumn Property="c => c.Position" Title="Cargo" />
            <PropertyColumn Property="c => c.Role" Title="Modalidad" Sortable>
                @{
                    var roleColor = context.Role switch
                    {
                        ContactRole.InternalStaff => "#2ECC71",
                        ContactRole.Contractor => "#E67E22",
                        ContactRole.Supplier => "#3498DB",
                        _ => "#95A5A6"
                    };
                }
                <div style="display: flex; align-items: center; gap: 8px;">
                    <Tag Style="@($"background: {roleColor}20; color: {roleColor}; border: 1px solid {roleColor}40; border-radius: 8px; font-size: 11px;")">@RoleLabel(context.Role)</Tag>
                    <Select TItemValue="ContactRole" TItem="ContactRole"
                            Value="context.Role" ValueChanged="(v) => UpdateModality(context, v)"
                            Style="width: 120px;" Trigger="click">
                        <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.InternalStaff" Label="Propio" />
                        <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Contractor" Label="Contratista" />
                        <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Supplier" Label="Proveedor" />
                        <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Unclassified" Label="Sin clasificar" />
                    </Select>
                </div>
            </PropertyColumn>
            <PropertyColumn Property="c => c.Email" Title="Email" />
            <PropertyColumn Property="c => c.VatNumber" Title="CUIT/VAT" />
        </ChildContent>
    </RemoteTable>
</div>

<Modal Title="Activar Contacto" Visible="@_activationModalVisible" OnCancel="() => _activationModalVisible = false" Footer="null">
    <div style="margin-bottom: 20px;">
        <div style="margin-bottom: 8px; color: #fff;">Persona del ERP:</div>
        @* Solo las que todavía no son contacto, y como mucho unas pocas por vez: un Select con
           miles de opciones congela WASM. *@
        <Select TItemValue="string" TItem="string" Value="@_selectedPersonId" ValueChanged="OnPersonChanged"
                Placeholder="Buscar por nombre o CUIT..." EnableSearch AllowClear Loading="_loadingPeople"
                OnSearch="OnPersonSearch" Style="width: 100%; margin-bottom: 16px;">
            @foreach (var person in CandidatePeople)
            {
                <SelectOption TItemValue="string" TItem="string" Value="@person.Id.ToString()"
                              Label="@(string.IsNullOrEmpty(person.VatNumber) ? person.FullName : $"{person.FullName} ({person.VatNumber})")" />
            }
        </Select>
        @if (_selectedPerson != null)
        {
            <p style="color: rgba(255,255,255,0.7); margin-bottom: 16px;">
                Está a punto de activar a <strong>@_selectedPerson.FullName</strong> en Gestor-OT.
                Por favor, asigne la modalidad:
            </p>
            <div style="margin-bottom: 8px; color: #fff;">Modalidad:</div>
            <Select TItemValue="ContactRole" TItem="ContactRole" @bind-Value="_selectedRole" Style="width: 100%;">
                <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.InternalStaff" Label="Propio" />
                <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Contractor" Label="Contratista" />
                <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Supplier" Label="Proveedor" />
                <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@ContactRole.Unclassified" Label="Sin clasificar" />
            </Select>
        }
    </div>
    <div style="text-align: right;">
        <Button OnClick="() => _activationModalVisible = false" Style="margin-right: 8px;">Cancelar</Button>
        <Button Type="@ButtonType.Primary" Loading="_activating" Disabled="_selectedPerson == null" OnClick="ActivateSelectedPerson">
            Confirmar Activación
        </Button>
    </div>
</Modal>

@code {
    private RemoteTable<ContactDto>? _table;

    private List<ErpPersonDto> _people = new();
    private int _personSearchVersion;
    private bool _loadingPeople;
    private string? _personSearch;
    private string? _selectedPersonId;

    private bool _activationModalVisible = false;
    private ErpPersonDto? _selectedPerson;
    private ContactRole _selectedRole = ContactRole.InternalStaff;
    private bool _activating = false;
    private bool _syncing = false;

    // Valor = int de ContactRole, que es lo que espera el parámetro "roles" de la API.
    private static readonly List<FilterOption> RoleOptions = new()
    {
        new(((int)ContactRole.InternalStaff).ToString(), "Propio"),
        new(((int)ContactRole.Contractor).ToString(), "Contratista"),
        new(((int)ContactRole.Supplier).ToString(), "Proveedor"),
        new(((int)ContactRole.Unclassified).ToString(), "Sin clasificar"),
    };

    // Propiedad de la columna → clave de orden de api/catalogs/contacts/search.
    private static readonly IReadOnlyDictionary<string, string> SortKeys = new Dictionary<string, string>
    {
        [nameof(ContactDto.FullName)] = "name",
        [nameof(ContactDto.Role)] = "role",
    };

    private Task<PagedResult<ContactDto>?> LoadContacts(string query, CancellationToken ct) =>
        Http.GetFromJsonAsync<PagedResult<ContactDto>>($"api/catalogs/contacts/search?{query}", ct);

    private static string RoleLabel(ContactRole role) => role switch
    {
        ContactRole.InternalStaff => "Propio",
        ContactRole.Contractor => "Contratista",
        ContactRole.Supplier => "Proveedor",
        ContactRole.Unclassified => "Sin clasificar",
        _ => role.GetDisplayName()
    };

    private IEnumerable<ErpPersonDto> CandidatePeople
    {
        get
        {
            var list = _people.ToList();
            // La elegida se sigue mostrando aunque la búsqueda ya no la traiga.
            if (_selectedPerson != null && list.All(p => p.Id != _selectedPerson.Id))
                list.Insert(0, _selectedPerson);
            return list;
        }
    }

    protected override void OnInitialized()
    {
        TenantState.OnChange += OnTenantChanged;
    }

    public void Dispose()
    {
        TenantState.OnChange -= OnTenantChanged;
    }

    private void OnTenantChanged()
    {
        InvokeAsync(ReloadTable);
    }

    private async Task ReloadTable()
    {
        if (_table != null)
            await _table.ReloadAsync();
    }

    // El directorio del ERP solo hace falta para activar: se buscan en la API las que todavía
    // no son contacto, de a 50, a medida que se escribe.
    private async Task LoadErpPeople()
    {
        // Se descarta la respuesta de una búsqueda vieja en vez de cancelarla: el handler HTTP
        // muestra cualquier cancelación como "timeout".
        var version = ++_personSearchVersion;

        _loadingPeople = true;
        StateHasChanged();
        try
        {
            var page = await Http.GetFromJsonAsync<PagedResult<ErpPersonDto>>(
                $"api/erppeople/search?page=1&pageSize=50&activated=false&search={Uri.EscapeDataString(_personSearch ?? "")}");
            if (version != _personSearchVersion) return;
            _people = page?.Items ?? new();
        }
        catch (Exception ex) when (version == _personSearchVersion)
        {
            Message.Error($"Error cargando personas del ERP: {ex.Message}");
        }
        catch
        {
        }
        finally
        {
            if (version == _personSearchVersion)
            {
                _loadingPeople = false;
                StateHasChanged();
            }
        }
    }

    private async Task UpdateModality(ContactDto contact, ContactRole newRole)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/catalogs/contacts/{contact.Id}/role", new { Role = newRole });
            if (response.IsSuccessStatusCode)
            {
                Message.Success($"Modalidad de {contact.FullName} actualizada.");
                await ReloadTable();
            }
            else
            {
                Message.Error("No se pudo actualizar la modalidad.");
            }
        }
        catch
        {
            Message.Error("Error al actualizar modalidad.");
        }
    }

    private async Task OpenActivationModal()
    {
        _selectedPerson = null;
        _selectedPersonId = null;
        _personSearch = null;
        _selectedRole = ContactRole.InternalStaff;
        _activationModalVisible = true;
        await LoadErpPeople();
    }

    private void OnPersonSearch(string text)
    {
        _personSearch = text;
        _ = InvokeAsync(async () =>
        {
            // Un poco de espera para no pegarle a la API en cada tecla.
            var current = text;
            await Task.Delay(250);
            if (current == _personSearch)
                await LoadErpPeople();
        });
    }

    private void OnPersonChanged(string? id)
    {
        _selectedPersonId = id;
        _selectedPerson = id is null ? null : _people.FirstOrDefault(p => p.Id.ToString() == id);
    }

    private async Task ActivateSelectedPerson()
    {
        if (_selectedPerson == null) return;

        _activating = true;
        try
        {
            var request = new ActivateContactRequest
            {
                ErpPersonId = _selectedPerson.Id,
                Role = _selectedRole
            };

            var response = await Http.PostAsJsonAsync("api/erppeople/activate", request, AppJsonSerializerContext.Default.ActivateContactRequest);

            if (response.IsSuccessStatusCode)
            {
                Message.Success("Contacto activado exitosamente.");
                _activationModalVisible = false;
                await ReloadTable();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al activar: {error}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _activating = false;
            StateHasChanged();
        }
    }

    private async Task SyncFromErp()
    {
        _syncing = true;
        try
        {
            var response = await Http.PostAsync($"api/tenants/{TenantState.CurrentTenant?.Id}/sync-contacts", null);
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Sincronización completada.");
                await ReloadTable();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message.Error($"Error sincronizando: {error}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _syncing = false;
        }
    }
}
