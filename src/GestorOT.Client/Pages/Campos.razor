@page "/fields"
@using GestorOT.Shared.Dtos
@using GestorOT.Shared
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject NavigationManager Navigation
@inject GestorOT.Client.Services.CampaignState CampaignState
@inject GestorOT.Client.Services.TenantState TenantState
@implements IDisposable

<PageTitle>Campos - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Gestión de Campos</h2>
        <span class="page-subtitle">@_fields.Count campos registrados</span>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
        @if (CampaignState.IsSelected)
        {
            <div style="display: flex; align-items: center; gap: 8px; background: rgba(46, 204, 113, 0.1); padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(46, 204, 113, 0.2);">
                <Icon Type="calendar" Theme="IconThemeType.Outline" Style="color: #2ECC71;" />
                <span style="color: #fff; font-size: 13px; font-weight: 600;">Campaña: @CampaignState.CurrentCampaign!.Name</span>
                <Checkbox @bind-Checked="_filterByCampaign" Style="margin-left: 8px; color: rgba(255,255,255,0.7); font-size: 12px;">Ver solo mis campos</Checkbox>
            </div>
        }
        <Button Type="@ButtonType.Primary" OnClick="OpenCreateModal"
                Style="background: #E74C3C; border-color: #E74C3C; border-radius: 8px; font-weight: 600;">
            <Icon Type="plus" Theme="IconThemeType.Outline" /> Nuevo Campo
        </Button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <Alert Type="@AlertType.Error" Message="@_errorMessage" ShowIcon="true" Closable="true" Style="margin-bottom: 16px;" />
}

<div class="glass-card">
    <Table TItem="FieldDto"
           DataSource="@FilteredFields"
           Loading="@_loading"
           Size="TableSize.Small"
           ScrollX="900">
        <PropertyColumn Property="c => c.Name" Title="Nombre del Campo" Sortable>
            <span style="font-weight: 600;">@context.Name</span>
        </PropertyColumn>
        <Column TData="int" Title="Lotes" Width="180">
            <Popover Placement="@Placement.BottomLeft" Trigger="@(new[] { Trigger.Click })">
                <TitleTemplate>
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 2px 0; min-width: 240px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <Icon Type="environment" Theme="IconThemeType.Outline" Style="color: #3498DB; font-size: 15px;" />
                            <span style="font-weight: 700; color: #fff; font-size: 13px;">Lotes de @context.Name</span>
                        </div>
                        <Tag Style="background: #3498DB20; color: #3498DB; border: 1px solid #3498DB40; border-radius: 10px; font-weight: 600; font-size: 11px;">
                            @context.Lots.Count @(context.Lots.Count == 1 ? "lote" : "lotes")
                        </Tag>
                    </div>
                </TitleTemplate>
                <ContentTemplate>
                    @if (context.Lots == null || !context.Lots.Any())
                    {
                        <div style="padding: 14px 16px; color: rgba(255,255,255,0.45); font-size: 12px; text-align: center; background: rgba(255,255,255,0.02); border-radius: 8px;">
                            <Icon Type="inbox" Theme="IconThemeType.Outline" Style="font-size: 20px; margin-bottom: 4px; display: block; color: rgba(255,255,255,0.25);" />
                            Este campo aún no tiene lotes asignados.
                        </div>
                    }
                    else
                    {
                        <div style="max-height: 260px; overflow-y: auto; width: 280px; padding-right: 2px;">
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                @foreach (var lot in context.Lots)
                                {
                                    <div class="lot-item-row" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: rgba(255,255,255,0.04); border-radius: 8px; border: 1px solid rgba(255,255,255,0.07); transition: all 0.2s;">
                                        <div style="display: flex; flex-direction: column; gap: 2px;">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <Icon Type="appstore" Theme="IconThemeType.Outline" Style="color: #3498DB; font-size: 12px;" />
                                                <span style="font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.9);">@lot.Name</span>
                                            </div>
                                            @if (lot.CadastralArea > 0)
                                            {
                                                <span style="font-size: 11px; color: rgba(255,255,255,0.45); padding-left: 18px;">
                                                    Superficie: <strong>@lot.CadastralArea.ToString("N1") Ha</strong>
                                                </span>
                                            }
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            <span style="font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; background: @(lot.Status == "Active" ? "rgba(46, 204, 113, 0.15)" : "rgba(255,255,255,0.1)"); color: @(lot.Status == "Active" ? "#2ECC71" : "rgba(255,255,255,0.5)"); border: 1px solid @(lot.Status == "Active" ? "rgba(46, 204, 113, 0.3)" : "rgba(255,255,255,0.15)");">
                                                @(lot.Status == "Active" ? "Activo" : lot.Status)
                                            </span>
                                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Title="Ver lote en el mapa" OnClick='() => Navigation.NavigateTo("/map")' Style="padding: 0 4px; height: auto;">
                                                <Icon Type="compass" Theme="IconThemeType.Outline" Style="color: #3498DB; font-size: 14px;" />
                                            </Button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </ContentTemplate>
                <ChildContent>
                    <button class="lots-dropdown-trigger" style="background: rgba(52, 152, 219, 0.12); color: #3498DB; border: 1px solid rgba(52, 152, 219, 0.3); border-radius: 20px; font-size: 12px; font-weight: 600; padding: 4px 12px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.2s ease;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span>@context.Lots.Count @(context.Lots.Count == 1 ? "lote" : "lotes")</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 2px;"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                </ChildContent>
            </Popover>
        </Column>
        <PropertyColumn Property="c => c.CreatedAt" Title="Creado" Sortable>
            @context.CreatedAt.ToString("dd/MM/yyyy")
        </PropertyColumn>
        <ActionColumn Title="Acciones" Width="160">
            <Space>
                <SpaceItem>
                    <Button Size="@ButtonSize.Small" OnClick="() => OpenEditModal(context)"
                            Style="border-radius: 6px; border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7);">
                        <Icon Type="edit" Theme="IconThemeType.Outline" />
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="¿Eliminar este campo? Se eliminarán todos sus lotes y OTs asociadas."
                                OnConfirm="() => DeleteField(context.Id)"
                                OkText="Eliminar" CancelText="Cancelar">
                        <Button Danger Size="@ButtonSize.Small" Style="border-radius: 6px;">
                            <Icon Type="delete" Theme="IconThemeType.Outline" />
                        </Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
</div>

<Modal Title="@(_isEditing ? "Editar Campo" : "Nuevo Campo")"
       Visible="_modalVisible"
       OnCancel="CloseModal"
       OnOk="SaveField"
       OkText="@(_isEditing ? "Guardar" : "Crear")"
       ConfirmLoading="_saving"
       Width="480">
    <Form @ref="_form" Model="_formModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Nombre del Campo">
            <Input @bind-Value="_formModel.Name" Placeholder="Ej: Estancia Santa Rosa" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<FieldDto> _fields = new();
    private List<CampaignFieldDto> _campaignFields = new();
    private bool _loading = true;
    private bool _filterByCampaign = true;
    private string? _errorMessage;
    private bool _modalVisible;
    private bool _isEditing;
    private bool _saving;
    private Guid _editingId;
    private FieldFormModel _formModel = new();
    private Form<FieldFormModel>? _form;

    private IEnumerable<FieldDto> FilteredFields =>
        _filterByCampaign && CampaignState.IsSelected
            ? _fields.Where(f => _campaignFields.Any(cf => cf.FieldId == f.Id))
            : _fields;

    public class FieldFormModel
    {
        public string Name { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        CampaignState.OnChange += OnCampaignChanged;
        TenantState.OnChange += OnCampaignChanged;
        await LoadData();
    }

    private void OnCampaignChanged()
    {
        InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
    }

    public void Dispose()
    {
        CampaignState.OnChange -= OnCampaignChanged;
        TenantState.OnChange -= OnCampaignChanged;
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            _fields = await Http.GetFromJsonAsync("api/fields",
                AppJsonSerializerContext.Default.ListFieldDto, cts.Token) ?? new();

            if (CampaignState.IsSelected)
            {
                var campaign = await Http.GetFromJsonAsync<CampaignDto>($"api/campaigns/{CampaignState.CurrentCampaign!.Id}",
                    AppJsonSerializerContext.Default.CampaignDto, cts.Token);
                _campaignFields = campaign?.Fields ?? new();
            }
            else
            {
                _campaignFields.Clear();
            }

            _errorMessage = null;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "La solicitud tardó demasiado tiempo. Intente recargar la página.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _formModel = new FieldFormModel();
        _modalVisible = true;
    }

    private void OpenEditModal(FieldDto field)
    {
        _isEditing = true;
        _editingId = field.Id;
        _formModel = new FieldFormModel { Name = field.Name };
        _modalVisible = true;
    }

    private void CloseModal()
    {
        _modalVisible = false;
    }

    private async Task SaveField()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Name))
        {
            Message.Warning("El nombre del campo es obligatorio.");
            return;
        }

        _saving = true;
        try
        {
            var dto = new FieldDto(
                _isEditing ? _editingId : Guid.Empty,
                _formModel.Name,
                DateTime.UtcNow,
                new List<LotSummaryDto>()
            );

            HttpResponseMessage response;
            if (_isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/fields/{_editingId}",
                    dto, AppJsonSerializerContext.Default.FieldDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/fields",
                    dto, AppJsonSerializerContext.Default.FieldDto);
            }

            if (response.IsSuccessStatusCode)
            {
                if (!_isEditing && CampaignState.IsSelected)
                {
                    var createdField = await response.Content.ReadFromJsonAsync<FieldDto>(AppJsonSerializerContext.Default.FieldDto);
                    if (createdField != null)
                    {
                        var fieldAddResp = await Http.PostAsJsonAsync($"api/campaigns/{CampaignState.CurrentCampaign!.Id}/fields",
                            new CampaignFieldDto(CampaignState.CurrentCampaign.Id, createdField.Id, createdField.Name, 0, 0),
                            AppJsonSerializerContext.Default.CampaignFieldDto);
                        
                        if (!fieldAddResp.IsSuccessStatusCode)
                        {
                            var fieldAddErr = await fieldAddResp.Content.ReadAsStringAsync();
                            Message.Warning($"El campo se creó pero no pudo asignarse a la campaña: {fieldAddErr}");
                        }
                    }
                }

                Message.Success(_isEditing ? "Campo actualizado correctamente." : "Campo creado correctamente.");
                _modalVisible = false;
                await LoadData();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al guardar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteField(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/fields/{id}");
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Campo eliminado correctamente.");
                await LoadData();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al eliminar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
    }
}

<style>
    .lots-dropdown-trigger:hover {
        background: rgba(52, 152, 219, 0.28) !important;
        border-color: rgba(52, 152, 219, 0.6) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);
    }

    .lot-item-row:hover {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(52, 152, 219, 0.35) !important;
    }
</style>
