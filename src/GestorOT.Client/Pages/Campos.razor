@page "/fields"
@using GestorOT.Shared.Dtos
@using GestorOT.Shared
@using System.Net.Http.Json
@using AntDesign
@using AntDesign.TableModels
@inject HttpClient Http
@inject IMessageService Message
@inject NavigationManager Navigation
@inject GestorOT.Client.Services.CampaignState CampaignState
@inject GestorOT.Client.Services.TenantState TenantState
@implements IDisposable

<PageTitle>Campos - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Gestión de Campos</h2>
        <span class="page-subtitle">@_total campos registrados</span>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
        <Button Type="@ButtonType.Primary" OnClick="OpenCreateModal"
                Style="background: #E74C3C; border-color: #E74C3C; border-radius: 8px; font-weight: 600;">
            <Icon Type="plus" Theme="IconThemeType.Outline" /> Nuevo Campo
        </Button>
    </div>
</div>

<div class="glass-card">
    <RemoteTable @ref="_table"
                 TItem="FieldListItemDto"
                 Load="LoadFields"
                 OnLoaded="OnFieldsLoaded"
                 FixedFilters="@FixedFilters"
                 StateKey="fields"
                 SearchPlaceholder="Buscar campo o lote..."
                 ItemLabel="campos"
                 RowKey="f => f.Id.ToString()"
                 ScrollX="900"
                 ExpandTemplate="@FieldLots">
        <ExtraOptions>
            @if (CampaignState.IsSelected)
            {
                <Checkbox Checked="@_onlyCampaign" CheckedChanged="v => _onlyCampaign = v"
                          Style="color: rgba(255,255,255,0.7); font-size: 12px;">Ver solo mis campos</Checkbox>
            }
        </ExtraOptions>
        <ChildContent>
        <PropertyColumn Property="c => c.Name" Title="Nombre del Campo" Sortable>
            <span style="font-weight: 600;">@context.Name</span>
        </PropertyColumn>
        <PropertyColumn Property="c => c.LotCount" Title="Lotes" Sortable Width="140">
            <span class="lots-dropdown-trigger" style="background: rgba(52, 152, 219, 0.12); color: #3498DB; border: 1px solid rgba(52, 152, 219, 0.3); border-radius: 20px; font-size: 12px; font-weight: 600; padding: 4px 12px; display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>@context.LotCount @(context.LotCount == 1 ? "lote" : "lotes")</span>
            </span>
        </PropertyColumn>
        <PropertyColumn Property="c => c.CadastralArea" Title="Superficie" Sortable Width="140">
            @context.CadastralArea.ToString("N1") Ha
        </PropertyColumn>
        <PropertyColumn Property="c => c.CreatedAt" Title="Creado" Sortable Width="120">
            @context.CreatedAt.ToString("dd/MM/yyyy")
        </PropertyColumn>
        <ActionColumn Title="Acciones" Width="160">
            <Space>
                <SpaceItem>
                    <Button Size="@ButtonSize.Small" OnClick="() => OpenEditModal(context)"
                            Style="border-radius: 6px; border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7);">
                        <Icon Type="edit" Theme="IconThemeType.Outline" />
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="¿Eliminar este campo? Se eliminarán todos sus lotes y OTs asociadas."
                                OnConfirm="() => DeleteField(context.Id)"
                                OkText="Eliminar" CancelText="Cancelar">
                        <Button Danger Size="@ButtonSize.Small" Style="border-radius: 6px;">
                            <Icon Type="delete" Theme="IconThemeType.Outline" />
                        </Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </ActionColumn>
        </ChildContent>
    </RemoteTable>
</div>

<Modal Title="@(_isEditing ? "Editar Campo" : "Nuevo Campo")"
       Visible="_modalVisible"
       OnCancel="CloseModal"
       OnOk="SaveField"
       OkText="@(_isEditing ? "Guardar" : "Crear")"
       ConfirmLoading="_saving"
       Width="480">
    <Form @ref="_form" Model="_formModel" Layout="@FormLayout.Vertical">
        <FormItem Label="Nombre del Campo">
            <Input @bind-Value="_formModel.Name" Placeholder="Ej: Estancia Santa Rosa" />
        </FormItem>
        <FormItem Label="Centro de costo (ERP)">
            <Select TItemValue="long?" TItem="ErpAccountDto" @bind-Value="_formModel.CodCentro"
                    Placeholder="@(_centros.Count == 0 ? "Sin centros cargados desde el ERP" : "Buscar centro...")"
                    AllowClear EnableSearch Loading="_loadingCentros"
                    DataSource="@_centros"
                    ItemLabel="x => x.DisplayName" ItemValue="x => (long?)x.CodCuenta"
                    Style="width: 100%;" />
            <div style="color: rgba(0,0,0,0.45); font-size: 11px; margin-top: 4px;">
                Lo heredan todos los lotes del campo. Un lote solo necesita centro propio cuando
                es una excepción al del campo.
            </div>
        </FormItem>
    </Form>
</Modal>

@code {
    private RemoteTable<FieldListItemDto>? _table;

    // "Ver solo mis campos": se manda como filtro fijo, así la tabla vuelve a la página 1 sola al tildarlo.
    private bool _onlyCampaign;

    private IReadOnlyDictionary<string, string?> FixedFilters => new Dictionary<string, string?>
    {
        ["campaignId"] = _onlyCampaign && CampaignState.IsSelected ? CampaignState.CurrentCampaign?.Id.ToString() : null,
    };
    private int _total;
    private bool _modalVisible;
    private bool _isEditing;
    private bool _saving;
    private Guid _editingId;
    private FieldFormModel _formModel = new();
    private Form<FieldFormModel>? _form;
    private List<ErpAccountDto> _centros = new();
    private bool _loadingCentros;

    // Lotes de cada campo, cargados recién al expandir la fila (null = cargando).
    private readonly Dictionary<Guid, List<LotListItemDto>?> _lotsByField = new();

    public class FieldFormModel
    {
        public string Name { get; set; } = string.Empty;
        public long? CodCentro { get; set; }
    }

    protected override void OnInitialized()
    {
        TenantState.OnChange += OnTenantChanged;
    }

    private void OnTenantChanged()
    {
        InvokeAsync(ReloadAsync);
    }

    public void Dispose()
    {
        TenantState.OnChange -= OnTenantChanged;
    }

    private Task<PagedResult<FieldListItemDto>?> LoadFields(string query, CancellationToken ct) =>
        Http.GetFromJsonAsync<PagedResult<FieldListItemDto>>($"api/fields/search?{query}", ct);

    private void OnFieldsLoaded(PagedResult<FieldListItemDto> page)
    {
        _total = page.Total;
    }

    private async Task ReloadAsync()
    {
        // Los lotes expandidos pueden haber cambiado (ej. se borró el campo).
        _lotsByField.Clear();
        if (_table != null)
            await _table.ReloadAsync();
    }

    private RenderFragment<RowData<FieldListItemDto>> FieldLots => row => @<text>
        @{
            var fieldRow = row.Data;
            var lots = EnsureLots(fieldRow.Id);
        }
        @if (lots == null)
        {
            <div style="padding: 10px 16px;"><Spin /></div>
        }
        else if (lots.Count == 0)
        {
            <div style="padding: 14px 16px; color: rgba(255,255,255,0.45); font-size: 12px; text-align: center; background: rgba(255,255,255,0.02); border-radius: 8px;">
                <Icon Type="inbox" Theme="IconThemeType.Outline" Style="font-size: 20px; margin-bottom: 4px; display: block; color: rgba(255,255,255,0.25);" />
                Este campo aún no tiene lotes asignados.
            </div>
        }
        else
        {
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                @foreach (var lot in lots)
                {
                    <div class="lot-item-row" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 260px; padding: 8px 12px; background: rgba(255,255,255,0.04); border-radius: 8px; border: 1px solid rgba(255,255,255,0.07); transition: all 0.2s;">
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <Icon Type="appstore" Theme="IconThemeType.Outline" Style="color: #3498DB; font-size: 12px;" />
                                <span style="font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.9);">@lot.Name</span>
                            </div>
                            @if (lot.CadastralArea > 0)
                            {
                                <span style="font-size: 11px; color: rgba(255,255,255,0.45); padding-left: 18px;">
                                    Superficie: <strong>@lot.CadastralArea.ToString("N1") Ha</strong>
                                </span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 6px;">
                            <span style="font-size: 10px; padding: 2px 8px; border-radius: 10px; font-weight: 600; background: @(lot.Status == "Active" ? "rgba(46, 204, 113, 0.15)" : "rgba(255,255,255,0.1)"); color: @(lot.Status == "Active" ? "#2ECC71" : "rgba(255,255,255,0.5)"); border: 1px solid @(lot.Status == "Active" ? "rgba(46, 204, 113, 0.3)" : "rgba(255,255,255,0.15)");">
                                @(lot.Status == "Active" ? "Activo" : lot.Status)
                            </span>
                            <Button Size="@ButtonSize.Small" Type="@ButtonType.Link" Title="Ver lote en el mapa" OnClick='() => Navigation.NavigateTo("/map")' Style="padding: 0 4px; height: auto;">
                                <Icon Type="compass" Theme="IconThemeType.Outline" Style="color: #3498DB; font-size: 14px;" />
                            </Button>
                        </div>
                    </div>
                }
            </div>
            @if (fieldRow.LotCount > lots.Count)
            {
                <div style="margin-top: 6px; font-size: 11px; color: rgba(255,255,255,0.45);">
                    Se muestran @lots.Count de @fieldRow.LotCount lotes. El resto está en la pantalla de Lotes.
                </div>
            }
        }
    </text>;

    /// <summary>
    /// Devuelve los lotes ya cargados del campo, o null mientras se cargan. La primera vez que se
    /// expande la fila dispara la carga (una sola página de 100: alcanza para casi todos los campos).
    /// </summary>
    private List<LotListItemDto>? EnsureLots(Guid fieldId)
    {
        if (_lotsByField.TryGetValue(fieldId, out var lots))
            return lots;

        _lotsByField[fieldId] = null;
        _ = InvokeAsync(async () =>
        {
            try
            {
                var page = await Http.GetFromJsonAsync<PagedResult<LotListItemDto>>(
                    $"api/lots/search?page=1&pageSize=100&sortBy=name&sortDir=asc&fieldId={fieldId}");
                _lotsByField[fieldId] = page?.Items ?? new();
            }
            catch (Exception ex)
            {
                // Vacío para no reintentar en cada render de la fila expandida.
                _lotsByField[fieldId] = new();
                Message.Error($"No se pudieron cargar los lotes: {ex.Message}");
            }
            StateHasChanged();
        });
        return null;
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _formModel = new FieldFormModel();
        _modalVisible = true;
        _ = LoadCentros();
    }

    private void OpenEditModal(FieldListItemDto field)
    {
        _isEditing = true;
        _editingId = field.Id;
        _formModel = new FieldFormModel { Name = field.Name, CodCentro = field.CodCentro };
        _modalVisible = true;
        _ = LoadCentros();
    }

    private void CloseModal()
    {
        _modalVisible = false;
    }

    /// <summary>
    /// Se carga recién al abrir el modal: el plan de centros del ERP no hace falta para
    /// listar campos y son varios cientos de cuentas.
    /// </summary>
    private async Task LoadCentros()
    {
        if (_centros.Count > 0 || _loadingCentros) return;

        _loadingCentros = true;
        StateHasChanged();
        try
        {
            _centros = await Http.GetFromJsonAsync<List<ErpAccountDto>>("api/pases/erp/cuentas/centro") ?? new();
        }
        catch
        {
            // Sin centros el selector queda vacío; el resto del alta sigue funcionando.
            _centros = new();
        }
        finally
        {
            _loadingCentros = false;
            StateHasChanged();
        }
    }

    private async Task SaveField()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Name))
        {
            Message.Warning("El nombre del campo es obligatorio.");
            return;
        }

        _saving = true;
        try
        {
            var dto = new FieldDto(
                _isEditing ? _editingId : Guid.Empty,
                _formModel.Name,
                DateTime.UtcNow,
                new List<LotSummaryDto>(),
                _formModel.CodCentro
            );

            HttpResponseMessage response;
            if (_isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/fields/{_editingId}",
                    dto, AppJsonSerializerContext.Default.FieldDto);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/fields",
                    dto, AppJsonSerializerContext.Default.FieldDto);
            }

            if (response.IsSuccessStatusCode)
            {
                if (!_isEditing && CampaignState.IsSelected)
                {
                    var createdField = await response.Content.ReadFromJsonAsync<FieldDto>(AppJsonSerializerContext.Default.FieldDto);
                    if (createdField != null)
                    {
                        var fieldAddResp = await Http.PostAsJsonAsync($"api/campaigns/{CampaignState.CurrentCampaign!.Id}/fields",
                            new CampaignFieldDto(CampaignState.CurrentCampaign.Id, createdField.Id, createdField.Name, 0, 0),
                            AppJsonSerializerContext.Default.CampaignFieldDto);
                        
                        if (!fieldAddResp.IsSuccessStatusCode)
                        {
                            var fieldAddErr = await fieldAddResp.Content.ReadAsStringAsync();
                            Message.Warning($"El campo se creó pero no pudo asignarse a la campaña: {fieldAddErr}");
                        }
                    }
                }

                Message.Success(_isEditing ? "Campo actualizado correctamente." : "Campo creado correctamente.");
                _modalVisible = false;
                await ReloadAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al guardar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteField(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/fields/{id}");
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Campo eliminado correctamente.");
                await ReloadAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al eliminar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
    }
}

<style>
    .lots-dropdown-trigger:hover {
        background: rgba(52, 152, 219, 0.28) !important;
        border-color: rgba(52, 152, 219, 0.6) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.25);
    }

    .lot-item-row:hover {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(52, 152, 219, 0.35) !important;
    }
</style>
