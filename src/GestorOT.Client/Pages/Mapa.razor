    private bool _isDisposed;

    protected override void OnInitialized()
    {
        CampaignState.OnChange += OnCampaignChanged;
        TenantState.OnChange += OnCampaignChanged;
    }

    private void OnCampaignChanged()
    {
        if (_isDisposed) return;
        InvokeAsync(async () => {
            if (!_isDisposed)
            {
                await ReloadMap();
                StateHasChanged();
            }
        });
    }

    private DotNetObjectReference<Mapa>? _dotNetRef;

    public void Dispose()
    {
        _isDisposed = true;
        CampaignState.OnChange -= OnCampaignChanged;
        TenantState.OnChange -= OnCampaignChanged;
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasLoaded)
        {
            _hasLoaded = true;
            await InitializeMapAsync();
            StateHasChanged();
        }
    }

    private async Task InitializeMapAsync(MapBounds? preserveBounds = null)
    {
        try
        {
            await JS.InvokeAsync<bool>("mapInterop.initMap", "map", -34.6, -58.5, 10);

            _dotNetRef?.Dispose();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("mapInterop.setDotNetRef", _dotNetRef);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

            var lotsTask = Http.GetFromJsonAsync("api/lots",
                AppJsonSerializerContext.Default.ListLotDto, cts.Token);
            // Con campaña, cada feature trae ademas el cultivo y su color. Sin campaña el
            // payload es el de siempre y el modo Cultivo no tiene nada que pintar.
            var campaignId = CampaignState.CurrentCampaign?.Id;
            var geoUrl = campaignId.HasValue && campaignId.Value != Guid.Empty
                ? $"api/lots/geojson?campaignId={campaignId.Value}"
                : "api/lots/geojson";

            var geoTask = Http.GetFromJsonAsync(geoUrl,
                AppJsonSerializerContext.Default.GeoJsonFeatureCollection, cts.Token);
            var fieldsTask = Http.GetFromJsonAsync("api/fields",
                AppJsonSerializerContext.Default.ListFieldDto, cts.Token);
            var fieldsGeoTask = Http.GetFromJsonAsync<GeoJsonFeatureCollection>(
                "api/fields/geojson", AppJsonSerializerContext.Default.GeoJsonFeatureCollection, cts.Token);

            _allLots = await lotsTask ?? new();
            _allFields = await fieldsTask ?? new();
            _orphanLots = _allLots.Where(l => l != null && string.IsNullOrEmpty(l.WktGeometry)).ToList();

            Guid? parsedLotId = null;
            if (!string.IsNullOrEmpty(lotId) && Guid.TryParse(lotId, out var parsed))
            {
                parsedLotId = parsed;
                var orphan = _orphanLots.FirstOrDefault(l => l != null && l.Id == parsed);
                if (orphan != null)
                {
                    _linkingLotId = orphan.Id;
                    _showOrphanPanel = true;
                }
            }

            var featureCollection = await geoTask;

            if (featureCollection?.Features != null)
            {
                _lotsCount = featureCollection.Features.Count;
                _totalArea = 0;
                _cropsInView.Clear();

                foreach (var feature in featureCollection.Features)
                {
                    if (feature != null && feature.Geometry?.Coordinates != null && feature.Properties != null)
                    {
                        var lotId = feature.Properties.TryGetValue("id", out var id) ? id?.ToString() ?? "" : "";
                        var lotName = feature.Properties.TryGetValue("name", out var name) ? name?.ToString() ?? "" : "";
                        var status = feature.Properties.TryGetValue("status", out var s) ? s?.ToString() ?? "Active" : "Active";
                        var fieldName = feature.Properties.TryGetValue("fieldName", out var fn) ? fn?.ToString() ?? "" : "";
                        var fieldId = feature.Properties.TryGetValue("fieldId", out var fid) ? fid?.ToString() ?? "" : "";
                        double area = 0;
                        if (feature.Properties.TryGetValue("area", out var a))
                        {
                            if (a is System.Text.Json.JsonElement je)
                                area = je.GetDouble();
                            else
                                area = Convert.ToDouble(a);
                        }

                        _totalArea += area;

                        var cropName = feature.Properties.TryGetValue("cropName", out var cn) ? cn?.ToString() ?? "" : "";
                        var cropColor = feature.Properties.TryGetValue("cropColor", out var cc) ? cc?.ToString() ?? "" : "";

                        if (!string.IsNullOrEmpty(cropName))
                        {
                            // El conteo es por cultivo presente en la vista, que es lo que la
                            // leyenda informa.
                            _cropsInView[cropName] = _cropsInView.TryGetValue(cropName, out var previo)
                                ? (previo.Color, previo.Count + 1)
                                : (cropColor, 1);
                        }
                        else if (campaignId.HasValue && campaignId.Value != Guid.Empty)
                        {
                            _cropsInView[SinCultivo] = _cropsInView.TryGetValue(SinCultivo, out var prev)
                                ? (prev.Color, prev.Count + 1)
                                : ("#7F8C8D", 1);
                        }

                        var leafletCoords = ConvertToLeafletCoords(feature.Geometry.Coordinates);
                        var coordsJson = System.Text.Json.JsonSerializer.Serialize(leafletCoords);

                        await JS.InvokeAsync<bool>("mapInterop.addLotPolygon",
                            lotId, lotName, status, area, fieldName, coordsJson, fieldId, cropName, cropColor);
                    }
                }

                if (_lotsCount > 0)
                {
                    if (preserveBounds != null)
                    {
                        // Restore viewport after save (#7)
                        await JS.InvokeVoidAsync("mapInterop.restoreBounds", preserveBounds);
                    }
                    else if (parsedLotId.HasValue)
                    {
                        var lot = _allLots.FirstOrDefault(l => l != null && l.Id == parsedLotId.Value);
                        if (lot != null)
                        {
                            _selectedLot = lot;
                            await JS.InvokeAsync<bool>("mapInterop.centerOnLot", parsedLotId.Value.ToString());
                        }
                        else
                        {
                            await JS.InvokeAsync<bool>("mapInterop.fitAllLots");
                        }
                    }
                    else
                    {
                        await JS.InvokeAsync<bool>("mapInterop.fitAllLots");
                    }
                }
            }

            if (_showFieldPolygons)
            {
                var fieldsFeatureCollection = await fieldsGeoTask;
                if (fieldsFeatureCollection?.Features != null)
                {
                    await JS.InvokeVoidAsync("mapInterop.clearFields");
                    _fieldsCount = 0;
                    _fieldsArea = 0;
                    foreach (var feature in fieldsFeatureCollection.Features)
                    {
                        if (feature != null && feature.Geometry?.Coordinates != null && feature.Properties != null)
                        {
                            var fId = feature.Properties.TryGetValue("id", out var id) ? id?.ToString() ?? "" : "";
                            var fName = feature.Properties.TryGetValue("name", out var name) ? name?.ToString() ?? "" : "";
                            int lotsCount = 0;
                            if (feature.Properties.TryGetValue("lotsCount", out var lc))
                            {
                                if (lc is System.Text.Json.JsonElement jeLc)
                                    lotsCount = jeLc.ValueKind == System.Text.Json.JsonValueKind.Number ? jeLc.GetInt32() : 0;
                                else
                                    lotsCount = Convert.ToInt32(lc);
                            }
                            double fArea = 0;
                            if (feature.Properties.TryGetValue("area", out var a))
                            {
                                if (a is System.Text.Json.JsonElement jeA)
                                    fArea = jeA.ValueKind == System.Text.Json.JsonValueKind.Number ? jeA.GetDouble() : 0;
                                else
                                    fArea = Convert.ToDouble(a);
                            }

                            _fieldsCount++;
                            _fieldsArea += fArea;

                            var leafletCoords = ConvertToLeafletCoords(feature.Geometry.Coordinates);
                            var coordsJson = System.Text.Json.JsonSerializer.Serialize(leafletCoords);

                            await JS.InvokeAsync<bool>("mapInterop.addFieldPolygon",
                                fId, fName, lotsCount, fArea, coordsJson);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadMap(MapBounds? preserveBounds = null)
    {
        if (_loading && _hasLoaded) return; // Prevent double reloads

        _loading = true;
        _hasLoaded = false;
        _selectedLot = null;
        _drawnWkt = null;
        StateHasChanged();
        
        await Task.Delay(100); // Small delay to allow DOM to stabilize
        await JS.InvokeVoidAsync("mapInterop.clearLots");
        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
        await InitializeMapAsync(preserveBounds);
        StateHasChanged();
    }

