    private async Task HandleFileImport(InputFileChangeEventArgs e)
    {
        _importLoading = true;
        _importResults.Clear();
        _importWarnings.Clear();
        _importCrs = null;
        _importGroups.Clear();
        _discardedGroups.Clear();
        _groupNameColumns.Clear();
        StateHasChanged();

        try
        {
            IReadOnlyList<IBrowserFile> files;
            try
            {
                files = e.GetMultipleFiles(maximumFileCount: 200);
            }
            catch
            {
                files = new List<IBrowserFile> { e.File };
            }

            var allResults = new List<ImportResult>();

            foreach (var file in files)
            {
                try
                {
                    if (file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ||
                        file.Name.EndsWith(".kmz", StringComparison.OrdinalIgnoreCase))
                    {
                        using var ms = new MemoryStream();
                        using (var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024))
                        {
                            await stream.CopyToAsync(ms);
                        }
                        ms.Position = 0;

                        using var archive = new ZipArchive(ms, ZipArchiveMode.Read, leaveOpen: true);
                        bool hasShapefiles = archive.Entries.Any(entry => entry.Name.EndsWith(".shp", StringComparison.OrdinalIgnoreCase));

                        if (hasShapefiles)
                        {
                            ms.Position = 0;
                            await ImportShapefileStreamAsync(file.Name, ms, allResults);
                        }
                        else
                        {
                            var geoEntries = archive.Entries
                                .Where(entry => !entry.FullName.StartsWith("__MACOSX", StringComparison.OrdinalIgnoreCase) &&
                                                !string.IsNullOrEmpty(entry.Name) &&
                                                (entry.Name.EndsWith(".geojson", StringComparison.OrdinalIgnoreCase) ||
                                                 entry.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase) ||
                                                 entry.Name.EndsWith(".kml", StringComparison.OrdinalIgnoreCase)))
                                .ToList();

                            if (geoEntries.Count == 0)
                            {
                                _importWarnings.Add($"El archivo '{file.Name}' no contiene archivos .shp, .geojson ni .kml válidos.");
                                continue;
                            }

                            // Si es un zip con geojson, intentamos la importación directa por UUID (Gestor-OT GIS)
                            var hasGeoJson = geoEntries.Any(e => e.Name.EndsWith(".geojson", StringComparison.OrdinalIgnoreCase) || e.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase));
                            if (hasGeoJson && file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                            {
                                try
                                {
                                    ms.Position = 0;
                                    using var previewContent = new MultipartFormDataContent();
                                    var streamCopy = new MemoryStream(ms.ToArray());
                                    var fileContent = new StreamContent(streamCopy);
                                    fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
                                    previewContent.Add(fileContent, "file", file.Name);

                                    var previewResp = await Http.PostAsync("api/lots/import/geojson-zip/preview", previewContent);
                                    if (previewResp.IsSuccessStatusCode)
                                    {
                                        var previewData = await previewResp.Content.ReadFromJsonAsync<GeoJsonZipPreviewResultDto>(
                                            AppJsonSerializerContext.Default.GeoJsonZipPreviewResultDto);

                                        if (previewData != null && previewData.MatchedCount > 0)
                                        {
                                            _geoJsonZipPreview = previewData;
                                            _selectedGeoJsonZipLotIds = new HashSet<Guid>(
                                                previewData.Items.Where(i => i.LotFound && i.LotId.HasValue).Select(i => i.LotId!.Value));
                                            _showGeoJsonZipModal = true;
                                            _showImportModal = false;
                                            _importLoading = false;
                                            StateHasChanged();
                                            return;
                                        }
                                    }
                                }
                                catch (Exception)
                                {
                                    // Continuar con el parser legado si falla el preview
                                }
                            }

                            foreach (var entry in geoEntries)
                            {
                                try
                                {
                                    using var entryStream = entry.Open();
                                    using var reader = new StreamReader(entryStream);
                                    var content = await reader.ReadToEndAsync();
                                    var entryDefaultName = Path.GetFileNameWithoutExtension(entry.Name);

                                    string resultsJson;
                                    if (entry.Name.EndsWith(".kml", StringComparison.OrdinalIgnoreCase))
                                    {
                                        resultsJson = await JS.InvokeAsync<string>("mapInterop.parseKmlFile", content, entryDefaultName);
                                    }
                                    else
                                    {
                                        resultsJson = await JS.InvokeAsync<string>("mapInterop.parseGeoJsonFile", content, entryDefaultName);
                                    }

                                    var parsed = System.Text.Json.JsonSerializer.Deserialize<List<ImportResult>>(resultsJson,
                                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                                    if (parsed != null && parsed.Count > 0)
                                    {
                                        foreach (var r in parsed)
                                        {
                                            r.SourceShapefile = $"{file.Name} / {entry.Name}";
                                            allResults.Add(r);
                                        }
                                    }
                                    else
                                    {
                                        _importWarnings.Add($"No se encontraron geometrías válidas en '{entry.Name}' ({file.Name}).");
                                    }
                                }
                                catch (Exception ex)
                                {
                                    _importWarnings.Add($"Error al leer '{entry.Name}' en '{file.Name}': {ex.Message}");
                                }
                            }
                        }
                    }
                    else
                    {
                        using var stream = file.OpenReadStream(maxAllowedSize: 64 * 1024 * 1024);
                        using var reader = new StreamReader(stream);
                        var content = await reader.ReadToEndAsync();
                        var fileDefaultName = Path.GetFileNameWithoutExtension(file.Name);

                        string resultsJson;
                        if (file.Name.EndsWith(".kml", StringComparison.OrdinalIgnoreCase))
                        {
                            resultsJson = await JS.InvokeAsync<string>("mapInterop.parseKmlFile", content, fileDefaultName);
                        }
                        else
                        {
                            resultsJson = await JS.InvokeAsync<string>("mapInterop.parseGeoJsonFile", content, fileDefaultName);
                        }

                        var parsed = System.Text.Json.JsonSerializer.Deserialize<List<ImportResult>>(resultsJson,
                            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                        if (parsed != null && parsed.Count > 0)
                        {
                            foreach (var r in parsed)
                            {
                                r.SourceShapefile = file.Name;
                                allResults.Add(r);
                            }
                        }
                        else
                        {
                            _importWarnings.Add($"No se encontraron geometrías en '{file.Name}'.");
                        }
                    }
                }
                catch (Exception ex)
                {
                    _importWarnings.Add($"Error al procesar '{file.Name}': {ex.Message}");
                }
            }

            _importResults = allResults;

            await JS.InvokeVoidAsync("mapInterop.clearDrawn");
            if (_importResults.Count > 0)
            {
                foreach (var feature in _importResults)
                {
                    await JS.InvokeAsync<bool>("mapInterop.addImportedPolygon", feature.Wkt, feature.Name);
                }
                await JS.InvokeAsync<bool>("mapInterop.fitImportedBounds");
                Message.Success($"{_importResults.Count} polígono(s) importado(s).");
            }
            else
            {
                Message.Warning("No se encontraron polígonos válidos en los archivos seleccionados.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al importar: {ex.Message}");
        }
        finally
        {
            _importLoading = false;
            StateHasChanged();
        }
    }

    private List<string> _importWarnings = new();
    private string? _importCrs;
    private List<ShapefileGroupDto> _importGroups = new();
    private HashSet<string> _discardedGroups = new();

    /// <summary>
    /// Columna de nombre elegida por shapefile (clave = <see cref="ShapefileGroupDto.Name"/>).
    /// Arranca precargada con la deteccion automatica del backend (<see cref="ShapefileGroupDto.NameColumn"/>,
    /// que puede ser null); null en este diccionario significa "Sin columna de nombre" -> autonumerar.
    /// </summary>
    private Dictionary<string, string?> _groupNameColumns = new();

    private bool _showGeoJsonZipModal = false;
    private bool _geoJsonZipApplying = false;
    private GeoJsonZipPreviewResultDto? _geoJsonZipPreview;
    private HashSet<Guid> _selectedGeoJsonZipLotIds = new();
    private string _geoJsonZipSearch = "";

    private void ToggleAllGeoJsonZipItems(bool selectAll)
    {
        if (_geoJsonZipPreview == null) return;
        if (selectAll)
        {
            _selectedGeoJsonZipLotIds = new HashSet<Guid>(
                _geoJsonZipPreview.Items.Where(i => i.LotFound && i.LotId.HasValue).Select(i => i.LotId!.Value));
        }
        else
        {
            _selectedGeoJsonZipLotIds.Clear();
        }
    }

    private void ToggleGeoJsonZipItem(Guid lotId, bool selected)
    {
        if (selected) _selectedGeoJsonZipLotIds.Add(lotId);
        else _selectedGeoJsonZipLotIds.Remove(lotId);
    }

    private async Task ApplyGeoJsonZipAsync()
    {
        if (_geoJsonZipPreview == null || _selectedGeoJsonZipLotIds.Count == 0) return;

        _geoJsonZipApplying = true;
        try
        {
            var campaignId = CampaignState.CurrentCampaign?.Id;
            var itemsToApply = _geoJsonZipPreview.Items
                .Where(i => i.LotFound && i.LotId.HasValue && _selectedGeoJsonZipLotIds.Contains(i.LotId.Value))
                .Select(i => new GeoJsonZipApplyItemDto(i.LotId!.Value, i.Wkt, i.GisAreaHa))
                .ToList();

            var request = new GeoJsonZipApplyRequestDto(itemsToApply, campaignId);
            var response = await Http.PostAsJsonAsync("api/lots/import/geojson-zip/apply",
                request, AppJsonSerializerContext.Default.GeoJsonZipApplyRequestDto);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GeoJsonZipApplyResultDto>(
                    AppJsonSerializerContext.Default.GeoJsonZipApplyResultDto);

                if (result != null && result.Success)
                {
                    Message.Success($"Se vincularon {result.LinkedCount} geometrías exitosamente.");
                    _showGeoJsonZipModal = false;
                    _geoJsonZipPreview = null;
                    await ReloadMap();
                }
                else
                {
                    Message.Error(result?.Error ?? "Error al vincular geometrías.");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al aplicar geometrías: {error}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _geoJsonZipApplying = false;
        }
    }

    /// <summary>Polígonos de los grupos que el usuario no descartó.</summary>
    private IEnumerable<ImportResult> VisibleImportResults =>
        _importResults.Where(r => r.SourceShapefile is null || !_discardedGroups.Contains(r.SourceShapefile));

    private async Task ToggleGroup(string groupName)
    {
        if (!_discardedGroups.Remove(groupName))
        {
            _discardedGroups.Add(groupName);
        }

        // El mapa tiene que reflejar el descarte: si no, se siguen viendo polígonos que ya no
        // se van a importar.
        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
        foreach (var f in VisibleImportResults)
        {
            await JS.InvokeAsync<bool>("mapInterop.addImportedPolygon", f.Wkt, f.Name);
        }
        await JS.InvokeAsync<bool>("mapInterop.fitImportedBounds");
    }

    private async Task ImportShapefileStreamAsync(string fileName, Stream stream, List<ImportResult> targetList)
    {
        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(stream);
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/zip");
        content.Add(fileContent, "file", fileName);

        var response = await Http.PostAsync("api/lots/import/shapefile", content);

        if (!response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();
            _importWarnings.Add($"Error en shapefile '{fileName}': {(string.IsNullOrWhiteSpace(detail) ? "No se pudo leer el shapefile." : detail)}");
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<ShapefileImportResultDto>(AppJsonSerializerContext.Default.ShapefileImportResultDto);
        if (result == null)
        {
            _importWarnings.Add($"No se pudo leer la respuesta del servidor para '{fileName}'.");
            return;
        }

        if (_importCrs == null)
        {
            _importCrs = result.SourceCrs;
        }
        else if (result.SourceCrs != null && !_importCrs.Contains(result.SourceCrs))
        {
            _importCrs += $", {result.SourceCrs}";
        }

        if (result.Warnings != null)
        {
            _importWarnings.AddRange(result.Warnings);
        }

        if (result.Groups != null)
        {
            _importGroups.AddRange(result.Groups);
            foreach (var grupo in result.Groups)
            {
                _groupNameColumns[grupo.Name] = grupo.NameColumn;
            }
        }

        if (result.Features.Count == 0)
        {
            _importWarnings.Add($"No se encontraron polígonos en el shapefile '{fileName}'.");
            return;
        }

        var features = result.Features
            .Select(f => new ImportResult { Wkt = f.Wkt, Name = f.Name, SourceShapefile = f.SourceShapefile ?? fileName, Attributes = f.Attributes, AreaHa = f.AreaHa })
            .ToList();

        if (result.Groups != null)
        {
            foreach (var grupo in result.Groups)
            {
                var featuresDelGrupo = features.Where(r => r.SourceShapefile == grupo.Name).ToList();
                for (int i = 0; i < featuresDelGrupo.Count; i++)
                {
                    featuresDelGrupo[i].Name = ComputeFeatureName(grupo.Name, grupo.NameColumn, featuresDelGrupo[i].Attributes, i + 1);
                }
            }
        }

        targetList.AddRange(features);
    }

    /// <summary>
    /// Recalcula, en el cliente y sin llamadas al backend, los nombres de las features de un
    /// grupo cuando el usuario cambia la columna de nombre elegida para ese shapefile (OT-50).
    /// </summary>
    private async Task OnNameColumnChanged(string groupName, string? column)
    {
        _groupNameColumns[groupName] = column;
        ApplyGroupNames(groupName, column);

        // El mapa tiene que reflejar los nombres nuevos, igual que al descartar un grupo.
        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
        foreach (var f in VisibleImportResults)
        {
            await JS.InvokeAsync<bool>("mapInterop.addImportedPolygon", f.Wkt, f.Name);
        }
        await JS.InvokeAsync<bool>("mapInterop.fitImportedBounds");
    }

    /// <summary>Aplica la columna elegida a las features de un grupo, sin tocar el mapa.</summary>
    private void ApplyGroupNames(string groupName, string? column)
    {
        var featuresDelGrupo = _importResults.Where(r => r.SourceShapefile == groupName).ToList();
        for (int i = 0; i < featuresDelGrupo.Count; i++)
        {
            featuresDelGrupo[i].Name = ComputeFeatureName(groupName, column, featuresDelGrupo[i].Attributes, i + 1);
        }
    }

    /// <summary>
    /// Si se eligio una columna, el nombre sale de ahi tal cual: es el mismo criterio que usa el
    /// backend para la deteccion automatica (<c>ShapefileImportService.ReadFeatures</c>), asi que
    /// dejar seleccionada la columna detectada no cambia nada. Sin columna ("Sin columna de
    /// nombre"), se autonumera con el nombre del shapefile: es el caso de shapefiles como
    /// "Poligonos_Agricolas" que no traen ninguna columna de nombre y hoy quedaban todos anonimos.
    /// </summary>
    private static string ComputeFeatureName(string groupName, string? column, Dictionary<string, string>? attributes, int indexInGroup)
    {
        if (column is null)
        {
            return $"{groupName}_{indexInGroup}";
        }

        return attributes != null && attributes.TryGetValue(column, out var value) ? value : string.Empty;
    }

    // ---- Conciliación masiva (OT-48) ----------------------------------------------------
    // Complementa al "Vincular" polígono por polígono de arriba (que sigue existiendo para
    // correcciones puntuales): cruza TODAS las features visibles del import contra los lotes
    // del campo elegido y aplica todo en una sola confirmación ("todo o nada" en el backend).

    /// <summary>
    /// Fila del asistente de vinculación: la propuesta del backend + lo que decidió el operador.
    /// <see cref="Id"/> existe para poder marcar la fila activa al emparejar con el panel derecho
    /// (el nombre de la feature puede repetirse y no sirve como identificador).
    /// </summary>
    public class ReconcileRow
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public LotMatchProposalDto Proposal { get; set; } = new();
        public LotLinkAction Action { get; set; }
        public Guid SelectedLotId { get; set; }
        public string NewLotName { get; set; } = "";
    }

    private bool _showReconcileModal;
    private Guid _reconcileFieldId;
    private bool _reconcileLoading;
    private bool _reconcileApplying;
    private List<ReconcileRow> _reconcileRows = new();
    private List<string> _reconcileOverlapWarnings = new();

    private string _reconcileFeatureSearch = "";
    private string _reconcileLotSearch = "";
    private Guid _reconcileActiveRowId = Guid.Empty;
    private bool _reconcileShowLotsWithGeometry;

    /// <summary>
    /// OT-49: labores que quedaron por encima de la superficie real tras guardar la geometría
    /// del año. Van aparte de los solapamientos porque significan lo contrario: acá sí se
    /// aplicó todo, y lo que hay que hacer es revisar, no reintentar.
    /// </summary>
    private List<string> _reconcileSurfaceWarnings = new();
    private bool _reconcileCombineGeometry;

    private IEnumerable<ReconcileRow> ReconcileVisibleRows =>
        string.IsNullOrWhiteSpace(_reconcileFeatureSearch)
            ? _reconcileRows
            : _reconcileRows.Where(r =>
                (r.Proposal.FeatureName ?? "").Contains(_reconcileFeatureSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<LotDto> ReconcileAvailableLots =>
        _allLots
            .Where(l => l.FieldId == _reconcileFieldId)
            .Where(l => _reconcileShowLotsWithGeometry || string.IsNullOrEmpty(l.WktGeometry))
            .Where(l => string.IsNullOrWhiteSpace(_reconcileLotSearch)
                        || l.Name.Contains(_reconcileLotSearch, StringComparison.OrdinalIgnoreCase))
            .OrderBy(l => l.Name);

    private int ReconcilePairedCount =>
        _reconcileRows.Count(r => r.Action == LotLinkAction.Link && r.SelectedLotId != Guid.Empty);

    private ReconcileRow? ReconcileRowPairedTo(Guid lotId) =>
        _reconcileRows.FirstOrDefault(r => r.Action == LotLinkAction.Link && r.SelectedLotId == lotId);

    private string ReconcileLotName(Guid lotId) =>
        _allLots.FirstOrDefault(l => l.Id == lotId)?.Name ?? "lote";

    /// <summary>
    /// Ambiguo sin resolver: el operador dejó la acción en "Vincular" (la propuesta ambigua
    /// arranca en "Omitir", así que llegar acá significa que la cambió) pero todavía no eligió
    /// cuál de los candidatos. Mientras haya una sola fila así, no se puede confirmar.
    /// </summary>
    private bool ReconcileHasUnresolvedAmbiguous =>
        _reconcileRows.Any(r => r.Action == LotLinkAction.Link && r.Proposal.Candidates.Count > 1 && r.SelectedLotId == Guid.Empty);

    private static string ReconcileStatusLabel(LotMatchStatus status) => status switch
    {
        LotMatchStatus.ExactMatch => "Exacta",
        LotMatchStatus.FuzzyMatch => "Sugerida",
        LotMatchStatus.Ambiguous => "Ambiguo",
        _ => "Sin coincidencia"
    };

    private static string ReconcileStatusColor(LotMatchStatus status) => status switch
    {
        LotMatchStatus.ExactMatch => "#2ECC71",
        LotMatchStatus.FuzzyMatch => "#3498DB",
        LotMatchStatus.Ambiguous => "#F39C12",
        _ => "rgba(255,255,255,0.5)"
    };

    private void SelectReconcileRow(ReconcileRow row)
    {
        // Volver a clickear la misma fila la deselecciona.
        _reconcileActiveRowId = _reconcileActiveRowId == row.Id ? Guid.Empty : row.Id;
    }

    /// <summary>
    /// Empareja un lote del panel derecho con la fila activa (o con la primera sin asignar, que
    /// es el caso más común cuando se recorre el listado de polígonos en orden).
    /// </summary>
    private void AssignLotToActive(LotDto lot)
    {
        if (lot is null || lot.Id == Guid.Empty) return;

        var row = _reconcileRows.FirstOrDefault(r => r.Id == _reconcileActiveRowId)
            ?? _reconcileRows.FirstOrDefault(r => r.Action != LotLinkAction.Link || r.SelectedLotId == Guid.Empty);

        if (row == null)
        {
            Message.Warning("Elegí primero un polígono de la izquierda.");
            return;
        }

        // Un lote no puede quedar emparejado a dos features: se libera la asignación anterior.
        foreach (var otra in _reconcileRows.Where(r => r.Id != row.Id && r.Action == LotLinkAction.Link && r.SelectedLotId == lot.Id))
        {
            otra.SelectedLotId = Guid.Empty;
            otra.Action = LotLinkAction.Skip;
        }

        row.Action = LotLinkAction.Link;
        row.SelectedLotId = lot.Id;
        _reconcileActiveRowId = Guid.Empty;
    }

    private void UnassignReconcileRow(ReconcileRow row)
    {
        row.SelectedLotId = Guid.Empty;
        // Si el backend proponía crear, se vuelve a esa propuesta; si no, queda omitida.
        row.Action = row.Proposal.SuggestedAction == LotLinkAction.Create
            ? LotLinkAction.Create
            : LotLinkAction.Skip;
    }

    private void SetReconcileAction(ReconcileRow row, LotLinkAction action)
    {
        row.Action = action;
        if (action != LotLinkAction.Link) row.SelectedLotId = Guid.Empty;
    }

    private void AutoAssignReconcile()
    {
        var aplicadas = 0;
        foreach (var row in _reconcileRows)
        {
            if (row.Proposal.SuggestedAction == LotLinkAction.Link
                && row.Proposal.MatchedLotId is Guid id && id != Guid.Empty)
            {
                row.Action = LotLinkAction.Link;
                row.SelectedLotId = id;
                aplicadas++;
            }
        }

        Message.Info($"{aplicadas} sugerencia(s) aplicadas.");
    }

    private void ClearReconcileAssignments()
    {
        foreach (var row in _reconcileRows)
        {
            row.Action = LotLinkAction.Skip;
            row.SelectedLotId = Guid.Empty;
        }
        _reconcileActiveRowId = Guid.Empty;
    }

    /// <summary>
    /// Pide la propuesta de conciliación (POST api/lots/match) para todas las features visibles
    /// (respeta los shapefiles descartados) y abre la tabla. No persiste nada todavía.
    /// </summary>
    private async Task OpenReconcileAsync()
    {
        if (_reconcileFieldId == Guid.Empty)
        {
            Message.Warning("Elija primero el campo destino.");
            return;
        }

        var visibles = VisibleImportResults.ToList();
        if (visibles.Count == 0)
        {
            Message.Warning("No hay polígonos para conciliar.");
            return;
        }

        _reconcileLoading = true;
        _reconcileOverlapWarnings.Clear();
        _reconcileSurfaceWarnings.Clear();
        _reconcileRows.Clear();
        _reconcileFeatureSearch = "";
        _reconcileLotSearch = "";
        _reconcileActiveRowId = Guid.Empty;
        _reconcileShowLotsWithGeometry = false;
        _showReconcileModal = true;
        _showImportModal = false;
        StateHasChanged();

        try
        {
            var features = visibles
                .Select(r => new ShapefileFeatureDto(r.Name, r.Wkt, r.AreaHa, r.Attributes ?? new(), r.SourceShapefile))
                .ToList();

            var request = new LotMatchRequestDto(_reconcileFieldId, features);
            var response = await Http.PostAsJsonAsync("api/lots/match", request, AppJsonSerializerContext.Default.LotMatchRequestDto);

            if (!response.IsSuccessStatusCode)
            {
                var detail = await response.Content.ReadAsStringAsync();
                Message.Error(string.IsNullOrWhiteSpace(detail) ? "No se pudo conciliar contra los lotes." : detail);
                _showReconcileModal = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LotMatchResultDto>(AppJsonSerializerContext.Default.LotMatchResultDto);
            if (result == null)
            {
                Message.Error("No se pudo leer la respuesta del servidor.");
                _showReconcileModal = false;
                return;
            }

            _reconcileRows = result.Proposals.Select(p => new ReconcileRow
            {
                Proposal = p,
                Action = p.SuggestedAction,
                // La sugerencia —exacta o difusa— llega con el lote ya elegido. En Ambiguous
                // queda en blanco a propósito, para forzar a elegir.
                SelectedLotId = p.SuggestedAction == LotLinkAction.Link ? (p.MatchedLotId ?? Guid.Empty) : Guid.Empty,
                NewLotName = p.FeatureName
            }).ToList();
        }
        catch (Exception ex)
        {
            Message.Error($"Error al conciliar: {ex.Message}");
            _showReconcileModal = false;
        }
        finally
        {
            _reconcileLoading = false;
            StateHasChanged();
        }
    }

    private void CloseReconcileModal()
    {
        _showReconcileModal = false;
        _reconcileRows.Clear();
        _reconcileOverlapWarnings.Clear();
        _reconcileSurfaceWarnings.Clear();
        _reconcileApplying = false;

        // Cancelar la conciliación no descarta el import: el operador puede querer ajustar la
        // columna de nombre (OT-50), descartar un grupo, o vincular algo suelto a mano antes de
        // reintentar la conciliación masiva.
        if (_importResults.Count > 0)
        {
            _showImportModal = true;
        }
    }

    /// <summary>
    /// Aplica todo en un solo POST a api/lots/bulk-link. Un 409 no es un error de red: es "hay
    /// solapamientos, decidí" (paso 6 del plan), y se muestra agrupado en la misma tabla en vez
    /// de un modal por lote.
    /// </summary>
    private async Task ConfirmReconcileAsync(bool overrideOverlap)
    {
        if (ReconcileHasUnresolvedAmbiguous)
        {
            Message.Warning("Hay filas ambiguas sin resolver: elija a qué lote vincular cada una.");
            return;
        }

        _reconcileApplying = true;
        _reconcileOverlapWarnings.Clear();
        _reconcileSurfaceWarnings.Clear();
        StateHasChanged();

        try
        {
            var items = _reconcileRows.Select(r => new LotBulkLinkItemDto(
                r.Proposal.FeatureName,
                r.Proposal.Wkt,
                r.Action,
                r.Action == LotLinkAction.Link ? r.SelectedLotId : null,
                r.Action == LotLinkAction.Create ? (string.IsNullOrWhiteSpace(r.NewLotName) ? null : r.NewLotName) : null
            )).ToList();

            Guid? campaignId = CampaignState.CurrentCampaign != null && CampaignState.CurrentCampaign.Id != Guid.Empty
                ? CampaignState.CurrentCampaign.Id
                : null;

            var request = new LotBulkLinkRequestDto(_reconcileFieldId, items, campaignId, _reconcileCombineGeometry, overrideOverlap);

            var response = await Http.PostAsJsonAsync("api/lots/bulk-link", request, AppJsonSerializerContext.Default.LotBulkLinkRequestDto);

            if (response.IsSuccessStatusCode)
            {
                LotBulkLinkResultDto? result = null;
                try
                {
                    result = await response.Content.ReadFromJsonAsync<LotBulkLinkResultDto>(AppJsonSerializerContext.Default.LotBulkLinkResultDto);
                }
                catch { }

                if (result is { Success: true })
                {
                    Message.Success($"Vinculación aplicada: {result.Created} creado(s), {result.Updated} actualizado(s), {result.Skipped} omitido(s).");

                    MapBounds? savedBounds = null;
                    try { savedBounds = await JS.InvokeAsync<MapBounds?>("mapInterop.getCurrentBounds"); } catch { }

                    _reconcileSurfaceWarnings = result.SurfaceWarnings ?? new List<string>();

                    // Con avisos de superficie el modal queda abierto: si se cerrara solo, la
                    // inconsistencia pasaria desapercibida justo cuando hay que actuar sobre ella.
                    // Las filas ya no hacen falta, lo unico que queda en pantalla es el aviso.
                    if (_reconcileSurfaceWarnings.Count > 0)
                    {
                        _reconcileRows.Clear();
                    }
                    else
                    {
                        CloseReconcileModal();
                    }

                    _showImportModal = false;
                    _importResults.Clear();
                    _importGroups.Clear();
                    _discardedGroups.Clear();
                    _groupNameColumns.Clear();
                    await ReloadMap(savedBounds);
                }
                else
                {
                    var msg = result?.OverlapWarnings != null && result.OverlapWarnings.Count > 0
                        ? string.Join("; ", result.OverlapWarnings)
                        : "No se pudo completar la vinculación.";
                    Message.Error($"Error al aplicar la vinculación: {msg}");
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                LotBulkLinkResultDto? result = null;
                try
                {
                    result = await response.Content.ReadFromJsonAsync<LotBulkLinkResultDto>(AppJsonSerializerContext.Default.LotBulkLinkResultDto);
                }
                catch { }

                // El 409 no es un error de red: es "hay conflictos, decidí" (todo o nada, no quedó nada
                // aplicado). Se agrupan en un solo aviso arriba de la tabla, no un modal por lote.
                _reconcileOverlapWarnings = result?.OverlapWarnings != null && result.OverlapWarnings.Count > 0
                    ? result.OverlapWarnings
                    : new List<string> { "Se detectaron conflictos al aplicar la vinculación." };
            }
            else
            {
                var errorDetail = await ExtractHttpErrorMessageAsync(response);
                Message.Error($"Error al aplicar la vinculación: {errorDetail}");
            }
        }
        catch (Exception ex)
        {
            var msg = ex is System.Text.Json.JsonException
                ? "La respuesta del servidor no tiene un formato válido."
                : ex.Message;
            Message.Error($"Error al aplicar la vinculación: {msg}");
        }
        finally
        {
            _reconcileApplying = false;
            StateHasChanged();
        }
    }

    private static async Task<string> ExtractHttpErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var content = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(content))
            {
                content = content.Trim();
                if (!content.StartsWith("<", StringComparison.Ordinal))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(content);
                        if (doc.RootElement.TryGetProperty("detail", out var detail) && !string.IsNullOrWhiteSpace(detail.GetString()))
                            return detail.GetString()!;
                        if (doc.RootElement.TryGetProperty("message", out var msg) && !string.IsNullOrWhiteSpace(msg.GetString()))
                            return msg.GetString()!;
                        if (doc.RootElement.TryGetProperty("error", out var err) && !string.IsNullOrWhiteSpace(err.GetString()))
                            return err.GetString()!;
                        if (doc.RootElement.TryGetProperty("title", out var title) && !string.IsNullOrWhiteSpace(title.GetString()))
                            return title.GetString()!;
                    }
                    catch
                    {
                        return content;
                    }
                }
            }
        }
        catch { }

        return response.StatusCode switch
        {
            System.Net.HttpStatusCode.BadRequest => "La solicitud contiene datos inválidos.",
            System.Net.HttpStatusCode.NotFound => "El recurso solicitado no fue encontrado.",
            System.Net.HttpStatusCode.Forbidden => "No tiene permisos para realizar esta operación.",
            System.Net.HttpStatusCode.Unauthorized => "Sesión expirada o no autorizada.",
            System.Net.HttpStatusCode.InternalServerError => "Error interno en el servidor. Intente nuevamente más tarde.",
            _ => $"Error del servidor ({(int)response.StatusCode} {response.ReasonPhrase})."
        };
    }

    private bool _importCreateNewLot = true;

    private ImportResult? _linkingResult;

    private void LinkImportedToLot(ImportResult result)
    {
        _linkingResult = result;
        _importLinkWkt = result.Wkt;
        _newLotName = result.Name ?? "";

        // Auto-detect target field if not selected:
        Guid targetFieldId = _reconcileFieldId;
        if (targetFieldId == Guid.Empty && result.Attributes != null)
        {
            var fieldAttr = result.Attributes.FirstOrDefault(a =>
                a.Key.Equals("campo", StringComparison.OrdinalIgnoreCase) ||
                a.Key.Equals("field", StringComparison.OrdinalIgnoreCase) ||
                a.Key.Equals("establecimiento", StringComparison.OrdinalIgnoreCase)).Value;
            if (!string.IsNullOrWhiteSpace(fieldAttr))
            {
                var matchField = _allFields.FirstOrDefault(f => string.Equals(f.Name?.Trim(), fieldAttr.Trim(), StringComparison.OrdinalIgnoreCase));
                if (matchField != null) targetFieldId = matchField.Id;
            }
        }

        _newLotFieldId = targetFieldId != Guid.Empty ? targetFieldId : Guid.Empty;

        // Auto-detect existing lot with matching name:
        var matchingLot = _allLots.FirstOrDefault(l =>
            (_newLotFieldId == Guid.Empty || l.FieldId == _newLotFieldId) &&
            !string.IsNullOrWhiteSpace(l.Name) &&
            string.Equals(l.Name.Trim(), result.Name?.Trim(), StringComparison.OrdinalIgnoreCase));

        if (matchingLot != null)
        {
            _linkingLotId = matchingLot.Id;
            if (_newLotFieldId == Guid.Empty) _newLotFieldId = matchingLot.FieldId;
            _importCreateNewLot = false;
        }
        else
        {
            _linkingLotId = Guid.Empty;
            _importCreateNewLot = true;
        }

        _showLinkModal = true;
        _showImportModal = false;
    }

    private void CloseLinkModal()
    {
        _showLinkModal = false;
        _linkingResult = null;
        _importLinkWkt = null;
        if (_importResults.Count > 0)
        {
            _showImportModal = true;
        }
    }

    private bool _linkModeCombine = true;

    private void CancelOverlap()
    {
        _showOverlapModal = false;
        _pendingOverrideOverlap = false;
        _overlapSource = null;
    }

    private async Task ForceCreateWithOverlap()
    {
        _showOverlapModal = false;
        _pendingOverrideOverlap = true;
        try
        {
            if (_overlapSource == "draw")
                await SaveDrawnGeometry();
            else if (_overlapSource == "create")
                await CreateAndLinkLot();
            else
                await SaveImportedGeometry();
        }
        finally
        {
            _pendingOverrideOverlap = false;
            _overlapSource = null;
        }
    }

    private async Task SaveImportedGeometry()
    {
        if (string.IsNullOrEmpty(_importLinkWkt)) return;

        _savingGeometry = true;
        try
        {
            // Capture current viewport before reload (#7)
            MapBounds? savedBounds = null;
            try { savedBounds = await JS.InvokeAsync<MapBounds?>("mapInterop.getCurrentBounds"); } catch { }

            if (_importCreateNewLot)
            {
                if (string.IsNullOrWhiteSpace(_newLotName))
                {
                    Message.Warning("Ingrese el nombre para el nuevo lote.");
                    return;
                }
                if (_newLotFieldId == Guid.Empty)
                {
                    Message.Warning("Seleccione un campo para el nuevo lote.");
                    return;
                }

                if (!_pendingOverrideOverlap)
                {
                    var overlapCheck = await CheckOverlapAsync(_importLinkWkt, _newLotFieldId, null);
                    if (overlapCheck is { HasOverlap: true })
                    {
                        _overlapWarningResult = overlapCheck;
                        _overlapSource = "import";
                        _showOverlapModal = true;
                        return;
                    }
                }

                var createDto = new LotDto(
                    Guid.Empty,
                    _newLotFieldId,
                    _newLotName,
                    "Active",
                    _importLinkWkt,
                    null,
                    0,
                    0
                );

                var queryParams = _pendingOverrideOverlap ? "overrideOverlap=true" : "";
                if (CampaignState.CurrentCampaign != null && CampaignState.CurrentCampaign.Id != Guid.Empty)
                {
                    queryParams = string.IsNullOrEmpty(queryParams) 
                        ? $"campaignId={CampaignState.CurrentCampaign.Id}" 
                        : $"{queryParams}&campaignId={CampaignState.CurrentCampaign.Id}";
                }

                var postUrl = string.IsNullOrEmpty(queryParams) ? "api/lots" : $"api/lots?{queryParams}";

                var response = await Http.PostAsJsonAsync(postUrl, createDto, AppJsonSerializerContext.Default.LotDto);
                if (response.IsSuccessStatusCode)
                {
                    Message.Success($"Lote '{_newLotName}' creado y vinculado exitosamente.");
                    _showLinkModal = false;
                    _importLinkWkt = null;
                    _newLotName = "";
                    _newLotFieldId = Guid.Empty;
                    _pendingOverrideOverlap = false;

                    if (_linkingResult != null)
                    {
                        _importResults.Remove(_linkingResult);
                        _linkingResult = null;
                    }
                    else if (!string.IsNullOrEmpty(_importLinkWkt))
                    {
                        var idx = _importResults.FindIndex(r => r.Wkt == _importLinkWkt);
                        if (idx >= 0) _importResults.RemoveAt(idx);
                    }

                    await ReloadMap(savedBounds);

                    if (_importResults.Count > 0)
                    {
                        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
                        foreach (var r in VisibleImportResults)
                        {
                            await JS.InvokeAsync<bool>("mapInterop.addImportedPolygon", r.Wkt, r.Name);
                        }
                        _showImportModal = true;
                    }
                    else
                    {
                        _showImportModal = false;
                        Message.Success("Se han vinculado todos los polígonos.");
                    }
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var overlapResult = await response.Content.ReadFromJsonAsync<LotOverlapCheckResultDto>(AppJsonSerializerContext.Default.LotOverlapCheckResultDto);
                    if (overlapResult != null)
                    {
                        _overlapWarningResult = overlapResult;
                        _overlapSource = "import";
                        _showOverlapModal = true;
                    }
                    else
                    {
                        Message.Error("El lote ingresado se superpone con otro lote existente.");
                    }
                }
                else
                {
                    Message.Error($"Error al crear lote: {response.StatusCode}");
                }
            }
            else
            {
                if (_linkingLotId == Guid.Empty)
                {
                    Message.Warning("Seleccione un lote existente.");
                    return;
                }

                var lot = _allLots.FirstOrDefault(l => l.Id == _linkingLotId);
                if (lot == null) return;

                var finalWkt = (_linkModeCombine && !string.IsNullOrEmpty(lot.WktGeometry))
                    ? CombineWktGeometries(lot.WktGeometry, _importLinkWkt)
                    : _importLinkWkt;

                if (!_pendingOverrideOverlap && lot.FieldId != Guid.Empty)
                {
                    var overlapCheck = await CheckOverlapAsync(finalWkt, lot.FieldId, lot.Id);
                    if (overlapCheck is { HasOverlap: true })
                    {
                        _overlapWarningResult = overlapCheck;
                        _overlapSource = "import";
                        _showOverlapModal = true;
                        return;
                    }
                }

                var dto = new LotDto(
                    lot.Id,
                    lot.FieldId,
                    lot.Name,
                    lot.Status,
                    finalWkt,
                    lot.FieldName,
                    lot.Area,
                    0
                );

                var putUrl = _pendingOverrideOverlap
                    ? $"api/lots/{lot.Id}?overrideOverlap=true"
                    : $"api/lots/{lot.Id}";
                var response = await Http.PutAsJsonAsync(putUrl,
                    dto, AppJsonSerializerContext.Default.LotDto);

                if (response.IsSuccessStatusCode)
                {
                    // If active campaign context exists, ensure entry in CampaignLot is created/updated
                    if (CampaignState.CurrentCampaign != null && CampaignState.CurrentCampaign.Id != Guid.Empty)
                    {
                        try
                        {
                            var activeCampaignId = CampaignState.CurrentCampaign.Id;
                            await Http.PostAsJsonAsync($"api/campaigns/{activeCampaignId}/lots",
                                new CampaignLotDto(Guid.Empty, activeCampaignId, lot.Id, lot.FieldId, null, null, 0, (decimal)lot.Area, null),
                                AppJsonSerializerContext.Default.CampaignLotDto);
                        }
                        catch { }
                    }

                    Message.Success($"Geometría vinculada a '{lot.Name}'.");
                    _showLinkModal = false;
                    _importLinkWkt = null;
                    _linkingLotId = Guid.Empty;

                    if (_linkingResult != null)
                    {
                        _importResults.Remove(_linkingResult);
                        _linkingResult = null;
                    }
                    else if (!string.IsNullOrEmpty(_importLinkWkt))
                    {
                        var idx = _importResults.FindIndex(r => r.Wkt == _importLinkWkt);
                        if (idx >= 0) _importResults.RemoveAt(idx);
                    }

                    await ReloadMap(savedBounds);

                    if (_importResults.Count > 0)
                    {
                        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
                        foreach (var r in VisibleImportResults)
                        {
                            await JS.InvokeAsync<bool>("mapInterop.addImportedPolygon", r.Wkt, r.Name);
                        }
                        _showImportModal = true;
                    }
                    else
                    {
                        _showImportModal = false;
                        Message.Success("Se han vinculado todos los polígonos.");
                    }
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var overlapResult = await response.Content.ReadFromJsonAsync<LotOverlapCheckResultDto>(AppJsonSerializerContext.Default.LotOverlapCheckResultDto);
                    if (overlapResult != null)
                    {
                        _overlapWarningResult = overlapResult;
                        _overlapSource = "import";
                        _showOverlapModal = true;
                    }
                    else
                    {
                        Message.Error("La geometría se superpone con otro lote existente.");
                    }
                }
                else
                {
                    Message.Error($"Error: {response.StatusCode}");
                }
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _savingGeometry = false;
        }
    }

    private static string CombineWktGeometries(string existingWkt, string newWkt)
    {
        if (string.IsNullOrWhiteSpace(existingWkt)) return newWkt;
        try
        {
            var reader = new NetTopologySuite.IO.WKTReader();
            var writer = new NetTopologySuite.IO.WKTWriter();

            var g1 = reader.Read(existingWkt);
            var g2 = reader.Read(newWkt);

            var polygons = new List<NetTopologySuite.Geometries.Polygon>();

            void CollectPolygons(NetTopologySuite.Geometries.Geometry geom)
            {
                if (geom is NetTopologySuite.Geometries.Polygon p) polygons.Add(p);
                else if (geom is NetTopologySuite.Geometries.GeometryCollection gc)
                {
                    for (int i = 0; i < gc.NumGeometries; i++)
                    {
                        CollectPolygons(gc.GetGeometryN(i));
                    }
                }
            }

            CollectPolygons(g1);
            CollectPolygons(g2);

            if (polygons.Count == 0) return newWkt;
            if (polygons.Count == 1) return writer.Write(polygons[0]);

            var factory = g1.Factory ?? NetTopologySuite.NtsGeometryServices.Instance.CreateGeometryFactory(4326);
            var multiPoly = factory.CreateMultiPolygon(polygons.ToArray());
            return writer.Write(multiPoly);
        }
        catch
        {
            return newWkt;
        }
    }

    private static object ConvertToLeafletCoords(object? rawCoordinates)
    {
        if (rawCoordinates == null) return new double[0][][];

        if (rawCoordinates is System.Text.Json.JsonElement elem)
        {
            var json = elem.GetRawText();
            if (elem.ValueKind == System.Text.Json.JsonValueKind.Array && elem.GetArrayLength() > 0)
            {
                var first = elem[0];
                if (first.ValueKind == System.Text.Json.JsonValueKind.Array && first.GetArrayLength() > 0 &&
                    first[0].ValueKind == System.Text.Json.JsonValueKind.Array && first[0].GetArrayLength() > 0 &&
                    first[0][0].ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    // MultiPolygon (4D)
                    var multi = System.Text.Json.JsonSerializer.Deserialize<double[][][][]>(json);
                    if (multi != null)
                    {
                        return multi.Select(poly =>
                            poly.Select(ring =>
                                ring.Select(c => new double[] { c[1], c[0] }).ToArray()
                            ).ToArray()
                        ).ToArray();
                    }
                }
            }

            var poly3d = System.Text.Json.JsonSerializer.Deserialize<double[][][]>(json);
            if (poly3d != null)
            {
                return poly3d.Select(ring =>
                    ring.Select(c => new double[] { c[1], c[0] }).ToArray()
                ).ToArray();
            }
        }
        else if (rawCoordinates is double[][][] polyCoords)
        {
            return polyCoords.Select(ring =>
                ring.Select(coord => new double[] { coord[1], coord[0] }).ToArray()
            ).ToArray();
        }
        else if (rawCoordinates is double[][][][] multiCoords)
        {
            return multiCoords.Select(poly =>
                poly.Select(ring =>
                    ring.Select(coord => new double[] { coord[1], coord[0] }).ToArray()
                ).ToArray()
            ).ToArray();
        }

        return new double[0][][];
    }
