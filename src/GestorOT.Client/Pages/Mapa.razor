        await JS.InvokeVoidAsync("mapInterop.clearDrawn");
    }

    private async Task SaveDrawnGeometry()
    {
        if (string.IsNullOrEmpty(_drawnWkt) || _linkingLotId == Guid.Empty) return;

        _savingGeometry = true;
        try
        {
            var lot = _allLots.FirstOrDefault(l => l.Id == _linkingLotId);
            if (lot == null) return;

            // Capture current viewport before reload (#7)
            MapBounds? savedBounds = null;
            try { savedBounds = await JS.InvokeAsync<MapBounds?>("mapInterop.getCurrentBounds"); } catch { }

            // El dibujo manual cae en este PUT, que hasta ahora no validaba nada: la misma
            // geometria se rechazaba si venia de un archivo y se aceptaba si se dibujaba. El
            // backend ya la valida; chequear aca permite mostrar el modal en vez de un 409 seco.
            if (!_pendingOverrideOverlap && lot.FieldId != Guid.Empty)
            {
                var overlap = await CheckOverlapAsync(_drawnWkt, lot.FieldId, lot.Id);
                if (overlap is { HasOverlap: true })
                {
                    _overlapWarningResult = overlap;
                    _overlapSource = "draw";
                    _showOverlapModal = true;
                    return;
                }
            }

            var dto = new LotDto(
                lot.Id,
                lot.FieldId,
                lot.Name,
                lot.Status,
                _drawnWkt,
                lot.FieldName,
                lot.Area,
                lot.CadastralArea
            );

            var putUrl = _pendingOverrideOverlap
                ? $"api/lots/{lot.Id}?overrideOverlap=true"
                : $"api/lots/{lot.Id}";
            var response = await Http.PutAsJsonAsync(putUrl,
                dto, AppJsonSerializerContext.Default.LotDto);

            if (response.IsSuccessStatusCode)
            {
                Message.Success($"Geometría guardada para '{lot.Name}'.");

                // OT-49: guardar el polígono del año puede dejar labores excedidas o un desvío
                // grande contra la catastral. Se avisa con warning y sin auto-cierre implícito:
                // son cosas que el operador tiene que mirar, no errores que reintentar.
                var updateResult = await response.Content.ReadFromJsonAsync<LotUpdateResultDto>(
                    AppJsonSerializerContext.Default.LotUpdateResultDto);

                foreach (var aviso in updateResult?.Warnings ?? new List<string>())
                {
                    Message.Warning(aviso, 8);
                }

                _drawnWkt = null;
                _drawnArea = 0;
                _drawnAreaIsEstimated = false;
                _polygonMenuVisible = false;
                _linkingLotId = Guid.Empty;
                _editingExistingLot = false;
                _editingExistingLotName = "";
                await ReloadMap(savedBounds);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var overlapResult = await response.Content.ReadFromJsonAsync<LotOverlapCheckResultDto>(AppJsonSerializerContext.Default.LotOverlapCheckResultDto);
                if (overlapResult != null)
                {
                    _overlapWarningResult = overlapResult;
                    _overlapSource = "draw";
                    _showOverlapModal = true;
                }
                else
                {
                    Message.Error("La geometría se superpone con otro lote existente.");
                }
            }
            else
            {
                Message.Error($"Error al guardar: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _savingGeometry = false;
        }
    }

