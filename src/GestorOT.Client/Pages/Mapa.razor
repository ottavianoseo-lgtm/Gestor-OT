    /// <summary>
    /// La superficie que se muestra al dibujar tiene que ser la misma que se persiste. El area
    /// que manda Leaflet es una aproximacion esferica en JS; la de PostGIS es la fuente de
    /// verdad, asi que se pide al servidor. Si no responde, se cae al valor local y se marca
    /// como "(estimada)": lo guardado igual sale del backend, pero el operador no ve un numero
    /// que despues va a cambiar sin aviso.
    /// </summary>
    private async Task<double> ResolveDrawnAreaAsync(string wkt, double fallback)
    {
        try
        {
            var req = new CheckLotOverlapRequestDto(wkt, Guid.Empty);
            var resp = await Http.PostAsJsonAsync("api/lots/calculate-area", req, AppJsonSerializerContext.Default.CheckLotOverlapRequestDto);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<LotAreaResult>(AppJsonSerializerContext.Default.LotAreaResult);
                if (result != null)
                {
                    _drawnAreaIsEstimated = false;
                    return result.AreaHa;
                }
            }
        }
        catch { }
        _drawnAreaIsEstimated = true;
        return fallback;
    }

    private async Task<LotOverlapCheckResultDto?> CheckOverlapAsync(string wkt, Guid fieldId, Guid? excludeLotId)
    {
        try
        {
            var req = new CheckLotOverlapRequestDto(wkt, fieldId, excludeLotId);
            var resp = await Http.PostAsJsonAsync("api/lots/check-overlap", req, AppJsonSerializerContext.Default.CheckLotOverlapRequestDto);
            if (resp.IsSuccessStatusCode)
            {
                return await resp.Content.ReadFromJsonAsync<LotOverlapCheckResultDto>(AppJsonSerializerContext.Default.LotOverlapCheckResultDto);
            }
        }
        catch { }
        return null;
    }

