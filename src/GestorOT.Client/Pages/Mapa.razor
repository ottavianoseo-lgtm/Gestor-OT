@code {
    private int _lotsCount = 0;

    // La superficie sale de la property 'area' de cada feature, que el backend calcula con
    // ST_Area(geography). No se recalcula en el cliente: daria un numero distinto al del panel
    // y al de los reportes.
    private double _totalArea = 0;
    private int _fieldsCount = 0;
    private double _fieldsArea = 0;
    private bool _loading = true;
    private bool _hasLoaded = false;
    private string? _errorMessage;
    private LotDto? _selectedLot;
    private List<LotDto> _allLots = new();
    private List<FieldDto> _allFields = new();
    private List<LotDto> _orphanLots = new();
    private string _orphanSearch = "";
    private bool _showOrphanPanel;
    private bool _showImportModal;
    private bool _showLinkModal;
    private bool _importLoading;
    private bool _savingGeometry;
    private bool _deletingGeometry;
    private LotOverlapCheckResultDto? _overlapWarningResult;
    private bool _showOverlapModal;
    private bool _pendingOverrideOverlap;
    private string? _overlapSource;
    private string? _drawnWkt;
    private double _drawnArea;
    private bool _drawnAreaIsEstimated;
    private Guid _linkingLotId;
    private string? _cityQuery;
    private bool _showCreateLotInline;
    private string _newLotName = "";
    private Guid _newLotFieldId;
    private bool _creatingLot;
    private string? _importLinkWkt;
    private List<ImportResult> _importResults = new();
    private bool _showLotsPanel;
    private string _lotsSearch = "";
    private CancellationTokenSource? _lotsSearchDebounce;

    /// <summary>
    /// El filtro es solo de presentacion: no toca _allLots ni pega al backend. La misma
    /// lista alimenta el panel y lo que se ve en el mapa, para que no puedan discrepar.
    /// </summary>
    private IEnumerable<LotDto> FilteredLots => string.IsNullOrWhiteSpace(_lotsSearch)
        ? _allLots
        : _allLots.Where(l =>
            l.Name.Contains(_lotsSearch, StringComparison.OrdinalIgnoreCase) ||
            (l.FieldName?.Contains(_lotsSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task OnLotsSearchChanged(ChangeEventArgs e)
    {
        _lotsSearch = e.Value?.ToString() ?? "";

        // Sin debounce se llamaria a JS en cada tecla, y cada llamada recorre todas las capas.
        _lotsSearchDebounce?.Cancel();
        _lotsSearchDebounce = new CancellationTokenSource();
        var token = _lotsSearchDebounce.Token;

        try
        {
            await Task.Delay(250, token);
            await ApplyLotFilterAsync();
        }
        catch (TaskCanceledException)
        {
            // Llego otra tecla antes de los 250 ms: vale la ultima.
        }
    }

    private async Task ApplyLotFilterAsync()
    {
        // null significa "sin filtro": el mapa vuelve a mostrar lo que diga el modo de vista.
        var visibles = string.IsNullOrWhiteSpace(_lotsSearch)
            ? null
            : FilteredLots.Select(l => l.Id.ToString()).ToArray();

        await JS.InvokeAsync<int>("mapInterop.filterLots", visibles);
        StateHasChanged();
    }

    private async Task ClearLotsFilter()
    {
        _lotsSearch = "";
        await ApplyLotFilterAsync();
    }

    private async Task FitFilteredLots()
    {
        await JS.InvokeAsync<bool>("mapInterop.fitVisibleLots");
    }
    private bool _polygonMenuVisible;
    private bool _editingExistingLot;
    private string _editingExistingLotName = "";

    [Parameter][SupplyParameterFromQuery] public string? lotId { get; set; }

    private async Task SearchCity()
    {
        if (string.IsNullOrWhiteSpace(_cityQuery)) return;
        await JS.InvokeVoidAsync("mapInterop.searchCity", _cityQuery);
    }

    private async Task CreateAndLinkLot()
    {
        if (string.IsNullOrWhiteSpace(_newLotName) || _newLotFieldId == Guid.Empty)
        {
            Message.Warning("Complete el nombre y el campo.");
            return;
        }

        _creatingLot = true;
        try
        {
            // El panel inline creaba el lote sin chequear solapamiento. Es una creacion nueva,
            // asi que no hay self-overlap que excluir: la geometria dibujada se valida contra
            // el campo entero, igual que en la importacion.
            if (!_pendingOverrideOverlap && !string.IsNullOrEmpty(_drawnWkt) && _newLotFieldId != Guid.Empty)
            {
                var overlapCheck = await CheckOverlapAsync(_drawnWkt, _newLotFieldId, null);
                if (overlapCheck is { HasOverlap: true })
                {
                    _overlapWarningResult = overlapCheck;
                    _overlapSource = "create";
                    _showOverlapModal = true;
                    return;
                }
            }

            var dto = new LotDto(Guid.Empty, _newLotFieldId, _newLotName, "Active", _drawnWkt, "", _drawnArea, (decimal)_drawnArea);
            var queryParams = "";
            if (CampaignState.CurrentCampaign != null && CampaignState.CurrentCampaign.Id != Guid.Empty)
            {
                queryParams = $"campaignId={CampaignState.CurrentCampaign.Id}";
            }
            if (_pendingOverrideOverlap)
            {
                queryParams = string.IsNullOrEmpty(queryParams)
                    ? "overrideOverlap=true"
                    : $"{queryParams}&overrideOverlap=true";
            }
            var postUrl = string.IsNullOrEmpty(queryParams) ? "api/lots" : $"api/lots?{queryParams}";
            var response = await Http.PostAsJsonAsync(postUrl, dto);
            
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<LotDto>(AppJsonSerializerContext.Default.LotDto);
                if (created != null)
                {
                    _allLots.Add(created);
                    _linkingLotId = created.Id;
                    _showCreateLotInline = false;
                    Message.Success("Lote creado y vinculado.");
                    // Immediately save geometry since we already have the WKT and the ID
                    await SaveDrawnGeometry();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var overlapResult = await response.Content.ReadFromJsonAsync<LotOverlapCheckResultDto>(AppJsonSerializerContext.Default.LotOverlapCheckResultDto);
                if (overlapResult != null)
                {
                    _overlapWarningResult = overlapResult;
                    _overlapSource = "create";
                    _showOverlapModal = true;
                }
                else
                {
                    Message.Error("El lote dibujado se superpone con otro lote existente.");
                }
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al crear lote: {err}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _creatingLot = false;
        }
    }

    private async Task StartDrawingForLot(LotDto lot)
    {
        _linkingLotId = lot.Id;
        _showOrphanPanel = false;
        await JS.InvokeVoidAsync("mapInterop.enableDrawing");
    }

    private async Task EditLotGeometry(LotDto lot)
    {
        _editingExistingLot = true;
        _editingExistingLotName = lot.Name;
        _linkingLotId = lot.Id;
        _selectedLot = null;
        _drawnWkt = null;

        var coordinatesJson = lot.WktGeometry != null
            ? await ConvertWktToLeafletCoords(lot.WktGeometry)
            : "[]";
        await JS.InvokeVoidAsync("mapInterop.startEditExistingLot",
            lot.Id.ToString(), lot.Name, lot.Status, lot.Area, lot.FieldName ?? "", coordinatesJson);
    }

    private async Task DeleteLotGeometry(LotDto lot)
    {
        if (lot == null || _deletingGeometry) return;
        _deletingGeometry = true;
        try
        {
            var response = await Http.DeleteAsync($"api/lots/{lot.Id}/geometry");
            if (response.IsSuccessStatusCode)
            {
                Message.Success($"Geometría eliminada de '{lot.Name}'.");
                await ReloadMap();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al eliminar la geometría: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _deletingGeometry = false;
        }
    }

    private async Task<string> ConvertWktToLeafletCoords(string wkt)
    {
        try
        {
            var coordsObj = await JS.InvokeAsync<object>("mapInterop.wktToLeafletCoords", wkt);
            return System.Text.Json.JsonSerializer.Serialize(coordsObj);
        }
        catch
        {
            return "[]";
        }
    }

    public class ImportResult
    {
        public string Wkt { get; set; } = "";
        public string Name { get; set; } = "";
        public string? SourceShapefile { get; set; }

        /// <summary>
        /// Columnas del .dbf de esta feature (solo se llena en imports de shapefile). Permite
        /// recalcular el nombre en el cliente cuando el usuario cambia la columna elegida, sin
        /// volver a pedirle el archivo al backend (OT-50).
        /// </summary>
        public Dictionary<string, string>? Attributes { get; set; }

        /// <summary>
        /// Superficie que ya calculó el backend al leer el shapefile (ST_Area). Se necesita para
        /// mandarla en <see cref="ShapefileFeatureDto"/> al pedir la conciliación masiva (OT-48):
        /// no se recalcula en el cliente, para no mostrar un número distinto al de la tabla.
        /// </summary>
        public double AreaHa { get; set; }
    }

