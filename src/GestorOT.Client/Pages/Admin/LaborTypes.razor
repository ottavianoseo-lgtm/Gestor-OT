@page "/admin/labor-types"
@using GestorOT.Shared.Dtos
@using GestorOT.Domain.Enums
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.CatalogCache CatalogCache

<PageTitle>Tipos de Labor - Admin</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Tipos de Labor</h2>
        <span class="page-subtitle">Marcá cada tarea como propia o de contratista para filtrar el alta de labores</span>
    </div>
</div>

@if (_unclassifiedCount > 0)
{
    <Alert Type="@AlertType.Warning" ShowIcon="true" Style="margin-bottom: 16px;"
           Message="@($"{_unclassifiedCount} de {_types.Count} tipos siguen sin clasificar")"
           Description="@("Mientras no tengan modo, aparecen tanto en las labores propias como en las de contratista. Clasificalos para que el filtro sirva.")" />
}

<div class="glass-card">
    <div style="margin-bottom: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <Input Placeholder="Buscar tarea, subgrupo o codigo..." @bind-Value="_search" OnInput="() => StateHasChanged()" AllowClear
               PrefixIcon="search" Style="max-width: 360px; border-radius: 8px;" />
        <Checkbox @bind-Checked="_onlyUnclassified">Solo sin clasificar</Checkbox>
    </div>

    <Table TItem="LaborTypeDto" DataSource="Filtered" Loading="_loading" Size="TableSize.Small">
        <PropertyColumn Property="c => c.ExternalErpId" Title="Código ERP" Width="120" />
        <PropertyColumn Property="c => c.Name" Title="Tarea" Sortable />
        <Column TData="string" Title="Subgrupo ERP" Width="220">
            @if (!string.IsNullOrWhiteSpace(context.ShortSubGroup))
            {
                <Tag Color="@AntDesign.TagColor.Blue">@context.ShortSubGroup</Tag>
            }
            else
            {
                <span style="color: var(--text-secondary);">-</span>
            }
        </Column>
        <Column TData="string" Title="Modo" Width="260">
            <RadioGroup Value="@context.ExecutionMode" TValue="LaborExecutionMode?" Size="@InputSize.Small"
                        ValueChanged="mode => SetMode(context, mode)"
                        Disabled="_savingId == context.Id">
                <RadioButton Value="@(LaborExecutionMode.Own)">Propia</RadioButton>
                <RadioButton Value="@(LaborExecutionMode.Contractor)">Contratista</RadioButton>
            </RadioGroup>
            @if (context.ExecutionMode is null)
            {
                <Tag Color="@AntDesign.TagColor.Orange" Style="margin-left: 8px;">Sin clasificar</Tag>
            }
        </Column>
    </Table>
</div>

@code {
    private List<LaborTypeDto> _types = new();
    private bool _loading = true;
    private string _search = "";
    private bool _onlyUnclassified;
    private Guid? _savingId;

    private int _unclassifiedCount => _types.Count(t => t.ExecutionMode is null);

    private IEnumerable<LaborTypeDto> Filtered
    {
        get
        {
            IEnumerable<LaborTypeDto> q = _types;

            if (_onlyUnclassified)
            {
                q = q.Where(t => t.ExecutionMode is null);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(t => t.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || (t.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (t.ExternalErpId?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return q;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _types = await Http.GetFromJsonAsync<List<LaborTypeDto>>("api/labor-types") ?? new();
        }
        catch (Exception)
        {
            Message.Error("Error al cargar los tipos de labor.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetMode(LaborTypeDto type, LaborExecutionMode? mode)
    {
        if (type.ExecutionMode == mode) return;

        _savingId = type.Id;
        try
        {
            var response = await Http.PatchAsync(
                $"api/labor-types/{type.Id}/execution-mode?mode={mode}", null);

            if (!response.IsSuccessStatusCode)
            {
                Message.Error($"No se pudo guardar el modo de «{type.Name}».");
                return;
            }

            var index = _types.FindIndex(t => t.Id == type.Id);
            if (index >= 0)
            {
                _types[index] = _types[index] with { ExecutionMode = mode };
            }

            // El editor de labores lee este catálogo cacheado; sin esto el filtro
            // sigue viendo el modo viejo hasta que vence el TTL.
            CatalogCache.Invalidate("labor-types");
        }
        catch
        {
            Message.Error("Error de red al guardar el modo.");
        }
        finally
        {
            _savingId = null;
        }
    }
}
