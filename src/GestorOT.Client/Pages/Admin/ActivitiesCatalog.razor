@page "/admin/activities"
@using GestorOT.Shared.Dtos
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.TenantState TenantState

<PageTitle>Actividades ERP - Admin</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Actividades y Cultivos (ERP)</h2>
        <span class="page-subtitle">Gestiona las actividades disponibles traídas del ERP. Desactiva las que tu empresa no utilice para mantener limpios los selectores.</span>
    </div>
    <Button Type="@ButtonType.Primary" Icon="sync" OnClick="SyncFromErp" Loading="_syncing"
            Style="background: #E74C3C; border-color: #E74C3C; border-radius: 8px; font-weight: 600;">
        Sincronizar Actividades
    </Button>
</div>

<div class="glass-card">
    <RemoteTable @ref="_table"
                 TItem="ErpActivityDto"
                 Load="LoadActivities"
                 FixedFilters="@AllActivities"
                 StateKey="admin-activities"
                 SearchPlaceholder="Buscar por nombre o código ERP..."
                 ItemLabel="actividades"
                 RowKey="a => a.Id.ToString()">
        <Filters>
            <SelectFilter Param="active" Placeholder="Estado" Options="@StatusOptions" Style="width: 150px;" />
        </Filters>
        <ChildContent>
            <PropertyColumn Property="a => a.ExternalErpId" Title="Código ERP" Width="130" />
            <PropertyColumn Property="a => a.Name" Title="Nombre de la Actividad / Cultivo" Sortable />
            <Column TData="bool" Title="Estado" Width="130">
                @if (context.IsActive)
                {
                    <Tag Color="@AntDesign.TagColor.Green"><Icon Type="check-circle" /> Activa</Tag>
                }
                else
                {
                    <Tag Color="@AntDesign.TagColor.Default"><Icon Type="close-circle" /> Inactiva</Tag>
                }
            </Column>
            <ActionColumn Title="Acciones" Width="130" Align="ColumnAlign.Right">
                @if (!context.IsActive)
                {
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" Ghost
                            OnClick="() => ToggleActive(context)" Loading="_processingId == context.Id">
                        Activar
                    </Button>
                }
                else
                {
                    <Button Type="@ButtonType.Default" Danger Size="@ButtonSize.Small" Ghost
                            OnClick="() => ToggleActive(context)" Loading="_processingId == context.Id">
                        Desactivar
                    </Button>
                }
            </ActionColumn>
        </ChildContent>
    </RemoteTable>
</div>

@code {
    private RemoteTable<ErpActivityDto>? _table;
    private bool _syncing;
    private Guid? _processingId;

    // Sin filtro se listan activas e inactivas, como antes; "active" elige una de las dos.
    private static readonly IReadOnlyDictionary<string, string?> AllActivities = new Dictionary<string, string?>
    {
        ["includeInactive"] = "true",
    };

    private static readonly List<FilterOption> StatusOptions = new()
    {
        new("true", "Activas"),
        new("false", "Inactivas"),
    };

    private Task<PagedResult<ErpActivityDto>?> LoadActivities(string query, CancellationToken ct) =>
        Http.GetFromJsonAsync<PagedResult<ErpActivityDto>>($"api/catalogs/activities/search?{query}", ct);

    private Task ReloadTable() => _table?.ReloadAsync() ?? Task.CompletedTask;

    private async Task SyncFromErp()
    {
        _syncing = true;
        try
        {
            var tenantId = TenantState.CurrentTenant?.Id;
            var response = await Http.PostAsync($"api/sync/activities?tenantId={tenantId}", null);
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Sincronización de actividades completada.");
                await ReloadTable();
            }
            else
            {
                Message.Error("Error en la sincronización.");
            }
        }
        catch
        {
            Message.Error("Error de conexión con el servidor.");
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task ToggleActive(ErpActivityDto activity)
    {
        _processingId = activity.Id;
        try
        {
            var response = await Http.PutAsync($"api/catalogs/activities/{activity.Id}/toggle-active", null);
            if (response.IsSuccessStatusCode)
            {
                var newStatus = !activity.IsActive;
                Message.Success($"Actividad '{activity.Name}' {(newStatus ? "activada" : "desactivada")}.");
                await ReloadTable();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Message.Error(string.IsNullOrWhiteSpace(err) ? "No se pudo actualizar el estado." : err);
            }
        }
        catch
        {
            Message.Error("Error de red al actualizar la actividad.");
        }
        finally
        {
            _processingId = null;
        }
    }
}
