@page "/importaciones-pendientes"
@using GestorOT.Shared
@using GestorOT.Shared.Dtos
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.TenantState TenantState
@inject GestorOT.Client.Services.CampaignState CampaignState
@implements IDisposable

<PageTitle>Importaciones Pendientes - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Importaciones Pendientes</h2>
        <span class="page-subtitle">Filas de Excel que no hicieron match al subir. Matchealas a mano cuando quieras: nada de esto es una labor todavía.</span>
    </div>
    <div style="display: flex; gap: 8px; align-items: center;">
        @if (CampaignState.CurrentCampaign != null)
        {
            <span style="font-size: 12px; color: rgba(255,255,255,0.6);">Campaña: <strong style="color: #fff;">@CampaignState.CurrentCampaign.Name</strong></span>
        }
        @if (_selectedBatchId.HasValue)
        {
            <Button OnClick="BackToList" Style="border-radius: 6px;">
                <Icon Type="arrow-left" /> Volver al listado
            </Button>
        }
    </div>
</div>

@if (CampaignState.CurrentCampaign == null)
{
    <Alert Type="@AlertType.Warning" Message="No hay ninguna campaña seleccionada"
           Description="Seleccioná una campaña activa en la barra superior para ver sus importaciones pendientes."
           ShowIcon="true" Style="margin: 16px 0;" />
}
else if (_loading)
{
    <div style="text-align: center; padding: 60px;">
        <Spin Size="AntDesign.SpinSize.Large" Tip="Cargando importaciones pendientes..." />
    </div>
}
else if (!_selectedBatchId.HasValue)
{
    @if (_batches.Count == 0)
    {
        <div style="text-align: center; padding: 60px; color: rgba(255,255,255,0.4);">
            <Icon Type="inbox" Theme="IconThemeType.Outline" Style="font-size: 48px; margin-bottom: 16px; display: block;" />
            <p>No hay importaciones pendientes en esta campaña. Todo lo subido hizo match completo.</p>
        </div>
    }
    else
    {
        <Table DataSource="_batches" Size="@TableSize.Middle">
            <PropertyColumn Property="c => c.FileName" Title="Archivo" />
            <Column TData="LaborImportBatchDto" Title="Subida">
                <span style="font-size: 12px; color: rgba(255,255,255,0.7);">@context.UploadedAt.ToString("dd/MM/yyyy HH:mm")</span>
                @if (!string.IsNullOrWhiteSpace(context.UploadedBy))
                {
                    <span style="font-size: 11px; color: rgba(255,255,255,0.4); display: block;">@context.UploadedBy</span>
                }
            </Column>
            <Column TData="LaborImportBatchDto" Title="Filas">
                <span style="font-size: 12px; color: rgba(255,255,255,0.8);">
                    <span style="color: #2ECC71; font-weight: 600;">@context.ImportedCount imp.</span>
                    &bull; <span style="color: #F39C12; font-weight: 600;">@context.PendingCount pend.</span>
                    &bull; @context.ExcludedCount desc.
                </span>
            </Column>
            <Column TData="LaborImportBatchDto" Title="Estado">
                @if (context.Status == "Completed")
                {
                    <Tag Color="@("green")">Completo</Tag>
                }
                else
                {
                    <Tag Color="@("orange")">Pendiente (@context.PendingCount)</Tag>
                }
            </Column>
            <Column TData="LaborImportBatchDto" Title="">
                <Button Size="@ButtonSize.Small" OnClick="() => OpenBatch(context.Id)" Style="border-radius: 6px;">
                    @(context.Status == "Completed" ? "Ver" : "Conciliar")
                </Button>
            </Column>
        </Table>
    }
}
else if (_detail != null)
{
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
        <div>
            <h3 style="color: #fff; margin: 0; font-size: 18px;">@_detail.Batch.FileName</h3>
            <span style="color: rgba(255,255,255,0.6); font-size: 13px;">
                Subido el @_detail.Batch.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                &bull; <span style="color: #2ECC71;">@_detail.Batch.ImportedCount importadas</span>
                &bull; <span style="color: #F39C12;">@_detail.Batch.PendingCount pendientes</span>
                &bull; @_detail.Batch.ExcludedCount descartadas
            </span>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <Button Size="@ButtonSize.Small" OnClick="Reevaluate" Loading="_busy" Style="border-radius: 6px;">
                <Icon Type="sync" /> Re-evaluar matches
            </Button>
            <Button Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="SaveMappings" Loading="_busy"
                    Disabled="@(!_mappingsDirty)" Style="border-radius: 6px;">
                <Icon Type="save" /> Guardar matches
            </Button>
        </div>
    </div>

    @if (_detail.Batch.Status == "Completed")
    {
        <Alert Type="@AlertType.Success" Message="Lote completo"
               Description="Todas las filas ya fueron importadas o descartadas. Queda como historial."
               ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    @if (!string.IsNullOrEmpty(_actionError))
    {
        <Alert Type="@AlertType.Error" Message="@_actionError" ShowIcon="true" Style="margin-bottom: 16px;" />
    }

    <ErrorBoundary @ref="_panelBoundary">
        <ChildContent>
            <LaborImportReviewPanel Preview="_detail.Preview"
                                    RowStates="_rowStates"
                                    ShowSelection="@(_detail.Batch.Status != "Completed")"
                                    SelectedRows="_selectedRows"
                                    SelectedRowsChanged="OnSelectedRowsChanged"
                                    OnMappingsChanged="OnMappingsChanged"
                                    BatchId="_selectedBatchId"
                                    OnRowSaved="@(() => OpenBatch(_selectedBatchId!.Value))" />
        </ChildContent>
        <ErrorContent Context="ex">
            <Alert Type="@AlertType.Error"
                   Message="No se pudo dibujar la vista de conciliación"
                   Description="@($"{ex.GetType().Name}: {ex.Message}")"
                   ShowIcon="true" Style="margin-bottom: 16px;" />
            <pre style="max-height: 240px; overflow: auto; font-size: 11px; color: rgba(255,255,255,0.6); background: rgba(0,0,0,0.3); padding: 12px; border-radius: 8px;">@ex.StackTrace</pre>
        </ErrorContent>
    </ErrorBoundary>

    @if (_detail.Batch.Status != "Completed")
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 13px; color: rgba(255,255,255,0.6);">@_selectedRows.Count fila(s) seleccionadas</span>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <Button OnClick="() => DiscardSelected()" Loading="_busy" Style="border-radius: 8px;">
                    <Icon Type="close-circle" /> Descartar seleccionadas
                </Button>
                <Button Type="@ButtonType.Primary" OnClick="() => ImportSelected()" Loading="_busy"
                        Style="background: #2ECC71; border-color: #2ECC71; font-weight: 600; border-radius: 8px;">
                    <Icon Type="check" /> Importar seleccionadas
                </Button>
                <Button Type="@ButtonType.Primary" OnClick="() => ImportSelected(importAll: true)" Loading="_busy"
                        Style="border-radius: 8px;">
                    Importar todo lo pendiente
                </Button>
            </div>
        </div>
    }
}

@code {
    private List<LaborImportBatchDto> _batches = new();
    private Guid? _selectedBatchId;
    private LaborImportBatchDetailDto? _detail;
    private Dictionary<int, string> _rowStates = new();
    private HashSet<int> _selectedRows = new();
    private bool _loading = true;
    private bool _busy = false;
    private bool _mappingsDirty = false;
    private string? _actionError;
    private ErrorBoundary? _panelBoundary;

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnChange += OnStateChanged;
        CampaignState.OnChange += OnStateChanged;
        await LoadBatches();
    }

    public void Dispose()
    {
        TenantState.OnChange -= OnStateChanged;
        CampaignState.OnChange -= OnStateChanged;
    }

    private void OnStateChanged()
    {
        _selectedBatchId = null;
        _detail = null;
        InvokeAsync(async () => { await LoadBatches(); StateHasChanged(); });
    }

    private async Task LoadBatches()
    {
        _loading = true;
        try
        {
            if (CampaignState.CurrentCampaign != null)
            {
                _batches = await Http.GetFromJsonAsync(
                    $"api/campaigns/{CampaignState.CurrentCampaign.Id}/labors/import/batches",
                    AppJsonSerializerContext.Default.ListLaborImportBatchDto) ?? new();
            }
            else
            {
                _batches = new();
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error cargando lotes pendientes: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenBatch(Guid batchId)
    {
        _selectedBatchId = batchId;
        _selectedRows = new();
        _mappingsDirty = false;
        _actionError = null;
        _panelBoundary?.Recover();
        _loading = true;
        try
        {
            _detail = await Http.GetFromJsonAsync(
                $"api/labors/import/batches/{batchId}",
                AppJsonSerializerContext.Default.LaborImportBatchDetailDto);
            if (_detail != null)
                _rowStates = _detail.RowStates.ToDictionary(s => s.RowIndex, s => s.Resolution);
        }
        catch (Exception ex)
        {
            Message.Error($"Error abriendo el lote: {ex.Message}");
            _selectedBatchId = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BackToList()
    {
        _selectedBatchId = null;
        _detail = null;
        await LoadBatches();
    }

    private void OnMappingsChanged()
    {
        _mappingsDirty = true;
    }

    private void OnSelectedRowsChanged(HashSet<int> rows)
    {
        _selectedRows = rows;
    }

    private async Task SaveMappings()
    {
        if (_detail == null || !_selectedBatchId.HasValue) return;
        _busy = true;
        _actionError = null;
        try
        {
            var body = new LaborImportBatchMappingsDto
            {
                SupplyMappings = _detail.Preview.SupplyMappings,
                LaborTypeMappings = _detail.Preview.LaborTypeMappings,
                SupplierMappings = _detail.Preview.SupplierMappings
            };
            var response = await Http.PutAsJsonAsync(
                $"api/labors/import/batches/{_selectedBatchId.Value}/mappings",
                body, AppJsonSerializerContext.Default.LaborImportBatchMappingsDto);
            if (response.IsSuccessStatusCode)
            {
                _mappingsDirty = false;
                Message.Success("Matches guardados.");
                await OpenBatch(_selectedBatchId.Value);
            }
            else
            {
                _actionError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Reevaluate()
    {
        if (!_selectedBatchId.HasValue) return;
        _busy = true;
        _actionError = null;
        try
        {
            var response = await Http.PostAsync($"api/labors/import/batches/{_selectedBatchId.Value}/reevaluate", null);
            if (response.IsSuccessStatusCode)
            {
                _detail = await response.Content.ReadFromJsonAsync<LaborImportBatchDetailDto>(
                    AppJsonSerializerContext.Default.LaborImportBatchDetailDto);
                if (_detail != null)
                {
                    _rowStates = _detail.RowStates.ToDictionary(s => s.RowIndex, s => s.Resolution);
                    _selectedRows = new();
                }
                Message.Success("Matches re-evaluados contra los catálogos actuales.");
            }
            else
            {
                _actionError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportSelected(bool importAll = false)
    {
        if (!_selectedBatchId.HasValue) return;
        List<int>? rows = importAll ? null : _selectedRows.ToList();
        if (!importAll && (rows == null || rows.Count == 0))
        {
            Message.Warning("Seleccioná al menos una fila pendiente.");
            return;
        }
        await ResolveRows("import", rows);
    }

    private async Task DiscardSelected()
    {
        if (!_selectedBatchId.HasValue || _selectedRows.Count == 0)
        {
            Message.Warning("Seleccioná al menos una fila pendiente.");
            return;
        }
        await ResolveRows("discard", _selectedRows.ToList());
    }

    private async Task ResolveRows(string action, List<int>? rows)
    {
        if (!_selectedBatchId.HasValue) return;
        _busy = true;
        _actionError = null;
        try
        {
            var body = new LaborImportBatchRowsRequestDto { RowIndexes = rows };
            var response = await Http.PostAsJsonAsync(
                $"api/labors/import/batches/{_selectedBatchId.Value}/{action}",
                body, AppJsonSerializerContext.Default.LaborImportBatchRowsRequestDto);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LaborImportBatchResolveResultDto>(
                    AppJsonSerializerContext.Default.LaborImportBatchResolveResultDto);
                if (result != null)
                {
                    if (result.Success)
                        Message.Success(action == "import"
                            ? $"{result.Imported} fila(s) importadas como labores."
                            : $"{result.Excluded} fila(s) descartadas.");
                    if (result.Errors.Count > 0)
                        _actionError = string.Join(" ", result.Errors.Take(5));
                    if (result.BatchCompleted)
                        Message.Success("Lote completo: no quedan filas pendientes.");
                }
                _selectedRows = new();
                await OpenBatch(_selectedBatchId.Value);
                await LoadBatches();
            }
            else
            {
                _actionError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
