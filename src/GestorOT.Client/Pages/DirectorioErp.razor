@page "/erp-directory"
@using GestorOT.Shared.Dtos
@using GestorOT.Shared
@using GestorOT.Domain.Enums
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.TenantState TenantState
@implements IDisposable

<PageTitle>Directorio ERP - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Directorio Maestro ERP</h2>
        <span class="page-subtitle">Listado de personas sincronizadas. Active las requeridas para utilizarlas en Labores y OTs.</span>
    </div>
    <div style="display: flex; gap: 8px;">
        <Button Icon="sync" OnClick="SyncFromErp" Loading="_syncing">Sincronizar con ERP</Button>
    </div>
</div>

<div class="glass-card">
    <RemoteTable @ref="_table"
                 TItem="ErpPersonDto"
                 Load="LoadPeople"
                 SortKeys="@SortKeys"
                 StateKey="erp-directory"
                 SearchPlaceholder="Buscar por nombre, CUIT o código ERP..."
                 ItemLabel="personas"
                 RowKey="p => p.Id.ToString()">
        <Filters>
            <SelectFilter Param="activated" Placeholder="Estado" Options="@StatusOptions" Style="width: 160px;" />
        </Filters>
        <ChildContent>
            <PropertyColumn Property="p => p.FullName" Title="Nombre" Sortable DefaultSortOrder="@SortDirection.Ascending">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <Icon Type="user" Theme="IconThemeType.Outline" Style="color: #3498DB;" />
                    <span style="font-weight: 600; color: #fff;">@context.FullName</span>
                </div>
            </PropertyColumn>
            <PropertyColumn Property="p => p.VatNumber" Title="CUIT" Sortable Width="160" />
            <PropertyColumn Property="p => p.ExternalId" Title="Código ERP" Width="130" />
            <PropertyColumn Property="p => p.IsActiveContact" Title="Estado" Width="120">
                @if (context.IsActiveContact)
                {
                    <Tag Color="@("green")">Activado</Tag>
                }
                else
                {
                    <Tag>Sin activar</Tag>
                }
            </PropertyColumn>
            <ActionColumn Title="Acciones" Width="170">
                @if (!context.IsActiveContact)
                {
                    <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="() => OpenActivationModal(context)"
                            Style="background: #3498DB; border-color: #3498DB; border-radius: 6px;">
                        Activar Contacto
                    </Button>
                }
            </ActionColumn>
        </ChildContent>
    </RemoteTable>
</div>

<Modal Title="Activar Contacto" Visible="@_activationModalVisible" OnCancel="() => _activationModalVisible = false" Footer="null">
    @if (_selectedPerson != null)
    {
        <div style="margin-bottom: 20px;">
            <p style="color: rgba(255,255,255,0.7); margin-bottom: 16px;">
                Está a punto de activar a <strong>@_selectedPerson.FullName</strong> en Gestor-OT. 
                Por favor, asigne el rol que desempeñará:
            </p>
            <div style="margin-bottom: 8px; color: #fff;">Rol del contacto:</div>
            <Select TItemValue="ContactRole" TItem="ContactRole" @bind-Value="_selectedRole" Style="width: 100%;">
                @foreach (ContactRole role in Enum.GetValues(typeof(ContactRole)))
                {
                    <SelectOption TItemValue="ContactRole" TItem="ContactRole" Value="@role" Label="@role.GetDisplayName()" />
                }
            </Select>
        </div>
        <div style="text-align: right;">
            <Button OnClick="() => _activationModalVisible = false" Style="margin-right: 8px;">Cancelar</Button>
            <Button Type="@ButtonType.Primary" Loading="_activating" OnClick="ActivateSelectedPerson">
                Confirmar Activación
            </Button>
        </div>
    }
</Modal>


@code {
    private RemoteTable<ErpPersonDto>? _table;
    
    private bool _activationModalVisible = false;
    private ErpPersonDto? _selectedPerson;
    private ContactRole _selectedRole = ContactRole.InternalStaff;
    private bool _activating = false;
    private bool _syncing = false;

    private static readonly List<FilterOption> StatusOptions = new()
    {
        new("false", "Sin activar"),
        new("true", "Activadas"),
    };

    // Propiedad de la columna → clave de orden de api/erppeople/search.
    private static readonly IReadOnlyDictionary<string, string> SortKeys = new Dictionary<string, string>
    {
        [nameof(ErpPersonDto.FullName)] = "name",
        [nameof(ErpPersonDto.VatNumber)] = "vatNumber",
    };

    // Son miles de personas: la API pagina y busca; antes se bajaba el directorio entero.
    private Task<PagedResult<ErpPersonDto>?> LoadPeople(string query, CancellationToken ct) =>
        Http.GetFromJsonAsync<PagedResult<ErpPersonDto>>($"api/erppeople/search?{query}", ct);

    // La tabla carga su primera página sola.
    protected override void OnInitialized()
    {
        TenantState.OnChange += OnTenantChanged;
    }

    public void Dispose()
    {
        TenantState.OnChange -= OnTenantChanged;
    }

    private void OnTenantChanged()
    {
        InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
    }

    private Task LoadData() => _table?.ReloadAsync() ?? Task.CompletedTask;

    private void OpenActivationModal(ErpPersonDto person)
    {
        _selectedPerson = person;
        _selectedRole = ContactRole.InternalStaff;
        _activationModalVisible = true;
    }

    private async Task ActivateSelectedPerson()
    {
        if (_selectedPerson == null) return;
        
        _activating = true;
        try
        {
            var request = new ActivateContactRequest
            {
                ErpPersonId = _selectedPerson.Id,
                Role = _selectedRole
            };

            var response = await Http.PostAsJsonAsync("api/erppeople/activate", request, AppJsonSerializerContext.Default.ActivateContactRequest);
            
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Contacto activado exitosamente.");
                await LoadData();
                _activationModalVisible = false;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al activar: {error}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _activating = false;
            StateHasChanged();
        }
    }

    private async Task SyncFromErp()
    {
        _syncing = true;
        try
        {
            var response = await Http.PostAsync($"api/tenants/{TenantState.CurrentTenant?.Id}/sync-contacts", null);
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Sincronización completada.");
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message.Error($"Error sincronizando: {error}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _syncing = false;
        }
    }
}
