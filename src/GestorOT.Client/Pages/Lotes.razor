@page "/lots"
@using GestorOT.Shared.Dtos
@using GestorOT.Shared
@using System.Net.Http.Json
@using AntDesign
@using AntDesign.TableModels
@inject HttpClient Http
@inject IMessageService Message
@inject NavigationManager Nav
@inject GestorOT.Client.Services.CampaignState CampaignState
@inject GestorOT.Client.Services.TenantState TenantState
@inject ModalService ModalService
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Lotes - GestorOT</PageTitle>

<div class="page-header">
    <div>
        <h2 class="page-title">Gestión de Lotes</h2>
        <span class="page-subtitle">@_total lotes registrados</span>
    </div>
    <div style="display: flex; align-items: center; gap: 16px;">
        <Button Type="@ButtonType.Default" OnClick="OpenImportModal"
                Style="background: rgba(46, 204, 113, 0.15); border-color: #2ECC71; color: #2ECC71; border-radius: 8px; font-weight: 600;">
            <Icon Type="file-excel" Theme="IconThemeType.Outline" /> Importar Excel
        </Button>
        <Button Type="@ButtonType.Primary" OnClick="OpenCreateModal"
                Style="background: #E74C3C; border-color: #E74C3C; border-radius: 8px; font-weight: 600;">
            <Icon Type="plus" Theme="IconThemeType.Outline" /> Nuevo Lote
        </Button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <Alert Type="@AlertType.Error" Message="@_errorMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
}

<div class="summary-bar" style="display: flex; gap: 24px; background: rgba(255,255,255,0.03); padding: 16px 24px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); margin-bottom: 16px;">
    <div class="summary-item">
                        <div style="font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Total ha</div>
        <div style="font-size: 18px; font-weight: 700; color: #fff;">@_totalCadastralArea.ToString("N2") ha</div>
    </div>
    @if (CampaignState.IsSelected)
    {
        <div class="summary-item">
            <div style="font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Total Productiva</div>
            <div style="font-size: 18px; font-weight: 700; color: #2ECC71;">@_campaignLots.Sum(l => l.ProductiveArea).ToString("N2") ha</div>
        </div>
        <div class="summary-item">
            <div style="font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Variación Total</div>
            @{
                var totalVari = _campaignLots.Sum(l => l.ProductiveArea) - _campaignLots.Sum(l => l.CadastralArea);
                var variColor = totalVari < 0 ? "#E74C3C" : (totalVari > 0 ? "#2ECC71" : "#fff");
            }
            <div style="font-size: 18px; font-weight: 700; color: @variColor;">@(totalVari > 0 ? "+" : "")@totalVari.ToString("N2") ha</div>
        </div>
    }
    <div class="summary-item">
        <div style="font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Cant. Lotes</div>
        <div style="font-size: 18px; font-weight: 700; color: #fff;">@_total</div>
    </div>
</div>

<div class="glass-card">
    <RemoteTable @ref="_table"
                 TItem="LotListItemDto"
                 Load="LoadLots"
                 OnLoaded="OnLotsLoaded"
                 FixedFilters="@FixedFilters"
                 SortKeys="@SortKeys"
                 StateKey="lots"
                 SearchPlaceholder="Buscar lote o campo..."
                 ItemLabel="lotes"
                 RowKey="l => l.Id.ToString()"
                 ScrollX="1200">
        <Filters>
            <SelectFilter Param="fieldId" Placeholder="Campo" SearchOptions="SearchFields" Style="width: 200px;" />
            <SelectFilter Param="status" Placeholder="Estado" Options="@StatusOptions" Style="width: 140px;" />
        </Filters>
        <ExtraOptions>
            @if (CampaignState.IsSelected)
            {
                <Checkbox Checked="@_onlyCampaign" CheckedChanged="v => _onlyCampaign = v"
                          Style="color: rgba(255,255,255,0.7); font-size: 12px;">Ver solo mis lotes</Checkbox>
            }
        </ExtraOptions>
        <ExpandTemplate Context="lot">
            <div style="padding: 16px; background: rgba(0,0,0,0.2); border-radius: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center  ; margin-bottom: 12px;">
                    <h4 style="color: #fff; margin: 0;">Historial de Superficies por Campaña</h4>
                </div>
                @if (EnsureHistory(lot.Data.Id) is { } history)
                {
                    <Table TItem="SurfaceHistoryDto" DataSource="history" Size="TableSize.Small" PageSize="10" HidePagination>
                        <PropertyColumn Property="h => h.CampaignName" Title="Campaña" />
                        <PropertyColumn Property="h => h.StartDate" Title="Inicio" />
                        <PropertyColumn Property="h => h.ProductiveArea" Title="Sup. Productiva" />
                        <PropertyColumn Property="h => h.Variation" Title="Variación">
                            @{
                                var colorv = context.Variation < 0 ? "#E74C3C" : (context.Variation > 0 ? "#2ECC71" : "rgba(255,255,255,0.3)");
                                <span style="color: @colorv; font-weight: 600;">@(context.Variation > 0 ? "+" : "")@context.Variation.ToString("N2") ha</span>
                            }
                        </PropertyColumn>
                        <ActionColumn Title="Acciones" Width="100">
                            <Button Size="@ButtonSize.Small" OnClick="() => GoToRotations(context.CampaignId, context.LotId, true)"
                                    Style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px;">
                                <Icon Type="sync" /> Rotac.
                            </Button>
                        </ActionColumn>
                    </Table>
                }
                else
                {
                    <div style="text-align: center; padding: 10px; color: rgba(255,255,255,0.4);">
                        Cargando historial...
                    </div>
                }
            </div>
        </ExpandTemplate>
        <ChildContent>
            <PropertyColumn Property="c => c.Name" Title="Nombre" Sortable>
                <span style="font-weight: 600;">@context.Name</span>
            </PropertyColumn>
            <PropertyColumn Property="c => c.FieldName" Title="Campo" Sortable />
            <PropertyColumn Property="c => c.Status" Title="Estado">
                <Tag Color="@(context.Status == "Active" ? AntDesign.TagColor.Green : AntDesign.TagColor.Red)" Style="border-radius: 12px; font-size: 11px; padding: 2px 10px;">
                    @(context.Status == "Active" ? "Activo" : "Inactivo")
                </Tag>
            </PropertyColumn>
            <PropertyColumn Property="c => c.CadastralArea" Title="Hectáreas" Sortable>
                <span style="font-weight: 600;">@context.CadastralArea.ToString("N2") ha</span>
            </PropertyColumn>
            <ActionColumn Title="Geometría">
                @if (context.HasGeometry)
                {
                    <a href="@($"/mapa?lotId={context.Id}")" style="border-radius: 12px; font-size: 11px; padding: 2px 10px; cursor: pointer; background: #1890FF20; color: #1890FF; border: 1px solid #1890FF40; text-decoration: none; display: inline-block;">
                        Editar GIS
                    </a>
                }
                else
                {
                    <a href="@($"/mapa?lotId={context.Id}")" class="ant-tag ant-tag-red" style="border-radius: 12px; font-size: 11px; padding: 2px 10px; cursor: pointer;">
                        Sin geometría (Configurar)
                    </a>
                }
            </ActionColumn>
            <ActionColumn Title="Acciones" Width="160">
                <Space>
                    <SpaceItem>
                        <Button Size="@ButtonSize.Small" OnClick="() => OpenEditModal(context)"
                                Style="border-radius: 6px; border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7);">
                            <Icon Type="edit" Theme="IconThemeType.Outline" />
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="¿Eliminar este lote? Se eliminarán las OTs asociadas."
                                    OnConfirm="() => DeleteLot(context.Id)"
                                    OkText="Eliminar" CancelText="Cancelar">
                            <Button Danger Size="@ButtonSize.Small" Style="border-radius: 6px;">
                                <Icon Type="delete" Theme="IconThemeType.Outline" />
                            </Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </ChildContent>
    </RemoteTable>
</div>

<Modal Title="@(_isEditing ? "Editar Lote" : "Nuevo Lote")"
       Visible="_modalVisible"
       OnCancel="CloseModal"
       Footer="null"
       Width="520"
       BodyStyle="background: #1E1E2E; padding: 24px; color: #fff;">
    <div style="font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 24px;">@(_isEditing ? "Editar Lote" : "Nuevo Lote")</div>

    <div style="display: grid; gap: 20px;">
        <div>
            <label style="display: block; color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 8px;">Nombre de Lote</label>
            <Input @bind-Value="_formModel.Name" Placeholder="Nombre" 
                   Style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; height: 42px; color: #fff;" />
        </div>

        <div>
            <label style="display: block; color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 8px;">Campo</label>
            <Select TItem="FieldListItemDto" TItemValue="Guid" DataSource="_availableFields" @bind-Value="_formModel.FieldId"
                    LabelName="@nameof(FieldListItemDto.Name)" ValueName="@nameof(FieldListItemDto.Id)" Placeholder="Campo"
                    Style="width: 100%;" EnableSearch />
        </div>

        @if (_isEditing)
        {
            <div>
                <div style="font-weight: 700; color: #fff; margin-bottom: 12px; font-size: 14px;">Campañas Asignadas</div>
                <div style="display: grid; gap: 8px;">
                    <div style="display: grid; grid-template-columns: 1fr 65px 60px 28px 60px 28px; gap: 8px; font-size: 10px; color: rgba(255,255,255,0.4); text-transform: uppercase; padding: 0 4px;">
                        <span>Campaña</span>
                        <span>Ha</span>
                        <span>Var.</span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    @foreach (var c in _lotCampaigns)
                    {
                        var isLocked = IsCampaignLocked(c.CampaignId);
                        var variation = _editingAreas.GetValueOrDefault(c.Id, c.ProductiveArea) - c.CadastralArea;
                        var variationColor = variation > 0 ? "#2ECC71" : (variation < 0 ? "#E74C3C" : "rgba(255,255,255,0.3)");
                        var variationText = variation > 0 ? $"+{variation:N2}" : variation.ToString("N2");
                        var areaWarning = _editingAreas.GetValueOrDefault(c.Id, c.ProductiveArea) > c.CadastralArea && c.CadastralArea > 0;

                        <div class="@(areaWarning ? "campaign-lot-warning" : "")" style="display: grid; grid-template-columns: 1fr 65px 60px 28px 60px 28px; gap: 6px; align-items: center; @(areaWarning ? "background: rgba(243, 156, 18, 0.06); border: 1px solid rgba(243, 156, 18, 0.2); border-radius: 10px; padding: 4px 6px;" : "")">
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px 10px; color: #fff; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @c.CampaignName
                                @if (isLocked)
                                {
                                    <span style="font-size: 10px; color: #95A5A6; margin-left: 4px;">(Bloq.)</span>
                                }
                            </div>
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 2px; display: flex; align-items: center;">
                                @if (_editingAreas.ContainsKey(c.Id))
                                {
                                    <AntDesign.InputNumber TValue="decimal" Value="@_editingAreas[c.Id]" ValueChanged="@((decimal v) => _editingAreas[c.Id] = v)" Min="0m" Step="0.01m"
                                                           Style="width: 100%; background: transparent; color: #2ECC71; font-weight: 700; text-align: center; border: none; outline: none; font-size: 12px;" />
                                }
                            </div>
                            <span style="font-size: 11px; font-weight: 600; color: @variationColor; text-align: center;">@variationText</span>
                            <Button Size="@ButtonSize.Small" Icon="check"
                                    Type="@ButtonType.Link"
                                    OnClick="() => SaveCampaignLotArea(c)"
                                    Style="color: #2ECC71; padding: 0; min-width: 28px; height: 28px;" />
                            <Button Size="@ButtonSize.Small" OnClick="() => GoToRotations(c.CampaignId, c.LotId, false)"
                                    Style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; height: 36px; font-size: 11px; font-weight: 600;">
                                Rotac.
                            </Button>
                            @if (!isLocked)
                            {
                                <Popconfirm Title="¿Quitar esta campaña del lote?"
                                            OnConfirm="() => RemoveLotFromCampaign(c.CampaignId, c.LotId)"
                                            OkText="Quitar" CancelText="Cancelar">
                                    <Button Size="@ButtonSize.Small" Danger
                                            Style="border-radius: 6px; min-width: 28px; height: 28px; font-size: 12px;">
                                        <Icon Type="close" Theme="IconThemeType.Outline" />
                                    </Button>
                                </Popconfirm>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }

                    <Button OnClick="() => _addCampaignModalVisible = true"
                            Style="background: transparent; border: 1px dashed rgba(255,255,255,0.2); border-radius: 10px; color: rgba(255,255,255,0.6); height: 40px; margin-top: 4px; font-size: 13px;">
                        +Campaña
                    </Button>
                </div>
            </div>
        }

        <div>
            <label style="display: block; color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 8px;">Hectáreas</label>
            <AntDesign.InputNumber TValue="decimal" @bind-Value="_formModel.CadastralArea" Min="0m" Step="0.01m"
                                   Style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 12px; height: 42px; color: #fff; width: 100%; font-size: 14px;" />
        </div>

        <div style="margin-top: 10px;">
            <label style="display: block; color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 8px;">
                Centro de costo (ERP)
            </label>
            <Select TItemValue="long?" TItem="ErpAccountDto" @bind-Value="_formModel.CodCentro"
                    Placeholder="@(_centros.Count == 0 ? "Sin centros cargados desde el ERP" : "Buscar centro...")"
                    AllowClear EnableSearch Loading="_loadingCentros"
                    DataSource="@_centros"
                    ItemLabel="x => x.DisplayName" ItemValue="x => (long?)x.CodCuenta"
                    Style="width: 100%;" />
            <div style="color: rgba(255,255,255,0.4); font-size: 11px; margin-top: 4px;">
                A esta cuenta imputan los pases G4 de las labores de este lote. Sin centro, la
                imputación cae en la que traiga la regla contable del tipo de labor.
            </div>
        </div>

        <div style="margin-top: 10px;">
            <RadioGroup @bind-Value="_formModel.Status">
                <Radio Value="@("Active")" Style="color: #fff;">Activo</Radio>
                <Radio Value="@("Inactive")" Style="color: #fff;">Inactivo</Radio>
            </RadioGroup>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; padding-top: 30px;">
        <Button OnClick="SaveLot" Loading="_saving" 
                Style="background: #1890FF; color: #fff; border: none; border-radius: 20px; padding: 0 24px; font-weight: 700; height: 40px;">
            Guardar
        </Button>
        <Button OnClick="CloseModal"
                Style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 0 24px; font-weight: 600; height: 40px;">
            Cancelar
        </Button>
    </div>
</Modal>

<Modal Title="Asignar a Campaña" Visible="_addCampaignModalVisible" OnCancel="() => _addCampaignModalVisible = false" OnOk="AddLotToLotCampaign" Width="400">
    <div style="display: grid; gap: 16px; padding: 10px 0;">
        <div>
            <label style="display: block; color: rgba(255,255,255,0.5); font-size: 11px; text-transform: uppercase; margin-bottom: 8px;">Seleccionar Campaña</label>
            <Select TItem="CampaignSummaryDto" TItemValue="Guid" DataSource="FilteredAvailableCampaigns" @bind-Value="_selectedCampaignId"
                    LabelName="@nameof(CampaignSummaryDto.Name)" ValueName="@nameof(CampaignSummaryDto.Id)"
                    OnSelectedItemChanged="OnAddCampaignChanged"
                    Placeholder="Campaña" Style="width: 100%;" />
            @if (!FilteredAvailableCampaigns.Any())
            {
                <div style="color: rgba(255,255,255,0.4); font-size: 11px; margin-top: 4px;">No hay campañas disponibles para asignar.</div>
            }
        </div>
        <div>
            <label style="display: block; margin-bottom: 8px; font-size: 12px; color: rgba(255,255,255,0.5);">Superficie Productiva (ha)</label>
            <AntDesign.InputNumber TValue="decimal" @bind-Value="_newCampaignProductiveArea" Min="0m" Step="0.01m"
                                   Style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; color: #fff; font-size: 14px; height: 32px;" />
        </div>
    </div>
</Modal>

<Drawer Title="@($"Rotaciones del Lote: {_selectedLotForRotation?.Name}")"
        Visible="_rotationsDrawerVisible"
        OnClose="() => _rotationsDrawerVisible = false"
        Width='800'
        ZIndex="2000"
        BodyStyle="background: #0f0f1a; padding: 24px;">
    @if (_loadingRotations)
    {
        <div style="text-align: center; padding: 40px;">
            <Spin Tip="Cargando rotaciones..." />
        </div>
    }
    else
    {
        <div class="rotations-timeline-wrapper" style="margin-top: 10px;">
            <Timeline Mode="TimelineMode.Alternate">
                @foreach (var rot in _rotations.OrderByDescending(r => r.StartDate))
                {
                    <TimelineItem Color="@(rot.EndDate >= DateOnly.FromDateTime(DateTime.Today) ? "green" : "gray")">
                        <div style="background: rgba(255,255,255,0.03); padding: 16px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08);">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                <div>
                                    <h4 style="color: #fff; margin: 0; font-size: 16px;">@rot.ActivityName</h4>
                                    <span style="font-size: 12px; color: rgba(255,255,255,0.4);">@rot.CampaignName</span>
                                </div>
                                @if (!_isRotationReadOnly)
                                {
                                    <Popconfirm Title="¿Eliminar esta rotación?" OnConfirm="() => DeleteRotation(rot.Id)">
                                        <Button Danger Icon="delete" Size="@ButtonSize.Small" Ghost Type="@ButtonType.Text" />
                                    </Popconfirm>
                                }
                            </div>
                            
                            <div style="display: flex; gap: 16px; margin-top: 8px;">
                                <div>
                                    <div style="font-size: 10px; color: rgba(255,255,255,0.3); text-transform: uppercase;">Período</div>
                                    <div style="color: rgba(255,255,255,0.8); font-size: 13px;">
                                        @rot.StartDate.ToString("MMM yyyy") - @rot.EndDate.ToString("MMM yyyy")
                                    </div>
                                </div>
                                <div style="flex: 1;">
                                    @{
                                        var totalDays = (rot.EndDate.ToDateTime(TimeOnly.MinValue) - rot.StartDate.ToDateTime(TimeOnly.MinValue)).TotalDays;
                                        var elapsed = (DateTime.Today - rot.StartDate.ToDateTime(TimeOnly.MinValue)).TotalDays;
                                        var percent = totalDays > 0 ? Math.Clamp((elapsed / totalDays) * 100, 0, 100) : 0.0;
                                        var strokeColor = "#2ECC71";
                                    }
                                    <div style="font-size: 10px; color: rgba(255,255,255,0.3); text-transform: uppercase; margin-bottom: 4px;">Progreso Ciclo</div>
                                    <Progress Percent="@percent" Size="ProgressSize.Small" Status="@ProgressStatus.Active" StrokeColor="@strokeColor" />
                                </div>
                            </div>
                        </div>
                    </TimelineItem>
                }
                @if (!_rotations.Any())
                {
                    <TimelineItem Color="@("gray")">
                        <div style="color: rgba(255,255,255,0.3); padding: 20px; text-align: center;">
                            No hay rotaciones registradas para este lote en esta campaña.
                        </div>
                    </TimelineItem>
                }
            </Timeline>
            
            @if (!_isRotationReadOnly)
            {
                <div style="margin-top: 32px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 24px;">
                    <h4 style="color: #fff; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                        <Icon Type="plus-circle" /> Agregar Cultivo a la Rotación
                    </h4>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                        <div>
                            <label style="color: rgba(255,255,255,0.4); font-size: 11px; display: block; margin-bottom: 8px;">ACTIVIDAD / CULTIVO (ERP)</label>
                            <Select TItem="ErpActivityDto" TItemValue="Guid" DataSource="_allActivities"
                                    LabelName="@nameof(ErpActivityDto.Name)" ValueName="@nameof(ErpActivityDto.Id)"
                                    @bind-Value="_newRotationActivityId" EnableSearch Placeholder="Seleccionar..." 
                                    Style="width: 100%;" />
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <div>
                                <label style="color: rgba(255,255,255,0.4); font-size: 11px; display: block; margin-bottom: 8px;">INICIO</label>
                                <DatePicker TValue="DateTime?" @bind-Value="_newRotationStart" Format="MMM yyyy" Picker="@DatePickerType.Month" Style="width: 100%;" />
                            </div>
                            <div>
                                <label style="color: rgba(255,255,255,0.4); font-size: 11px; display: block; margin-bottom: 8px;">FIN</label>
                                <DatePicker TValue="DateTime?" @bind-Value="_newRotationEnd" Format="MMM yyyy" Picker="@DatePickerType.Month" Style="width: 100%;" />
                            </div>
                        </div>
                    </div>
                    <Button Type="@ButtonType.Primary" Block OnClick="AddRotation" Loading="_savingRotation" 
                            Style="background: #E74C3C; border-color: #E74C3C; height: 40px; font-weight: 600; border-radius: 8px;">
                        Registrar Rotación
                    </Button>
                </div>
            }
        </div>
    }
</Drawer>

<GestorOT.Client.Components.LotImportModal 
    @bind-Visible="_importModalVisible"
    CampaignId="@(CampaignState.CurrentCampaign?.Id ?? Guid.Empty)"
    CampaignName="@(CampaignState.CurrentCampaign?.Name ?? string.Empty)"
    OnImportCompleted="HandleImportCompleted" />

@code {
    private RemoteTable<LotListItemDto>? _table;

    // "Ver solo mis lotes": se manda como filtro fijo, así la tabla vuelve a la página 1 sola al tildarlo.
    private bool _onlyCampaign = true;

    private IReadOnlyDictionary<string, string?> FixedFilters => new Dictionary<string, string?>
    {
        ["campaignId"] = _onlyCampaign && CampaignState.IsSelected ? CampaignState.CurrentCampaign?.Id.ToString() : null,
    };
    private int _total;
    private decimal _totalCadastralArea;
    // Lote abierto en el modal, completo (con geometría): la búsqueda no la trae y al guardar hay que reenviarla.
    private LotDto? _editingLot;
    private List<FieldListItemDto> _availableFields = new();
    private List<CampaignLotDto> _campaignLots = new();
    private List<ErpAccountDto> _centros = new();
    private bool _loadingCentros;
    private Dictionary<Guid, List<SurfaceHistoryDto>> _historyByLot = new();
    private readonly HashSet<Guid> _historyLoading = new();
    private string? _errorMessage;
    private bool _modalVisible;
    private bool _importModalVisible;
    private bool _isEditing;
    private bool _saving;
    private Guid _editingId;
    private LotFormModel _formModel = new();
    // private Form<LotFormModel>? _form; // Unused
    private List<CampaignLotDto> _lotCampaigns = new();
