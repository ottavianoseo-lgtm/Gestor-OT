    private async Task ReloadTableAsync()
    {
        if (_table != null)
            await _table.ReloadAsync();
    }

    // Fila de la página actual, o el lote abierto en el modal.
    private LotListItemDto? FindLot(Guid lotId) =>
        _table?.Items.FirstOrDefault(l => l.Id == lotId)
        ?? (_editingLot is { } e && e.Id == lotId
            ? new LotListItemDto(e.Id, e.FieldId, e.Name, e.Status, e.FieldName, e.CadastralArea, e.CodCentro, !string.IsNullOrEmpty(e.WktGeometry))
            : null);

    private IEnumerable<CampaignSummaryDto> FilteredAvailableCampaigns =>
        _allCampaigns.Where(c => !_lotCampaigns.Any(lc => lc.CampaignId == c.Id));

    private bool IsCampaignLocked(Guid campaignId) =>
        _allCampaigns.FirstOrDefault(c => c.Id == campaignId)?.Status == CampaignStatus.Locked;

    public class LotFormModel
    {
        public string Name { get; set; } = string.Empty;
        public Guid FieldId { get; set; }
        public string Status { get; set; } = "Active";
        public decimal CadastralArea { get; set; }
        public long? CodCentro { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && highlight.HasValue)
        {
            await Task.Delay(500); // Wait for table render
            // Re-evaluating: How to expand programmatically?
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CampaignState.OnChange += OnCampaignChanged;
        TenantState.OnChange += OnCampaignChanged;
        await LoadData();
        await LoadCentros();
    }

    /// <summary>
    /// Cuentas del plan de centros del ERP. Se reusa el endpoint que ya alimentaba la
    /// configuración contable de los pases, así el catálogo es exactamente el mismo.
    /// </summary>
    private async Task LoadCentros()
    {
        _loadingCentros = true;
        try
        {
            _centros = await Http.GetFromJsonAsync<List<ErpAccountDto>>("api/pases/erp/cuentas/centro") ?? new();
        }
        catch
        {
            Message.Warning("No se pudieron cargar los centros del ERP.");
        }
        finally
        {
            _loadingCentros = false;
            StateHasChanged();
        }
    }

    private void OnCampaignChanged()
    {
        if (_saving) return;
        InvokeAsync(async () => { await LoadData(); await ReloadTableAsync(); StateHasChanged(); });
    }

    public void Dispose()
    {
        CampaignState.OnChange -= OnCampaignChanged;
        TenantState.OnChange -= OnCampaignChanged;
    }

    /// <summary>
    /// Historial ya cargado del lote, o null mientras se carga. La primera vez que se expande la
    /// fila dispara la carga (la tabla estándar no expone el evento de expandir).
    /// </summary>
    private List<SurfaceHistoryDto>? EnsureHistory(Guid lotId)
    {
        if (_historyByLot.TryGetValue(lotId, out var history))
            return history;
        if (_historyLoading.Add(lotId))
        {
            _ = InvokeAsync(async () =>
            {
                await LoadHistory(lotId);
                _historyLoading.Remove(lotId);
                StateHasChanged();
            });
        }
        return null;
    }

    private async Task LoadHistory(Guid lotId)
    {
        try
        {
            var history = await Http.GetFromJsonAsync<List<SurfaceHistoryDto>>($"api/lots/{lotId}/surface-history");
            _historyByLot[lotId] = history ?? new();
        }
        catch (Exception)
        {
            // Vacío para no reintentar en cada render de la fila expandida.
            _historyByLot[lotId] = new();
            Message.Error("Error al cargar historial.");
        }
    }

    private async Task LoadData()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var fieldsTask = LoadAllFields(cts.Token);
            var campTask = Http.GetFromJsonAsync("api/campaigns/active",
                AppJsonSerializerContext.Default.ListCampaignSummaryDto, cts.Token);

            _availableFields = await fieldsTask;
            // Total de ha de todos los lotes: sale de la suma por campo, sin bajar los lotes.
            _totalCadastralArea = _availableFields.Sum(f => f.CadastralArea);
            _allCampaigns = await campTask ?? new();
            
            _allActivities = await Http.GetFromJsonAsync<List<ErpActivityDto>>("api/catalogs/activities") ?? new();

            if (CampaignState.IsSelected)
            {
                var campaignLots = await Http.GetFromJsonAsync($"api/campaigns/{CampaignState.CurrentCampaign!.Id}/lots",
                    AppJsonSerializerContext.Default.ListCampaignLotDto, cts.Token);
                _campaignLots = campaignLots ?? new();
            }
            else
            {
                _campaignLots.Clear();
            }

            _errorMessage = null;
        }
        catch (Exception)
        {
            _errorMessage = $"Error al cargar datos.";
        }
        finally
        {
            StateHasChanged();

            if (highlight.HasValue)
            {
                await LoadHistory(highlight.Value);
                StateHasChanged();
            }

            if (!editId.HasValue)
            {
                try
                {
                    var gisId = await Js.InvokeAsync<string>("eval", "window._gisEditLotId || ''");
                    if (Guid.TryParse(gisId, out var gisGuid))
                    {
                        editId = gisGuid;
                        await Js.InvokeVoidAsync("eval", "delete window._gisEditLotId");
                    }
                }
                catch { }
            }

            if (editId.HasValue)
            {
                var id = editId.Value;
                editId = null;
                await OpenEditModal(id);
                StateHasChanged();
            }
        }
    }

    /// <summary>Todos los campos (para el selector del modal y el total de ha), de a 100.</summary>
    private async Task<List<FieldListItemDto>> LoadAllFields(CancellationToken ct)
    {
        var fields = new List<FieldListItemDto>();
        for (var page = 1; ; page++)
        {
            var result = await Http.GetFromJsonAsync<PagedResult<FieldListItemDto>>(
                $"api/fields/search?page={page}&pageSize=100&sortBy=name&sortDir=asc", ct);
            if (result == null) break;
            fields.AddRange(result.Items);
            if (result.Items.Count == 0 || fields.Count >= result.Total) break;
        }
        return fields;
    }

    private void OpenCreateModal()
    {
        _isEditing = false;
        _formModel = new LotFormModel();
        if (_availableFields.Count > 0)
            _formModel.FieldId = _availableFields[0].Id;
        _modalVisible = true;
    }

    private Task OpenEditModal(LotListItemDto lot) => OpenEditModal(lot.Id);

    private async Task OpenEditModal(Guid lotId)
    {
        LotDto? lot;
        try
        {
            lot = await Http.GetFromJsonAsync($"api/lots/{lotId}", AppJsonSerializerContext.Default.LotDto);
        }
        catch (Exception ex)
        {
            Message.Error($"No se pudo cargar el lote: {ex.Message}");
            return;
        }
        if (lot == null) return;

        _editingLot = lot;
        _isEditing = true;
        _editingId = lot.Id;
        _formModel = new LotFormModel
        {
            Name = lot.Name,
            FieldId = lot.FieldId,
            Status = lot.Status,
            CadastralArea = lot.CadastralArea,
            CodCentro = lot.CodCentro
        };
        
        await LoadLotCampaigns(lot.Id);
        
        _modalVisible = true;
        StateHasChanged();
    }

    private async Task LoadLotCampaigns(Guid lotId)
    {
        try
        {
            _lotCampaigns = await Http.GetFromJsonAsync<List<CampaignLotDto>>($"api/lots/{lotId}/campaigns") ?? new();
            _editingAreas = _lotCampaigns.ToDictionary(c => c.Id, c => Math.Round(c.ProductiveArea, 2));
        }
        catch (Exception)
        {
            Message.Error("Error al cargar campañas del lote.");
        }
    }

