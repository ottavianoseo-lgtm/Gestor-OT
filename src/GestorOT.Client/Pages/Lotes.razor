        _modalVisible = false;
    }

    private async Task SaveLot()
    {
        if (string.IsNullOrWhiteSpace(_formModel.Name))
        {
            Message.Warning("El nombre del lote es obligatorio.");
            return;
        }
        if (_formModel.FieldId == Guid.Empty)
        {
            Message.Warning("Debe seleccionar un campo.");
            return;
        }

        // Sin el lote completo se perdería la geometría al guardar.
        if (_isEditing && _editingLot?.Id != _editingId)
        {
            Message.Error("No se pudo cargar el lote. Cerrá y volvé a abrirlo.");
            return;
        }

        _saving = true;
        try
        {
            var existingWkt = _isEditing ? _editingLot!.WktGeometry : null;

            var formSnapshot = new LotFormModel
            {
                Name = _formModel.Name,
                FieldId = _formModel.FieldId,
                Status = _formModel.Status,
                CadastralArea = _formModel.CadastralArea,
                CodCentro = _formModel.CodCentro
            };

            var dto = new LotDto(
                _isEditing ? _editingId : Guid.Empty,
                formSnapshot.FieldId,
                formSnapshot.Name,
                formSnapshot.Status,
                existingWkt,
                null,
                0,
                formSnapshot.CadastralArea,
                formSnapshot.CodCentro
            );

            HttpResponseMessage response;
            if (_isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/lots/{_editingId}",
                    dto, AppJsonSerializerContext.Default.LotDto);
            }
            else
            {
                var postUrl = CampaignState.CurrentCampaign != null && CampaignState.CurrentCampaign.Id != Guid.Empty
                    ? $"api/lots?campaignId={CampaignState.CurrentCampaign.Id}"
                    : "api/lots";
                response = await Http.PostAsJsonAsync(postUrl,
                    dto, AppJsonSerializerContext.Default.LotDto);
            }

            if (response.IsSuccessStatusCode)
            {
                if (!_isEditing && CampaignState.IsSelected)
                {
                    var createdLot = await response.Content.ReadFromJsonAsync<LotDto>(AppJsonSerializerContext.Default.LotDto);
                    if (createdLot != null)
                    {
                        var lotAddResp = await Http.PostAsJsonAsync($"api/campaigns/{CampaignState.CurrentCampaign!.Id}/lots",
                            new CampaignLotDto(Guid.Empty, CampaignState.CurrentCampaign.Id, createdLot.Id, createdLot.FieldId, null, null, 0, 0, null),
                            AppJsonSerializerContext.Default.CampaignLotDto);
                        
                        if (!lotAddResp.IsSuccessStatusCode)
                        {
                            var lotAddErr = await lotAddResp.Content.ReadAsStringAsync();
                            Message.Warning($"El lote se creó pero no pudo asignarse a la campaña: {lotAddErr}");
                        }
                    }
                }

                if (_isEditing && _editingAreas.Count != 0)
                {
                    foreach (var c in _lotCampaigns)
                    {
                        if (!_editingAreas.TryGetValue(c.Id, out var newArea)) continue;
                        if (newArea == c.ProductiveArea) continue;

                        if (IsCampaignLocked(c.CampaignId)) continue;

                        var updated = c with { ProductiveArea = newArea };
                        var areaResp = await Http.PutAsJsonAsync(
                            $"api/campaigns/{c.CampaignId}/lots/{c.LotId}", updated);

                        if (!areaResp.IsSuccessStatusCode)
                        {
                            var err = await areaResp.Content.ReadAsStringAsync();
                            Message.Warning($"Lote guardado pero error al actualizar Ha de {c.CampaignName}: {err}");
                        }
                    }
                }

                Message.Success(_isEditing ? "Lote actualizado." : "Lote creado correctamente.");
                _modalVisible = false;
                if (_isEditing)
                {
                    _historyByLot.Remove(_editingId);
                }
                await LoadData();
                await ReloadTableAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al guardar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al guardar el lote: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteLot(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/lots/{id}");
            if (response.IsSuccessStatusCode)
            {
                Message.Success("Lote eliminado correctamente.");
                await LoadData();
                await ReloadTableAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Message.Error($"Error al eliminar: {body}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al eliminar el lote: {ex.Message}");
        }
    }

