@code {
    [SupplyParameterFromQuery] public Guid? targetOT { get; set; }
    
    private LaborList? _laborList;
    private List<WorkOrderDto> _workOrders = new();
    private List<FilterOption> _laborTypeOptions = new();
    private string? _errorMessage;
    private bool _saving;
    private List<LaborDto> _selectedLabors = new();
    private HashSet<Guid> _selectedIds => _selectedLabors.Select(l => l.Id).ToHashSet();
    private int _kpiTotal, _kpiPlanned, _kpiRealized;

    private bool _quickLaborSelectorVisible;
    private bool _importModalVisible;
    private bool _strategyWizardVisible;
    private bool _drawerVisible;
    private Guid _editingLaborId = Guid.Empty;
    private bool _isExecuting;
    private bool _assignModalOpen;
    private Guid _assignTargetOT;
    private bool _executeModalOpen;
    private bool _executing;
    private LaborDto? _laborToExecute;
    private LaborEditorForm? _laborFormRef;
    private bool _bulkValidationModalOpen;
    private string? _bulkValidationLink;
    private int _bulkValidationLaborCount;

    private static readonly List<FilterOption> StatusOptions = new()
    {
        new("Planned", "Planeadas"),
        new("Realized", "Realizadas"),
        new("AwaitingValidation", "En validación"),
        new("Validated", "Validadas"),
        new("Pending", "Pendientes"),
    };

    // Una labor que ya está en una OT se gestiona desde la OT: acá solo van las sueltas de la campaña.
    // En modo asignación (targetOT) se limita al campo de esa OT.
    private IReadOnlyDictionary<string, string?> FixedFilters
    {
        get
        {
            var filters = new Dictionary<string, string?>
            {
                ["assigned"] = "false",
                ["campaignId"] = CampaignState.CurrentCampaign?.Id.ToString(),
            };
            var targetFieldId = TargetWorkOrder?.FieldId;
            if (targetFieldId.HasValue)
                filters["fieldId"] = targetFieldId.ToString();
            return filters;
        }
    }

    private WorkOrderDto? TargetWorkOrder =>
        targetOT.HasValue && targetOT != Guid.Empty ? _workOrders.FirstOrDefault(w => w.Id == targetOT) : null;

    private Task<PagedResult<LaborDto>?> LoadLabors(string query, CancellationToken ct) =>
        Http.GetFromJsonAsync($"api/labors/search?{query}", AppJsonSerializerContext.Default.PagedResultLaborDto, ct);

    private async Task<IEnumerable<FilterOption>> SearchContacts(string? text)
    {
        var page = await Http.GetFromJsonAsync<PagedResult<ContactDto>>(
            $"api/catalogs/contacts/search?page=1&pageSize=20&search={Uri.EscapeDataString(text ?? "")}");
        return page?.Items.Select(c => new FilterOption(c.Id.ToString(), c.FullName)) ?? Enumerable.Empty<FilterOption>();
    }

    private async Task<IEnumerable<FilterOption>> SearchFields(string? text)
    {
        var page = await Http.GetFromJsonAsync<PagedResult<FieldListItemDto>>(
            $"api/fields/search?page=1&pageSize=20&search={Uri.EscapeDataString(text ?? "")}");
        return page?.Items.Select(f => new FilterOption(f.Id.ToString(), f.Name)) ?? Enumerable.Empty<FilterOption>();
    }

    // Con un campo elegido alcanza con el nombre del lote; sin campo se aclara de cuál es,
    // porque hay lotes que se llaman igual en distintos campos.
    private async Task<IEnumerable<FilterOption>> SearchLots(string? text)
    {
        var campaign = CampaignState.CurrentCampaign;
        if (campaign == null) return Enumerable.Empty<FilterOption>();

        var fieldId = _laborList?.GetFilter("fieldId");
        var page = await Http.GetFromJsonAsync<PagedResult<CampaignLotDto>>(
            $"api/campaigns/{campaign.Id}/lots/search?page=1&pageSize=20&search={Uri.EscapeDataString(text ?? "")}"
            + (fieldId is null ? "" : $"&fieldId={fieldId}"));
        return page?.Items.Select(l => new FilterOption(l.LotId.ToString(), fieldId is null ? $"{l.LotName} · {l.FieldName}" : l.LotName ?? ""))
            ?? Enumerable.Empty<FilterOption>();
    }

    private string KpiBorder(string? status, string activeColor) =>
        _laborList?.GetFilter("status") == status ? activeColor : "rgba(255,255,255,0.06)";

    private Task FilterByStatus(string? status) => _laborList?.SetFilterAsync("status", status) ?? Task.CompletedTask;

    private void OpenExecuteModal(LaborDto labor)
    {
        EditLabor(labor.Id, true);
    }

    /* ExecuteStandalone removed in favor of full LaborEditorForm */

    protected override async Task OnInitializedAsync()
    {
        CampaignState.OnChange += OnCampaignChanged;
        TenantState.OnChange += OnCampaignChanged;
        // La tabla carga su primera página sola; acá van los datos de alrededor.
        await LoadData(reloadTable: false);
    }

    private void OnCampaignChanged()
    {
        // Al cambiar la campaña cambian los FixedFilters y la tabla se recarga sola.
        InvokeAsync(async () => { await LoadData(reloadTable: false); StateHasChanged(); });
    }

    public void Dispose()
    {
        CampaignState.OnChange -= OnCampaignChanged;
        TenantState.OnChange -= OnCampaignChanged;
    }

    private async Task LoadData(bool reloadTable = true)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

            var woTask = Http.GetFromJsonAsync("api/workorders",
                AppJsonSerializerContext.Default.ListWorkOrderDto, cts.Token);
            var typesTask = Http.GetFromJsonAsync("api/catalogs/labor-types",
                AppJsonSerializerContext.Default.ListLaborTypeDto, cts.Token);
            await Task.WhenAll(woTask, typesTask);

            _workOrders = await woTask ?? new();
            _laborTypeOptions = (await typesTask ?? new()).Select(t => new FilterOption(t.Id.ToString(), t.Name)).ToList();

            // Los totales dependen de la OT destino (filtra por su campo), por eso van después.
            await LoadKpis(cts.Token);
            _errorMessage = null;

            if (TargetWorkOrder != null)
                _assignTargetOT = TargetWorkOrder.Id;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }

        _selectedLabors.Clear();
        if (reloadTable && _laborList != null)
            await _laborList.ReloadAsync();
        StateHasChanged();
    }

    // Totales de las tarjetas: con pageSize=1 alcanza, solo interesa el total de cada estado.
    private async Task LoadKpis(CancellationToken ct)
    {
        var baseQuery = string.Join('&', FixedFilters.Where(f => f.Value != null).Select(f => $"{f.Key}={f.Value}"));

        async Task<int> Count(string? status)
        {
            var url = $"api/labors/search?page=1&pageSize=1&{baseQuery}" + (status is null ? "" : $"&status={status}");
            var page = await Http.GetFromJsonAsync(url, AppJsonSerializerContext.Default.PagedResultLaborDto, ct);
            return page?.Total ?? 0;
        }

        var counts = await Task.WhenAll(Count(null), Count("Planned"), Count("Realized"));
        (_kpiTotal, _kpiPlanned, _kpiRealized) = (counts[0], counts[1], counts[2]);
    }

    private async Task UpdatePriority(LaborDto labor, LaborPriority newPriority)
    {
        var oldPriority = labor.Priority;
        labor.Priority = newPriority; // Optimistic update
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/labors/{labor.Id}/priority", new PriorityRequest { Priority = (int)newPriority });
            if (!response.IsSuccessStatusCode)
            {
                labor.Priority = oldPriority;
                Message.Error("No se pudo actualizar la prioridad.");
            }
        }
        catch
        {
            labor.Priority = oldPriority;
            Message.Error("Error de conexión al actualizar prioridad.");
        }
    }

    private void OnSelectedRowsChanged(IEnumerable<LaborDto> selectedRows)
    {
        _selectedLabors = selectedRows.ToList();
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedLabors.Clear();
        StateHasChanged();
    }

    private async Task OpenQuickCreator()
    {
        _quickLaborSelectorVisible = false;
        _editingLaborId = Guid.Empty;
        _drawerVisible = true;
        if (_laborFormRef != null)
        {
            await _laborFormRef.Reset();
        }
    }

    private void OpenStrategyWizard()
    {
        _quickLaborSelectorVisible = false;
        _strategyWizardVisible = true;
    }

    private async Task EditLabor(Guid id, bool isExecuting = false)
    {
        _editingLaborId = id;
        _isExecuting = isExecuting;
        _drawerVisible = true;
        if (_laborFormRef != null)
        {
            await _laborFormRef.Reset();
        }
    }

    private async Task HandleCancelLaborModal()
    {
        if (_laborFormRef != null)
        {
            await _laborFormRef.HandleCancel();
        }
        else
        {
            _drawerVisible = false;
        }
    }

    private async Task OnLaborSaved()
    {
        _drawerVisible = false;
        await LoadData();
    }

    private void OpenAssignModal()
    {
        _assignTargetOT = Guid.Empty;
        _assignModalOpen = true;
    }

    private async Task AssignToExistingOT()
    {
        if (_assignTargetOT == Guid.Empty) return;
        try
        {
            _saving = true;
            var body = JsonSerializer.Serialize(new { LaborIds = _selectedIds.ToList(), WorkOrderId = _assignTargetOT });
            var content = new StringContent(body, Encoding.UTF8, "application/json");
            var request = new HttpRequestMessage(HttpMethod.Patch, "api/labors/assign-bulk") { Content = content };
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                Message.Success($"{_selectedIds.Count} labores asignadas correctamente.");
                _assignModalOpen = false;
                await LoadData();
            }
            else
            {
                Message.Error("Error al asignar labores.");
            }
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task CreateOTFromSelected()
    {
        try
        {
            _saving = true;
            var selectedLabors = _selectedLabors.ToList();
            
            if (CampaignState.CurrentCampaign == null)
            {
                Message.Error("No hay una campaña activa seleccionada.");
                return;
            }

            // Logic for common responsible
            var responsibles = selectedLabors.Select(l => l.AssignedTo).Where(r => !string.IsNullOrEmpty(r)).Distinct().ToList();
            var commonResponsible = responsibles.Count == 1 ? responsibles.First() : string.Empty;

            // Logic for common field
            var commonFieldId = selectedLabors.First().FieldId;

            var newOT = new WorkOrderDto
            {
                CampaignId = CampaignState.CurrentCampaign.Id,
                FieldId = commonFieldId,
                Description = $"OT generada - {selectedLabors.Count} labores ({DateTime.Today:dd/MM/yyyy})",
                Status = "Pending",
                AssignedTo = commonResponsible ?? string.Empty,
                DueDate = DateTime.Today.AddDays(7),
                PlannedDate = DateTime.Today,
                ExpirationDate = DateTime.Today.AddDays(14)
            };

            var otResponse = await Http.PostAsJsonAsync("api/workorders", newOT, AppJsonSerializerContext.Default.WorkOrderDto);
            if (!otResponse.IsSuccessStatusCode)
            {
                Message.Error("Error al crear la OT.");
                return;
            }

            var createdOT = await otResponse.Content.ReadFromJsonAsync(AppJsonSerializerContext.Default.WorkOrderDto);
            if (createdOT == null) return;

            var body = JsonSerializer.Serialize(new { LaborIds = _selectedIds.ToList(), WorkOrderId = createdOT.Id });
            var content = new StringContent(body, Encoding.UTF8, "application/json");
            var req = new HttpRequestMessage(HttpMethod.Patch, "api/labors/assign-bulk") { Content = content };
            var assignResponse = await Http.SendAsync(req);
            if (assignResponse.IsSuccessStatusCode)
            {
                Message.Success($"OT creada y {_selectedIds.Count} labores asignadas.");
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task SendToContratista()
    {
        if (_selectedIds.Count == 0) return;
        try
        {
            _saving = true;
            var body = JsonSerializer.Serialize(new BulkValidationRequest(_selectedIds.ToList()));
            var content = new StringContent(body, Encoding.UTF8, "application/json");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var response = await Http.PostAsync("api/labors/submit-bulk-validation", content, cts.Token);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JsonElement>(cancellationToken: cts.Token);
                _bulkValidationLink = result.GetProperty("url").GetString();
                _bulkValidationLaborCount = result.GetProperty("laborCount").GetInt32();
                _bulkValidationModalOpen = true;
                Message.Success($"Enlace generado para {_bulkValidationLaborCount} labores.");
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                Message.Error($"Error: {err}");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error: {ex.Message}");
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task CopyBulkValidationLink()
    {
        if (!string.IsNullOrEmpty(_bulkValidationLink))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _bulkValidationLink);
            Message.Success("Enlace copiado al portapapeles.");
        }
    }

    private async Task DeleteLabor(Guid id)
    {
        var response = await Http.DeleteAsync($"api/labors/{id}");
        if (response.IsSuccessStatusCode)
        {
            Message.Success("Labor eliminada.");
            await LoadData();
        }
        else
        {
            Message.Error("Error al eliminar.");
        }
    }

    private static string GetTypeBgColor(string laborType) => laborType switch
    {
        "Fertilizacion" => "#27AE60",
        "Pulverizacion" => "#2980B9",
        "Siembra" => "#8E44AD",
        "Cosecha" => "#D35400",
        "Monitoreo" => "#16A085",
        "Laboreo" => "#7F8C8D",
        _ => "#95A5A6"
    };

    private async Task OnSaved()
    {
        _drawerVisible = false;

        // Si la labor pertenece a una OT, consolidar los insumos de esa OT
        // para que Insumos Consolidados y Reportes reflejen los cambios inmediatamente
        var laborEditada = _laborList?.CurrentItems.FirstOrDefault(l => l.Id == _editingLaborId);
        if (laborEditada?.WorkOrderId != null)
        {
            await Http.PostAsync(
                $"api/workorders/{laborEditada.WorkOrderId}/consolidate-supplies", null);
        }

        await LoadData();
    }

