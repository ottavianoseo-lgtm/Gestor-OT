@using GestorOT.Shared.Dtos
@using GestorOT.Domain.Enums
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject GestorOT.Client.Services.CatalogCache CatalogCache

<Modal Title="@($"Configuración Contable G4 — {(string.IsNullOrEmpty(_model.Description) ? (_model.LaborTypeName ?? "General / Defecto") : _model.Description)}")"
       Visible="@Visible"
       OnCancel="HandleClose"
       OnOk="SaveConfiguration"
       OkText="@("Guardar Configuración")"
       ConfirmLoading="_saving"
       Width="760">

    <Form Model="_model" Layout="@FormLayout.Vertical">
        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Tipo de Labor">
                    <Select TItemValue="Guid?" TItem="LaborTypeDto" @bind-Value="_model.LaborTypeId"
                            Placeholder="General / Defecto (Sin tipo)"
                            AllowClear Loading="@_loadingBasicCatalogs"
                            DataSource="@_laborTypes"
                            ItemLabel="x => x.Name"
                            ItemValue="x => x.Id" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Nombre / Descripción de Regla">
                    <Input @bind-Value="_model.Description" Placeholder="Ej: Fumigación Terrestre Propia" />
                </FormItem>
            </Col>
        </Row>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Actividad ERP (opcional)">
                    <Select TItemValue="Guid?" TItem="ErpActivityDto" @bind-Value="_model.ErpActivityId"
                            Placeholder="Cualquier actividad"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_activities"
                            ItemLabel="x => x.Name"
                            ItemValue="x => (Guid?)x.Id" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Modo (opcional)">
                    <Select TItemValue="LaborExecutionMode?" TItem="LaborExecutionMode?" @bind-Value="_model.ExecutionMode"
                            Placeholder="Propias y de contratista"
                            AllowClear
                            DataSource="@_modos"
                            ItemLabel="ModoLabel"
                            ItemValue="x => x" />
                </FormItem>
            </Col>
        </Row>

        <Alert Type="@AlertType.Info" ShowIcon="true" Style="margin-bottom: 16px;"
               Message="@("Cuanto más específica, más prioridad")"
               Description="@("Una regla aplica a una labor si coinciden todas las dimensiones que declara; las que dejás vacías son comodines. Entre las que aplican gana la que declara más. Dejá todo vacío para la regla general.")" />

        <Divider Text="Configuración del Lote Contable (GestorMax)" Style="color: rgba(255,255,255,0.6);" />

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Empresa ERP (CodEmpresa)">
                    <Select TItemValue="long?" TItem="ErpCompanyDto" @bind-Value="_model.CodEmpresa"
                            Placeholder="Seleccionar Empresa"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_empresas"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodEmpresa" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Comprobante ERP (CodComprobante)">
                    <Select TItemValue="long?" TItem="ErpVoucherTypeDto" @bind-Value="_model.CodComprobante"
                            Placeholder="Seleccionar Comprobante G4"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_comprobantes"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodComprobante" />
                </FormItem>
            </Col>
        </Row>

        <Row Gutter="16">
            <Col Span="8">
                <FormItem Label="Punto de Venta">
                    <AntDesign.InputNumber TValue="int" @bind-Value="_model.PuntoVenta" Style="width: 100%;" />
                </FormItem>
            </Col>
            <Col Span="8">
                <FormItem Label="Moneda ERP (CodMoneda)">
                    <Select TItemValue="long?" TItem="ErpCurrencyDto" @bind-Value="_model.CodMoneda"
                            Placeholder="Seleccionar Moneda"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_monedas"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodMoneda" />
                </FormItem>
            </Col>
            <Col Span="8">
                <FormItem Label="Responsable por Defecto">
                    <Select TItemValue="long?" TItem="ErpPersonItemDto" @bind-Value="_model.CodPersona"
                            Placeholder="Seleccionar Responsable"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_personas"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodPersona" />
                </FormItem>
            </Col>
        </Row>

        <Divider Text="Perfiles de Imputación (Opcional)" Style="color: rgba(255,255,255,0.6);" />

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Cod Perfil Imputación Debe">
                    <Select TItemValue="long?" TItem="ErpProfileDto" Value="@_model.CodPerfilDebe"
                            ValueChanged="OnPerfilDebeChanged"
                            Disabled="@(_model.CodCuentaDebeGestion.HasValue)"
                            Placeholder="Seleccionar Perfil Debe"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_perfiles"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodPerfil" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Cod Perfil Imputación Haber">
                    <Select TItemValue="long?" TItem="ErpProfileDto" Value="@_model.CodPerfilHaber"
                            ValueChanged="OnPerfilHaberChanged"
                            Disabled="@(_model.CodCuentaHaberGestion.HasValue)"
                            Placeholder="Seleccionar Perfil Haber"
                            AllowClear EnableSearch Loading="@_loadingBasicCatalogs"
                            DataSource="@_perfiles"
                            ItemLabel="x => x.Nombre"
                            ItemValue="x => x.CodPerfil" />
                </FormItem>
            </Col>
        </Row>

        <Divider Text="Cuentas Directas (Imputación por Cuenta)" Style="color: rgba(255,255,255,0.6);" />

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Cuenta Debe Gestión (Plan de Gestión)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaDebeGestion"
                            ValueChanged="OnCuentaDebeGestionChanged"
                            Disabled="@(_model.CodPerfilDebe.HasValue)"
                            Placeholder="Buscar Cuenta Debe Gestión..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsGestion"
                            Loading="@_loadingCuentasGestion"
                            DataSource="@_filteredCuentasGestion"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Cuenta Haber Gestión (Plan de Gestión)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaHaberGestion"
                            ValueChanged="OnCuentaHaberGestionChanged"
                            Disabled="@(_model.CodPerfilHaber.HasValue)"
                            Placeholder="Buscar Cuenta Haber Gestión..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsGestion"
                            Loading="@_loadingCuentasGestion"
                            DataSource="@_filteredCuentasGestion"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
        </Row>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Cuenta Debe Centro Costo (Plan de Centro)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaDebeCentro"
                            ValueChanged="v => { _model.CodCuentaDebeCentro = v; FilterCuentasCentro(); }"
                            Placeholder="Buscar Cuenta Debe Centro..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsCentro"
                            Loading="@_loadingCuentasCentro"
                            DataSource="@_filteredCuentasCentro"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Cuenta Haber Centro Costo (Plan de Centro)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaHaberCentro"
                            ValueChanged="v => { _model.CodCuentaHaberCentro = v; FilterCuentasCentro(); }"
                            Placeholder="Buscar Cuenta Haber Centro..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsCentro"
                            Loading="@_loadingCuentasCentro"
                            DataSource="@_filteredCuentasCentro"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
        </Row>

        <Row Gutter="16">
            <Col Span="12">
                <FormItem Label="Cuenta Debe Contabilidad (Plan Contabilidad)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaDebeContabilidad"
                            ValueChanged="v => { _model.CodCuentaDebeContabilidad = v; FilterCuentasContabilidad(); }"
                            Placeholder="Buscar Cuenta Debe Contabilidad..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsContabilidad"
                            Loading="@_loadingCuentasContabilidad"
                            DataSource="@_filteredCuentasContabilidad"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
            <Col Span="12">
                <FormItem Label="Cuenta Haber Contabilidad (Plan Contabilidad)">
                    <Select TItemValue="long?" TItem="ErpAccountDto" Value="@_model.CodCuentaHaberContabilidad"
                            ValueChanged="v => { _model.CodCuentaHaberContabilidad = v; FilterCuentasContabilidad(); }"
                            Placeholder="Buscar Cuenta Haber Contabilidad..."
                            AllowClear EnableSearch OnSearch="OnSearchAccountsContabilidad"
                            Loading="@_loadingCuentasContabilidad"
                            DataSource="@_filteredCuentasContabilidad"
                            ItemLabel="x => x.DisplayName"
                            ItemValue="x => x.CodCuenta" />
                </FormItem>
            </Col>
        </Row>

        <Divider Text="Opciones de Exclusión" Style="color: rgba(255,255,255,0.6);" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <Checkbox @bind-Checked="_model.NoImputaGestion">No imputa Gestión</Checkbox>
            <Checkbox @bind-Checked="_model.NoImputaContabilidad">No imputa Contabilidad</Checkbox>
            <Checkbox @bind-Checked="_model.NoImputaCentro">No imputa Centro Costos</Checkbox>
            <Checkbox @bind-Checked="_model.NoImputaAuxiliar">No imputa Auxiliar</Checkbox>
        </div>
    </Form>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public AccountConfigurationDto? Configuration { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private ConfigModel _model = new();
    private List<LaborTypeDto> _laborTypes = new();
    private List<ErpCompanyDto> _empresas = new();
    private List<ErpVoucherTypeDto> _comprobantes = new();
    private List<ErpCurrencyDto> _monedas = new();
    private List<ErpPersonItemDto> _personas = new();
    private List<ErpProfileDto> _perfiles = new();
    private List<ErpActivityDto> _activities = new();

    private static string ModoLabel(LaborExecutionMode? modo) =>
        modo == LaborExecutionMode.Contractor ? "Solo contratista" : "Solo propias";

    private static readonly List<LaborExecutionMode?> _modos =
        new() { LaborExecutionMode.Own, LaborExecutionMode.Contractor };

    private List<ErpAccountDto> _allCuentasGestion = new();
    private List<ErpAccountDto> _filteredCuentasGestion = new();
    private string _accountSearchTextGestion = string.Empty;

    private List<ErpAccountDto> _allCuentasCentro = new();
    private List<ErpAccountDto> _filteredCuentasCentro = new();
    private string _accountSearchTextCentro = string.Empty;

    private List<ErpAccountDto> _allCuentasContabilidad = new();
    private List<ErpAccountDto> _filteredCuentasContabilidad = new();
    private string _accountSearchTextContabilidad = string.Empty;

    private bool _catalogsLoaded;
    private bool _loadingBasicCatalogs;
    private bool _loadingCuentasGestion;
    private bool _loadingCuentasCentro;
    private bool _loadingCuentasContabilidad;
    private bool _saving;

    protected override async Task OnParametersSetAsync()
    {
        if (Configuration != null)
        {
            _model = new ConfigModel
            {
                Id = Configuration.Id,
                TenantId = Configuration.TenantId,
                LaborTypeId = Configuration.LaborTypeId,
                ErpActivityId = Configuration.ErpActivityId,
                ExecutionMode = Configuration.ExecutionMode,
                LaborTypeName = Configuration.LaborTypeName,
                Description = Configuration.Description,
                CodEmpresa = Configuration.CodEmpresa,
                CodComprobante = Configuration.CodComprobante,
                PuntoVenta = Configuration.PuntoVenta,
                CodMoneda = Configuration.CodMoneda,
                CodPerfilDebe = Configuration.CodPerfilDebe,
                CodPerfilHaber = Configuration.CodPerfilHaber,
                CodPersona = Configuration.CodPersona,
                NoImputaGestion = Configuration.NoImputaGestion,
                NoImputaContabilidad = Configuration.NoImputaContabilidad,
                NoImputaCentro = Configuration.NoImputaCentro,
                NoImputaAuxiliar = Configuration.NoImputaAuxiliar,
                CodCuentaDebeGestion = Configuration.CodCuentaDebeGestion,
                CodCuentaHaberGestion = Configuration.CodCuentaHaberGestion,
                CodCuentaDebeCentro = Configuration.CodCuentaDebeCentro,
                CodCuentaHaberCentro = Configuration.CodCuentaHaberCentro,
                CodCuentaDebeContabilidad = Configuration.CodCuentaDebeContabilidad,
                CodCuentaHaberContabilidad = Configuration.CodCuentaHaberContabilidad
            };

            FilterCuentas();
        }

        if (Visible && !_catalogsLoaded)
        {
            await LoadCatalogsLazyAsync();
        }
    }

    private async Task LoadCatalogsLazyAsync()
    {
        _catalogsLoaded = true;

        _loadingBasicCatalogs = true;
        StateHasChanged();

        try
        {
            var laborTask = CatalogCache.GetLaborTypesAsync();
            var empTask = Http.GetFromJsonAsync<List<ErpCompanyDto>>("api/pases/erp/empresas");
            var compTask = Http.GetFromJsonAsync<List<ErpVoucherTypeDto>>("api/pases/erp/comprobantes");
            var monTask = Http.GetFromJsonAsync<List<ErpCurrencyDto>>("api/pases/erp/monedas");
            var persTask = Http.GetFromJsonAsync<List<ErpPersonItemDto>>("api/pases/erp/personas");
            var perfTask = Http.GetFromJsonAsync<List<ErpProfileDto>>("api/pases/erp/perfiles");
            var actTask = CatalogCache.GetActivitiesAsync();

            // Cada catálogo se espera por separado: si uno falla, los demás igual se cargan.
            var fallidos = new List<string>();
            _laborTypes = await SafeAsync(laborTask, "tipos de labor", fallidos) ?? new();
            _empresas = await SafeAsync(empTask, "empresas", fallidos) ?? new();
            _comprobantes = await SafeAsync(compTask, "comprobantes", fallidos) ?? new();
            _monedas = await SafeAsync(monTask, "monedas", fallidos) ?? new();
            _personas = await SafeAsync(persTask, "personas", fallidos) ?? new();
            _perfiles = await SafeAsync(perfTask, "perfiles de imputación", fallidos) ?? new();
            _activities = await SafeAsync(actTask, "actividades", fallidos) ?? new();

            if (fallidos.Count > 0)
            {
                Message.Error($"No se pudieron cargar del ERP: {string.Join(", ", fallidos)}.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar catálogos del ERP: {ex.Message}");
        }
        finally
        {
            _loadingBasicCatalogs = false;
            StateHasChanged();
        }

        _loadingCuentasGestion = true;
        _loadingCuentasCentro = true;
        _loadingCuentasContabilidad = true;
        StateHasChanged();

        var gTask = Task.Run(async () => {
            try { return await Http.GetFromJsonAsync<List<ErpAccountDto>>("api/pases/erp/cuentas/gestion") ?? new(); }
            catch { return new List<ErpAccountDto>(); }
        });

        var cTask = Task.Run(async () => {
            try { return await Http.GetFromJsonAsync<List<ErpAccountDto>>("api/pases/erp/cuentas/centro") ?? new(); }
            catch { return new List<ErpAccountDto>(); }
        });

        var ctTask = Task.Run(async () => {
            try { return await Http.GetFromJsonAsync<List<ErpAccountDto>>("api/pases/erp/cuentas/contabilidad") ?? new(); }
            catch { return new List<ErpAccountDto>(); }
        });

        _allCuentasGestion = await gTask;
        _loadingCuentasGestion = false;
        FilterCuentasGestion();
        StateHasChanged();

        _allCuentasCentro = await cTask;
        _loadingCuentasCentro = false;
        FilterCuentasCentro();
        StateHasChanged();

        _allCuentasContabilidad = await ctTask;
        _loadingCuentasContabilidad = false;
        FilterCuentasContabilidad();
        StateHasChanged();
    }

    private async Task<T?> SafeAsync<T>(Task<T?> task, string nombre, List<string> fallidos)
    {
        try
        {
            return await task;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Catálogo ERP '{nombre}' falló: {ex.Message}");
            fallidos.Add(nombre);
            return default;
        }
    }

    private void OnSearchAccountsGestion(string text) { _accountSearchTextGestion = text ?? string.Empty; FilterCuentasGestion(); }
    private void OnSearchAccountsCentro(string text) { _accountSearchTextCentro = text ?? string.Empty; FilterCuentasCentro(); }
    private void OnSearchAccountsContabilidad(string text) { _accountSearchTextContabilidad = text ?? string.Empty; FilterCuentasContabilidad(); }

    private void FilterCuentas()
    {
        FilterCuentasGestion();
        FilterCuentasCentro();
        FilterCuentasContabilidad();
    }

    private void FilterCuentasGestion()
    {
        IEnumerable<ErpAccountDto> matches;
        if (string.IsNullOrWhiteSpace(_accountSearchTextGestion))
        {
            matches = _allCuentasGestion.Take(100);
        }
        else
        {
            var query = _accountSearchTextGestion.Trim().ToLowerInvariant();
            matches = _allCuentasGestion
                .Where(c => (c.Nombre != null && c.Nombre.ToLowerInvariant().Contains(query)) ||
                            (c.CodigoCuenta != null && c.CodigoCuenta.ToLowerInvariant().Contains(query)) ||
                            c.CodCuenta.ToString().Contains(query))
                .Take(100);
        }

        var selectedIds = new HashSet<long>();
        if (_model.CodCuentaDebeGestion.HasValue) selectedIds.Add(_model.CodCuentaDebeGestion.Value);
        if (_model.CodCuentaHaberGestion.HasValue) selectedIds.Add(_model.CodCuentaHaberGestion.Value);

        var selectedAccounts = _allCuentasGestion.Where(c => selectedIds.Contains(c.CodCuenta));
        _filteredCuentasGestion = selectedAccounts.Concat(matches).DistinctBy(c => c.CodCuenta).ToList();
    }

    private void FilterCuentasCentro()
    {
        IEnumerable<ErpAccountDto> matches;
        if (string.IsNullOrWhiteSpace(_accountSearchTextCentro))
        {
            matches = _allCuentasCentro.Take(100);
        }
        else
        {
            var query = _accountSearchTextCentro.Trim().ToLowerInvariant();
            matches = _allCuentasCentro
                .Where(c => (c.Nombre != null && c.Nombre.ToLowerInvariant().Contains(query)) ||
                            (c.CodigoCuenta != null && c.CodigoCuenta.ToLowerInvariant().Contains(query)) ||
                            c.CodCuenta.ToString().Contains(query))
                .Take(100);
        }

        var selectedIds = new HashSet<long>();
        if (_model.CodCuentaDebeCentro.HasValue) selectedIds.Add(_model.CodCuentaDebeCentro.Value);
        if (_model.CodCuentaHaberCentro.HasValue) selectedIds.Add(_model.CodCuentaHaberCentro.Value);

        var selectedAccounts = _allCuentasCentro.Where(c => selectedIds.Contains(c.CodCuenta));
        _filteredCuentasCentro = selectedAccounts.Concat(matches).DistinctBy(c => c.CodCuenta).ToList();
    }

    private void FilterCuentasContabilidad()
    {
        IEnumerable<ErpAccountDto> matches;
        if (string.IsNullOrWhiteSpace(_accountSearchTextContabilidad))
        {
            matches = _allCuentasContabilidad.Take(100);
        }
        else
        {
            var query = _accountSearchTextContabilidad.Trim().ToLowerInvariant();
            matches = _allCuentasContabilidad
                .Where(c => (c.Nombre != null && c.Nombre.ToLowerInvariant().Contains(query)) ||
                            (c.CodigoCuenta != null && c.CodigoCuenta.ToLowerInvariant().Contains(query)) ||
                            c.CodCuenta.ToString().Contains(query))
                .Take(100);
        }

        var selectedIds = new HashSet<long>();
        if (_model.CodCuentaDebeContabilidad.HasValue) selectedIds.Add(_model.CodCuentaDebeContabilidad.Value);
        if (_model.CodCuentaHaberContabilidad.HasValue) selectedIds.Add(_model.CodCuentaHaberContabilidad.Value);

        var selectedAccounts = _allCuentasContabilidad.Where(c => selectedIds.Contains(c.CodCuenta));
        _filteredCuentasContabilidad = selectedAccounts.Concat(matches).DistinctBy(c => c.CodCuenta).ToList();
    }

    private void OnPerfilDebeChanged(long? val)
    {
        _model.CodPerfilDebe = val;
        if (val.HasValue && val.Value != 0)
        {
            _model.CodCuentaDebeGestion = null;
        }
        FilterCuentasGestion();
    }

    private void OnCuentaDebeGestionChanged(long? val)
    {
        _model.CodCuentaDebeGestion = val;
        if (val.HasValue && val.Value != 0)
        {
            _model.CodPerfilDebe = null;
        }
        FilterCuentasGestion();
    }

    private void OnPerfilHaberChanged(long? val)
    {
        _model.CodPerfilHaber = val;
        if (val.HasValue && val.Value != 0)
        {
            _model.CodCuentaHaberGestion = null;
        }
        FilterCuentasGestion();
    }

    private void OnCuentaHaberGestionChanged(long? val)
    {
        _model.CodCuentaHaberGestion = val;
        if (val.HasValue && val.Value != 0)
        {
            _model.CodPerfilHaber = null;
        }
        FilterCuentasGestion();
    }

    private async Task SaveConfiguration()
    {
        _saving = true;
        try
        {
            var matchedLaborType = _laborTypes.FirstOrDefault(t => t.Id == _model.LaborTypeId);
            var laborTypeName = matchedLaborType?.Name ?? _model.LaborTypeName;

            var dto = new AccountConfigurationDto(
                _model.Id,
                _model.TenantId,
                _model.LaborTypeId,
                laborTypeName,
                "", "", _model.Description ?? "", true,
                _model.CodEmpresa,
                _model.CodComprobante,
                _model.PuntoVuntoOrDefault(),
                _model.CodMoneda,
                _model.CodPerfilDebe,
                _model.CodPerfilHaber,
                _model.CodPersona,
                _model.NoImputaGestion,
                _model.NoImputaContabilidad,
                _model.NoImputaCentro,
                _model.NoImputaAuxiliar,
                _model.CodCuentaDebeGestion,
                _model.CodCuentaHaberGestion,
                _model.CodCuentaDebeCentro,
                _model.CodCuentaHaberCentro,
                _model.CodCuentaDebeContabilidad,
                _model.CodCuentaHaberContabilidad,
                null, null
            )
            {
                // Van por inicializador: son propiedades fuera del constructor posicional.
                ErpActivityId = _model.ErpActivityId,
                ExecutionMode = _model.ExecutionMode
            };

            var resp = await Http.PostAsJsonAsync("api/pases/account-configurations", dto);
            if (resp.IsSuccessStatusCode)
            {
                Message.Success("Configuración contable guardada exitosamente.");
                await VisibleChanged.InvokeAsync(false);
                await OnSaved.InvokeAsync();
            }
            else
            {
                Message.Error("No se pudo guardar la configuración contable.");
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al guardar: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleClose()
    {
        await VisibleChanged.InvokeAsync(false);
    }

    public class ConfigModel
    {
        public Guid Id { get; set; }
        public Guid TenantId { get; set; }
        public Guid? LaborTypeId { get; set; }
        public Guid? ErpActivityId { get; set; }
        public LaborExecutionMode? ExecutionMode { get; set; }
        public string? LaborTypeName { get; set; }
        public string? Description { get; set; }
        public long? CodEmpresa { get; set; } = 1;
        public long? CodComprobante { get; set; } = 1;
        public int PuntoVenta { get; set; } = 1;
        public long? CodMoneda { get; set; } = 1;
        public long? CodPerfilDebe { get; set; }
        public long? CodPerfilHaber { get; set; }
        public long? CodPersona { get; set; }
        public bool NoImputaGestion { get; set; }
        public bool NoImputaContabilidad { get; set; }
        public bool NoImputaCentro { get; set; }
        public bool NoImputaAuxiliar { get; set; }
        public long? CodCuentaDebeGestion { get; set; }
        public long? CodCuentaHaberGestion { get; set; }
        public long? CodCuentaDebeCentro { get; set; }
        public long? CodCuentaHaberCentro { get; set; }
        public long? CodCuentaDebeContabilidad { get; set; }
        public long? CodCuentaHaberContabilidad { get; set; }

        public int PuntoVuntoOrDefault() => PuntoVenta <= 0 ? 1 : PuntoVenta;
    }
