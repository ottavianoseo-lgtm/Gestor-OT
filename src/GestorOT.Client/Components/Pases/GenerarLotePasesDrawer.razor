@using GestorOT.Shared.Dtos
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message

<Modal Title="Generar Lote de Pases G4"
       Visible="@IsOpen"
       OnCancel="HandleClose"
       Footer="null"
       Width="850">

    <div style="display: flex; flex-direction: column; gap: 16px;">
        <div>
            <span style="font-size: 12px; color: rgba(255,255,255,0.6); display: block; margin-bottom: 6px;">Descripción del lote (opcional)</span>
            <Input @bind-Value="_descripcion" Placeholder="Ej: Lote Labores Julio 2026 - Campaña Trigo" />
        </div>

        <Tabs DefaultActiveKey="wos" @bind-ActiveKey="_activeTab">
            <TabPane Key="wos" Tab="@($"Órdenes de Trabajo ({Listas(_pendingWos).Count} listas de {_pendingWos.Count})")">
                @if (_loading)
                {
                    <div style="text-align: center; padding: 40px;">
                        <Spin Tip="Cargando Órdenes de Trabajo pendientes..." />
                    </div>
                }
                else if (!_pendingWos.Any())
                {
                    <div style="text-align: center; padding: 40px; color: rgba(255,255,255,0.4);">
                        <Icon Type="check-circle" Theme="IconThemeType.Outline" Style="font-size: 36px; margin-bottom: 8px; display: block;" />
                        <span>No hay Órdenes de Trabajo pendientes de imputación.</span>
                    </div>
                }
                else
                {
                    <div style="display: flex; gap: 16px; margin-bottom: 8px; flex-wrap: wrap;">
                        <Checkbox Checked="@PaginaCompleta(_visibleWos, _selectedWos, _woQuery)"
                                  CheckedChanged="@((bool v) => _selectedWos = MarcarPagina(_visibleWos, _selectedWos, _woQuery, v))">
                            Seleccionar página
                        </Checkbox>
                        <Checkbox Checked="@TodasMarcadas(_pendingWos, _selectedWos)"
                                  CheckedChanged="@((bool v) => _selectedWos = v ? Listas(_pendingWos) : new List<PendingImputacionItemDto>())">
                            Seleccionar todas las listas (@Listas(_pendingWos).Count)
                        </Checkbox>
                        <Checkbox Checked="_soloListas" CheckedChanged="CambiarSoloListas" Style="margin-left: auto;">
                            Solo listas para importar
                        </Checkbox>
                    </div>
                    <Table TItem="PendingImputacionItemDto"
                           DataSource="_visibleWos"
                           Size="@TableSize.Small"
                           PageSize="10"
                           @bind-SelectedRows="_selectedWos"
                           OnChange="@((QueryModel<PendingImputacionItemDto> m) => _woQuery = m)"
                           RowKey="x => x.Id.ToString()">
                        <Selection Key="@(context.Id.ToString())" Type="SelectionType.Checkbox" />
                        <PropertyColumn Property="c => c.Identifier" Title="Identificador" Sortable />
                        <PropertyColumn Property="c => c.Date" Title="Fecha" Format="dd/MM/yyyy" Sortable />
                        <PropertyColumn Property="c => c.Details" Title="Detalles" />
                        <PropertyColumn Property="c => c.Area" Title="Superficie Total">
                            <span style="font-weight: 600; font-family: monospace;">@context.Area.ToString("N1") ha</span>
                        </PropertyColumn>
                        <Column TData="string" Title="Estado">
                            <EstadoPendiente Item="context" OnVerLote="VerLote" />
                        </Column>
                    </Table>
                }
            </TabPane>

            <TabPane Key="labors" Tab="@($"Labores Sueltas ({Listas(_pendingLabors).Count} listas de {_pendingLabors.Count})")">
                @if (_loading)
                {
                    <div style="text-align: center; padding: 40px;">
                        <Spin Tip="Cargando labores sueltas..." />
                    </div>
                }
                else if (!_pendingLabors.Any())
                {
                    <div style="text-align: center; padding: 40px; color: rgba(255,255,255,0.4);">
                        <Icon Type="thunderbolt" Theme="IconThemeType.Outline" Style="font-size: 36px; margin-bottom: 8px; display: block;" />
                        <span>No hay labores sueltas pendientes de imputación.</span>
                    </div>
                }
                else
                {
                    <div style="display: flex; gap: 16px; margin-bottom: 8px; flex-wrap: wrap;">
                        <Checkbox Checked="@PaginaCompleta(_visibleLabors, _selectedLabors, _laborQuery)"
                                  CheckedChanged="@((bool v) => _selectedLabors = MarcarPagina(_visibleLabors, _selectedLabors, _laborQuery, v))">
                            Seleccionar página
                        </Checkbox>
                        <Checkbox Checked="@TodasMarcadas(_pendingLabors, _selectedLabors)"
                                  CheckedChanged="@((bool v) => _selectedLabors = v ? Listas(_pendingLabors) : new List<PendingImputacionItemDto>())">
                            Seleccionar todas las listas (@Listas(_pendingLabors).Count)
                        </Checkbox>
                        <Checkbox Checked="_soloListas" CheckedChanged="CambiarSoloListas" Style="margin-left: auto;">
                            Solo listas para importar
                        </Checkbox>
                    </div>
                    <Table TItem="PendingImputacionItemDto"
                           DataSource="_visibleLabors"
                           Size="@TableSize.Small"
                           PageSize="10"
                           @bind-SelectedRows="_selectedLabors"
                           OnChange="@((QueryModel<PendingImputacionItemDto> m) => _laborQuery = m)"
                           RowKey="x => x.Id.ToString()">
                        <Selection Key="@(context.Id.ToString())" Type="SelectionType.Checkbox" />
                        <PropertyColumn Property="c => c.Identifier" Title="Labor / Lote" Sortable />
                        <PropertyColumn Property="c => c.Date" Title="Fecha Ejecución" Format="dd/MM/yyyy" Sortable />
                        <PropertyColumn Property="c => c.Details" Title="Detalles" />
                        <PropertyColumn Property="c => c.Area" Title="Superficie">
                            <span style="font-weight: 600; font-family: monospace;">@context.Area.ToString("N1") ha</span>
                        </PropertyColumn>
                        <Column TData="string" Title="Estado">
                            <EstadoPendiente Item="context" OnVerLote="VerLote" />
                        </Column>
                    </Table>
                }
            </TabPane>
        </Tabs>

        @if (_warnings.Any())
        {
            <Alert Type="@AlertType.Warning" Message="@($"Advertencias ({_warnings.Count})")" ShowIcon="true">
                <ChildContent>
                    <ul style="margin: 0; padding-left: 18px; max-height: 200px; overflow-y: auto;">
                        @foreach (var w in _warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </ChildContent>
            </Alert>
        }

        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px; margin-top: 8px;">
            <span style="font-size: 13px; color: rgba(255,255,255,0.6);">
                Seleccionados: <strong>@(_selectedWos.Count() + _selectedLabors.Count())</strong> elementos
            </span>
            <div style="display: flex; gap: 8px;">
                <Button OnClick="HandleClose">Cancelar</Button>
                <Button Type="@ButtonType.Primary"
                        Icon="file-done"
                        Loading="_generando"
                        Disabled="@(!_selectedWos.Any() && !_selectedLabors.Any())"
                        OnClick="Generar"
                        Style="background: #2ECC71; border-color: #2ECC71; font-weight: 600;">
                    Generar Lote G4
                </Button>
            </div>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnLoteGenerado { get; set; }
    /// <summary>Abre el detalle del lote en el que ya esta una OT o labor.</summary>
    [Parameter] public EventCallback<Guid> OnVerLote { get; set; }

    // Por defecto solo se ofrece lo que entraria al lote: realizado y fuera de otro lote.
    private bool _soloListas = true;

    private string _activeTab = "wos";
    private string _descripcion = "";
    private bool _loading;
    private bool _generando;
    private List<string> _warnings = new();

    private List<PendingImputacionItemDto> _pendingWos = new();
    private List<PendingImputacionItemDto> _pendingLabors = new();

    // La casilla del encabezado de la tabla marca solo la pagina visible; estas listas guardan
    // la seleccion completa, que es la que se manda al generar.
    private IEnumerable<PendingImputacionItemDto> _selectedWos = new List<PendingImputacionItemDto>();
    private IEnumerable<PendingImputacionItemDto> _selectedLabors = new List<PendingImputacionItemDto>();
    private QueryModel<PendingImputacionItemDto>? _woQuery;
    private QueryModel<PendingImputacionItemDto>? _laborQuery;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_pendingWos.Any() && !_pendingLabors.Any())
        {
            await CargarPendientesAsync();
        }
    }

    private async Task CargarPendientesAsync(bool conservarAvisos = false)
    {
        _loading = true;
        if (!conservarAvisos) _warnings.Clear();
        try
        {
            var res = await Http.GetFromJsonAsync<List<PendingImputacionItemDto>>("api/pases/pending");
            if (res != null)
            {
                _pendingWos = res.Where(i => i.Type == "WorkOrder").ToList();
                _pendingLabors = res.Where(i => i.Type == "Labor").ToList();
                RefrescarVisibles();
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error al cargar pendientes: {ex.Message}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // Lo que muestra cada tabla. Se guarda en un campo y no se calcula en el render: una lista
    // nueva en cada render le cambia el DataSource a la tabla y la vuelve a la pagina 1.
    private List<PendingImputacionItemDto> _visibleWos = new();
    private List<PendingImputacionItemDto> _visibleLabors = new();

    private void RefrescarVisibles()
    {
        _visibleWos = _soloListas ? Listas(_pendingWos) : _pendingWos;
        _visibleLabors = _soloListas ? Listas(_pendingLabors) : _pendingLabors;
    }

    private void CambiarSoloListas(bool valor)
    {
        _soloListas = valor;
        RefrescarVisibles();
    }

    private static List<PendingImputacionItemDto> Listas(List<PendingImputacionItemDto> data) =>
        data.Where(i => i.Importable).ToList();

    private static bool TodasMarcadas(List<PendingImputacionItemDto> data, IEnumerable<PendingImputacionItemDto> seleccion)
    {
        var listas = Listas(data);
        return listas.Count > 0 && listas.All(seleccion.Contains);
    }

    private Task VerLote(Guid loteId) => OnVerLote.InvokeAsync(loteId);

    /// <summary>Las filas de la pagina que se ve, con el orden que tenga la tabla.</summary>
    private static List<PendingImputacionItemDto> PaginaActual(
        List<PendingImputacionItemDto> data, QueryModel<PendingImputacionItemDto>? query) =>
        query is null
            ? data.Take(10).ToList()
            : query.CurrentPagedRecords(data.AsQueryable()).ToList();

    private static bool PaginaCompleta(
        List<PendingImputacionItemDto> data,
        IEnumerable<PendingImputacionItemDto> seleccion,
        QueryModel<PendingImputacionItemDto>? query)
    {
        var pagina = PaginaActual(data, query);
        return pagina.Count > 0 && pagina.All(seleccion.Contains);
    }

    private static List<PendingImputacionItemDto> MarcarPagina(
        List<PendingImputacionItemDto> data,
        IEnumerable<PendingImputacionItemDto> seleccion,
        QueryModel<PendingImputacionItemDto>? query,
        bool marcar)
    {
        var pagina = PaginaActual(data, query);
        return marcar
            ? seleccion.Union(pagina).ToList()
            : seleccion.Except(pagina).ToList();
    }

    private async Task Generar()
    {
        _generando = true; _warnings.Clear();
        try
        {
            var req = new GenerarLoteRequestDto(
                _selectedWos.Select(x => x.Id).ToList(),
                _selectedLabors.Select(x => x.Id).ToList(),
                _descripcion
            );

            var resp = await Http.PostAsJsonAsync("api/pases/lotes", req);
            var result = await resp.Content.ReadFromJsonAsync<PaseLoteResult>();

            if (result?.Success == true)
            {
                Message.Success($"Lote G4 generado exitosamente con {result.TotalPases} pases.");
                await OnLoteGenerado.InvokeAsync();
                if (result.Warnings.Any())
                {
                    // Con avisos el modal queda abierto: dicen que se omitio y que salio con
                    // precio 0, y se pierden si se cierra.
                    _warnings = result.Warnings;
                    _selectedWos = new List<PendingImputacionItemDto>();
                    _selectedLabors = new List<PendingImputacionItemDto>();
                    await CargarPendientesAsync(conservarAvisos: true);
                }
                else
                {
                    await IsOpenChanged.InvokeAsync(false);
                }
            }
            else
            {
                Message.Error(result?.Error ?? "Error al generar el lote.");
                _warnings = result?.Warnings ?? new List<string>();
            }
        }
        catch (Exception ex)
        {
            Message.Error($"Error inesperado: {ex.Message}");
        }
        finally
        {
            _generando = false;
            StateHasChanged();
        }
    }

    private async Task HandleClose()
    {
        _pendingWos.Clear();
        _pendingLabors.Clear();
        RefrescarVisibles();
        _selectedWos = new List<PendingImputacionItemDto>();
        _selectedLabors = new List<PendingImputacionItemDto>();
        _woQuery = null;
        _laborQuery = null;
        _warnings.Clear();
        _descripcion = "";
        await IsOpenChanged.InvokeAsync(false);
    }
}
