@using GestorOT.Shared.Dtos
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message

@* Que OTs y labores salieron en un lote. Se abre desde la lista de lotes y desde el tag
   "Lote 0001" de cada OT al generar, para ver donde quedo cada cosa. *@
<Modal Title="@(_lote is null ? "Lote de pases" : $"Lote {_lote.Numero:D4}")"
       Visible="@(LoteId.HasValue)"
       OnCancel="Cerrar"
       Footer="null"
       Width="720">
    @if (_loading || _lote is null)
    {
        <div style="text-align: center; padding: 40px;"><Spin /></div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; gap: 24px; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.7);">
                <span>Generado: <strong>@_lote.GeneradoEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                <span>Pases: <strong>@_lote.TotalPases</strong></span>
                <span>OTs: <strong>@_ots.Count</strong></span>
                @if (!string.IsNullOrWhiteSpace(_lote.Descripcion))
                {
                    <span>@_lote.Descripcion</span>
                }
            </div>

            <Table TItem="OtDelLote" DataSource="_ots" Size="@TableSize.Small" PageSize="10">
                <PropertyColumn Property="c => c.Referencia" Title="OT / Referencia" Sortable />
                <PropertyColumn Property="c => c.Fecha" Title="Fecha" Format="dd/MM/yyyy" Sortable />
                <PropertyColumn Property="c => c.Labores" Title="Labores" />
                <PropertyColumn Property="c => c.Lineas" Title="Líneas" />
            </Table>

            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <Popconfirm Title="¿Borrar el lote y sus pases? Sus OTs vuelven a quedar pendientes."
                            OkText="Borrar" CancelText="Cancelar"
                            OnConfirm="Borrar">
                    <Button Icon="delete" Danger>Borrar lote</Button>
                </Popconfirm>
                <Button Type="@ButtonType.Primary" Icon="download" OnClick="() => OnDescargar.InvokeAsync(_lote.Id)">
                    Descargar XLSX
                </Button>
            </div>
        </div>
    }
</Modal>

@code {
    /// <summary>El lote a mostrar; null cierra el modal.</summary>
    [Parameter] public Guid? LoteId { get; set; }
    [Parameter] public EventCallback<Guid?> LoteIdChanged { get; set; }
    [Parameter] public EventCallback<Guid> OnDescargar { get; set; }
    [Parameter] public EventCallback<Guid> OnBorrar { get; set; }

    private sealed record OtDelLote(string Referencia, DateTime Fecha, int Labores, int Lineas);

    private PaseLoteDto? _lote;
    private List<OtDelLote> _ots = new();
    private bool _loading;
    private Guid? _cargado;

    protected override async Task OnParametersSetAsync()
    {
        if (LoteId is not Guid id)
        {
            _cargado = null;
            _lote = null;
            return;
        }

        if (_cargado == id) return;
        _cargado = id;
        _loading = true;
        try
        {
            _lote = await Http.GetFromJsonAsync<PaseLoteDto>($"api/pases/lotes/{id}");
            _ots = (_lote?.Pases ?? new())
                .GroupBy(p => p.IdReferencia)
                .Select(g => new OtDelLote(
                    g.Key,
                    g.Min(p => p.Fecha),
                    g.Where(p => p.LaborId.HasValue).Select(p => p.LaborId).Distinct().Count(),
                    g.Count()))
                .OrderBy(o => o.Referencia)
                .ToList();
        }
        catch (Exception ex)
        {
            Message.Error($"No se pudo cargar el lote: {ex.Message}");
            await Cerrar();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Borrar()
    {
        if (_lote is null) return;
        await OnBorrar.InvokeAsync(_lote.Id);
        await Cerrar();
    }

    private Task Cerrar() => LoteIdChanged.InvokeAsync(null);
}
