@using GestorOT.Shared
@using GestorOT.Shared.Dtos
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message
@inject NavigationManager Nav
@inject IJSRuntime Js

<Modal Visible="@Visible"
       Title="@("Importación Masiva de Labores e Insumos")"
       OnCancel="HandleClose"
       Footer="@null"
       Width="800"
       Style="top: 20px;">

    @if (CampaignId == Guid.Empty)
    {
        <Alert Type="@AlertType.Warning"
               Message="No hay ninguna campaña seleccionada"
               Description="Para realizar la importación de labores e insumos, primero debés seleccionar una campaña activa en la barra superior."
               ShowIcon="true"
               Style="margin: 16px 0;" />
        <div style="text-align: right; margin-top: 16px;">
            <Button OnClick="HandleClose">Cerrar</Button>
        </div>
    }
    else if (_step == 1)
    {
        <!-- STEP 1: CARGA DE ARCHIVO -->
        <div style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; background: rgba(46, 204, 113, 0.08); padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(46, 204, 113, 0.25);">
            <div style="display: flex; align-items: center; gap: 8px;">
                <Icon Type="calendar" Theme="IconThemeType.Outline" Style="color: #2ECC71; font-size: 18px;" />
                <div>
                    <span style="font-size: 12px; color: rgba(255,255,255,0.6);">Campaña de destino:</span>
                    <strong style="display: block; color: #fff; font-size: 14px;">@CampaignName</strong>
                </div>
            </div>
            <Button Type="@ButtonType.Link" OnClick="DownloadTemplate" Style="color: #2ECC71; font-weight: 600;">
                <Icon Type="download" /> Descargar Plantilla Excel Modelo
            </Button>
        </div>

        <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 20px; margin-bottom: 20px;">
            <h4 style="color: #fff; margin-bottom: 8px; font-size: 15px;">¿Cómo funciona la importación de labores?</h4>
            <p style="color: rgba(255,255,255,0.7); font-size: 13px; margin-bottom: 12px;">
                Podés subir tanto nuestro <strong>Template Estándar Gestor-OT</strong> como la planilla nativa <strong>AMSA / CREA</strong>.
            </p>
            <ul style="color: rgba(255,255,255,0.6); font-size: 12px; padding-left: 20px; margin: 0; line-height: 1.8;">
                <li><strong>Importación directa:</strong> todo lo que haga match completo (lote, labor, insumos, responsable y proveedor) se importa en el acto, sin pasos intermedios.</li>
                <li><strong>Lo que no matchee</strong> queda en la sección <strong>Importaciones Pendientes</strong> con la misma vista de conciliación, para matchearlo a mano cuando quieras. Nada pendiente es una labor todavía.</li>
                <li><strong>Sin re-subidas:</strong> ya no hace falta corregir la planilla y subirla entera por unas pocas filas con problemas.</li>
            </ul>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert Type="@AlertType.Error" Message="@_errorMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
        }

        <div style="border: 2px dashed rgba(255,255,255,0.2); border-radius: 12px; padding: 40px 20px; text-align: center; background: rgba(0,0,0,0.15); transition: all 0.3s; margin-bottom: 20px;">
            <Icon Type="file-excel" Theme="IconThemeType.Outline" Style="font-size: 48px; color: #2ECC71; margin-bottom: 16px;" />
            <p style="color: #fff; font-size: 16px; font-weight: 600; margin-bottom: 8px;">
                Seleccioná o arrastrá el archivo Excel de labores (.xlsx)
            </p>
            <p style="color: rgba(255,255,255,0.5); font-size: 13px; margin-bottom: 20px;">
                Soporta Template Estándar y Planilla Datos AMSA/CREA (hasta 15 MB)
            </p>
            <div style="display: inline-block;">
                <InputFile OnChange="HandleFileSelected" accept=".xlsx,.xls" id="excelLaborFileInput" style="display: none;" />
                <label for="excelLaborFileInput" class="ant-btn ant-btn-primary" style="background: #2ECC71; border-color: #2ECC71; font-weight: 600; cursor: pointer; padding: 6px 20px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px;">
                    <Icon Type="upload" /> Explorar Archivo
                </label>
            </div>
            @if (_isProcessing)
            {
                <div style="margin-top: 20px;">
                    <Spin Tip="Importando filas con match completo..." />
                </div>
            }
        </div>

        <div style="text-align: right;">
            <Button OnClick="HandleClose">Cancelar</Button>
        </div>
    }
    else if (_step == 2 && _uploadResult != null)
    {
        <!-- STEP 2: RESULTADO -->
        @if (_uploadResult.DuplicateOfBatchId.HasValue)
        {
            <div style="text-align: center; padding: 30px 20px;">
                <Icon Type="warning" Theme="IconThemeType.Fill" Style="font-size: 56px; color: #F39C12; margin-bottom: 16px;" />
                <h3 style="color: #fff; font-size: 20px; margin-bottom: 8px;">Este archivo ya se había subido</h3>
                <p style="color: rgba(255,255,255,0.7); font-size: 14px; max-width: 500px; margin: 0 auto 24px auto;">
                    <strong>@_uploadResult.DuplicateFileName</strong> se subió el @_uploadResult.DuplicateUploadedAt?.ToString("dd/MM/yyyy HH:mm")
                    (@_uploadResult.PendingRows fila(s) todavía pendientes). No se importó nada para no duplicar.
                </p>
                <div style="display: flex; gap: 8px; justify-content: center;">
                    <Button OnClick="GoToPending" Style="border-radius: 8px;">
                        <Icon Type="inbox" /> Ver lote existente
                    </Button>
                    <Button Type="@ButtonType.Primary" Loading="@_isProcessing" OnClick="() => UploadSelectedFile(force: true)"
                            Style="background: #F39C12; border-color: #F39C12; font-weight: 600; border-radius: 8px;">
                        Subir igual
                    </Button>
                    <Button OnClick="ResetImport" Style="border-radius: 8px;">Cancelar</Button>
                </div>
            </div>
        }
        else
        {
            <div style="text-align: center; padding: 30px 20px;">
                <Icon Type="check-circle" Theme="IconThemeType.Fill" Style="font-size: 56px; color: #2ECC71; margin-bottom: 16px;" />
                <h3 style="color: #fff; font-size: 20px; margin-bottom: 8px;">¡Importación procesada!</h3>
                <p style="color: rgba(255,255,255,0.7); font-size: 14px; max-width: 520px; margin: 0 auto 24px auto;">
                    Las filas con match completo se importaron en la campaña <strong>@CampaignName</strong>.
                    @if (_uploadResult.PendingRows > 0)
                    {
                        <span>Las <strong>@_uploadResult.PendingRows</strong> restantes quedaron en <strong>Importaciones Pendientes</strong> para matchearlas a mano.</span>
                    }
                </p>

                <div style="display: grid; grid-template-columns: repeat(@(_uploadResult.PendingRows > 0 ? 3 : 2), 1fr); gap: 12px; max-width: 560px; margin: 0 auto 24px auto;">
                    <div style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                        <div style="font-size: 22px; font-weight: 700; color: #2ECC71;">@(_uploadResult.LaborsCreated + _uploadResult.LaborsUpdated)</div>
                        <div style="font-size: 11px; color: rgba(255,255,255,0.6);">Labores Importadas</div>
                    </div>
                    <div style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                        <div style="font-size: 22px; font-weight: 700; color: #3498DB;">@_uploadResult.SuppliesCreated</div>
                        <div style="font-size: 11px; color: rgba(255,255,255,0.6);">Insumos Asignados</div>
                    </div>
                    @if (_uploadResult.PendingRows > 0)
                    {
                        <div style="background: rgba(243,156,18,0.08); padding: 12px; border-radius: 8px; border: 1px solid rgba(243,156,18,0.3);">
                            <div style="font-size: 22px; font-weight: 700; color: #F39C12;">@_uploadResult.PendingRows</div>
                            <div style="font-size: 11px; color: rgba(255,255,255,0.6);">A Revisión</div>
                        </div>
                    }
                </div>

                @if (_uploadResult.Errors.Count > 0)
                {
                    <div style="text-align: left; max-width: 560px; margin: 0 auto 20px auto; background: rgba(231, 76, 60, 0.1); border: 1px solid rgba(231, 76, 60, 0.2); border-radius: 8px; padding: 12px;">
                        <div style="color: #E74C3C; font-weight: 600; font-size: 13px; margin-bottom: 6px;">Observaciones:</div>
                        <ul style="margin: 0; padding-left: 16px; font-size: 12px; color: rgba(255,255,255,0.8);">
                            @foreach (var err in _uploadResult.Errors.Take(5))
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }

                <div style="display: flex; gap: 8px; justify-content: center;">
                    @if (_uploadResult.PendingRows > 0)
                    {
                        <Button Type="@ButtonType.Primary" OnClick="GoToPending" Style="background: #F39C12; border-color: #F39C12; font-weight: 600; padding: 0 30px; border-radius: 8px;">
                            <Icon Type="inbox" /> Revisar pendientes
                        </Button>
                    }
                    <Button Type="@(_uploadResult.PendingRows > 0 ? ButtonType.Default : ButtonType.Primary)" OnClick="FinishAndClose" Style="font-weight: 600; padding: 0 30px; border-radius: 8px;">
                        Finalizar
                    </Button>
                </div>
            </div>
        }
    }

</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid CampaignId { get; set; }
    [Parameter] public string CampaignName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnLaborsImported { get; set; }

    private int _step = 1;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private string _selectedFileName = string.Empty;
    private byte[]? _fileBytes;
    private LaborImportUploadResultDto? _uploadResult;

    private async Task DownloadTemplate()
    {
        try
        {
            await Js.InvokeVoidAsync("open", "api/labors/import/template", "_blank");
        }
        catch (Exception ex)
        {
            Message.Error($"Error al descargar la plantilla: {ex.Message}");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _errorMessage = null;

        var maxSize = 20 * 1024 * 1024; // 20MB
        if (file.Size > maxSize)
        {
            _errorMessage = "El archivo supera el límite de 20 MB.";
            return;
        }

        _selectedFileName = file.Name;
        using var ms = new MemoryStream();
        await file.OpenReadStream(maxSize).CopyToAsync(ms);
        _fileBytes = ms.ToArray();

        await UploadSelectedFile(force: false);
    }

    private async Task UploadSelectedFile(bool force)
    {
        if (_fileBytes == null) return;

        _errorMessage = null;
        _isProcessing = true;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(_fileBytes);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            content.Add(fileContent, "file", _selectedFileName);
            content.Add(new StringContent(force ? "true" : "false"), "force");

            var response = await Http.PostAsync($"api/campaigns/{CampaignId}/labors/import/upload", content);

            if (response.IsSuccessStatusCode)
            {
                _uploadResult = await response.Content.ReadFromJsonAsync<LaborImportUploadResultDto>(
                    AppJsonSerializerContext.Default.LaborImportUploadResultDto);

                if (_uploadResult != null)
                {
                    _step = 2;
                    if (!_uploadResult.DuplicateOfBatchId.HasValue && _uploadResult.Success)
                        Message.Success("¡Importación procesada!");
                    await OnLaborsImported.InvokeAsync();
                }
                else
                {
                    _errorMessage = "No se pudo procesar el archivo.";
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(errorText) ? "Error al procesar el archivo Excel." : errorText;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ocurrió un error al importar: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void GoToPending()
    {
        Nav.NavigateTo("/importaciones-pendientes");
        _ = HandleClose();
    }

    private async Task ResetImport()
    {
        _step = 1;
        _uploadResult = null;
        _errorMessage = null;
        _fileBytes = null;
        _selectedFileName = string.Empty;
        await Task.CompletedTask;
    }

    private async Task FinishAndClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnLaborsImported.InvokeAsync();
        await ResetImport();
    }

    private async Task HandleClose()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await ResetImport();
    }
}
