@using GestorOT.Shared
@using GestorOT.Shared.Dtos
@using GestorOT.Domain.Enums
@using System.Net.Http.Json
@using AntDesign
@inject HttpClient Http
@inject IMessageService Message

@if (Preview == null)
{
    <Spin Tip="Cargando conciliación..." />
}
else
{
    <Tabs DefaultActiveKey="reconciliation">
        <!-- TAB 1: RECONCILIACIÓN DE INSUMOS -->
        <TabPane Key="reconciliation">
            <TabTemplate>
                <span>
                    <Icon Type="tags" /> Reconciliación de Insumos
                    @if (Preview.UnmatchedSuppliesCount > 0)
                    {
                        <Badge Count="@Preview.UnmatchedSuppliesCount" Style="margin-left: 6px; background-color: #E74C3C;" />
                    }
                    else
                    {
                        <Icon Type="check-circle" Theme="IconThemeType.Fill" Style="color: #2ECC71; margin-left: 6px;" />
                    }
                </span>
            </TabTemplate>
            <ChildContent>
                <div style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 13px; color: rgba(255,255,255,0.7);">
                        Verificá cómo machea cada insumo de la planilla con tu catálogo. Podés corregir sugerencias o crear productos nuevos.
                    </span>
                    <div style="display: flex; gap: 8px;">
                        <Button Size="@ButtonSize.Small" OnClick="AcceptAllHighConfidence" Style="border-radius: 6px; font-size: 12px;">
                            <Icon Type="check" /> Confirmar sugerencias altas
                        </Button>
                    </div>
                </div>

                <div style="max-height: 420px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead style="background: rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1;">
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;">
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Insumo en Excel</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 120px;">Uso y Dosis</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 150px;">Certeza / Semáforo</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Mapeo en Gestor-OT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var map in Preview.SupplyMappings)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: @(map.ConfidenceLevel == "None" ? "rgba(231, 76, 60, 0.05)" : "transparent");">
                                    <td style="padding: 10px 12px;">
                                        <strong style="color: #fff; display: block;">@map.RawName</strong>
                                        <span style="font-size: 11px; color: rgba(255,255,255,0.5);">@map.DetectedCategory &bull; @map.DetectedUnit</span>
                                    </td>
                                    <td style="padding: 10px 12px; color: rgba(255,255,255,0.8);">
                                        <span>@map.Occurrences veces</span><br />
                                        <span style="font-size: 11px; color: rgba(255,255,255,0.5);">Prom: @map.AverageDose @map.DetectedUnit</span>
                                    </td>
                                    <td style="padding: 10px 12px;">
                                        @if (map.IsFromAlias)
                                        {
                                            <Tag Color="@("green")"><Icon Type="check-circle" /> Alias Guardado (100%)</Tag>
                                        }
                                        else if (map.Confidence >= 0.85)
                                        {
                                            <Tag Color="@("green")"><Icon Type="check" /> Exacto (@((int)(map.Confidence * 100))%)</Tag>
                                        }
                                        else if (map.Confidence >= 0.70)
                                        {
                                            <Tag Color="@("orange")"><Icon Type="question-circle" /> Sugerido (@((int)(map.Confidence * 100))%)</Tag>
                                        }
                                        else
                                        {
                                            <Tag Color="@("red")"><Icon Type="close-circle" /> Sin coincidencia</Tag>
                                        }
                                    </td>
                                    <td style="padding: 10px 12px;">
                                        <div style="display: flex; gap: 8px; align-items: center;">
                                            <RadioGroup TValue="string" Value="@map.Action" Size="@InputSize.Small" OnChange="@(val => OnActionChanged(map, val))">
                                                <Radio RadioButton Value="@("Match")">Asignar Existente</Radio>
                                                <Radio RadioButton Value="@("CreateNew")">+ Crear Nuevo</Radio>
                                                <Radio RadioButton Value="@("Ignore")">Ignorar</Radio>
                                            </RadioGroup>
                                        </div>

                                        @if (map.Action == "Match")
                                        {
                                            <div style="margin-top: 6px;">
                                                <Select TItem="InventoryDto" TItemValue="Guid?"
                                                        @bind-Value="map.MatchedSupplyId"
                                                        DataSource="@_inventoryList"
                                                        ItemLabel="x => x.ItemName"
                                                        ItemValue="x => (Guid?)x.Id"
                                                        Placeholder="Seleccionar insumo de inventario..."
                                                        EnableSearch="true"
                                                        Style="width: 100%;"
                                                        OnSelectedItemChanged="@(item => OnSupplySelected(map, item))" />
                                            </div>
                                        }
                                        else if (map.Action == "CreateNew")
                                        {
                                            <div style="margin-top: 6px; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 6px;">
                                                <Input @bind-Value="map.NewItemName" Placeholder="Nombre del insumo" Size="@InputSize.Small" />
                                                <Input @bind-Value="map.NewCategory" Placeholder="Categoría" Size="@InputSize.Small" />
                                                <Input @bind-Value="map.NewUnit" Placeholder="Unidad (l/kg)" Size="@InputSize.Small" />
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TabPane>

        <!-- TAB 2: RECONCILIACIÓN DE TIPOS DE LABOR -->
        <TabPane Key="labor-types">
            <TabTemplate>
                <span>
                    <Icon Type="tool" /> Reconciliación de Labores (@Preview.LaborTypeMappings.Count)
                    @if (Preview.UnmatchedLaborTypesCount > 0)
                    {
                        <Tag Color="@("orange")" Style="margin-left: 6px; font-size: 11px;">@Preview.UnmatchedLaborTypesCount a revisar</Tag>
                    }
                    else
                    {
                        <Icon Type="check-circle" Theme="IconThemeType.Fill" Style="color: #2ECC71; margin-left: 6px;" />
                    }
                </span>
            </TabTemplate>
            <ChildContent>
                <div style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 13px; color: rgba(255,255,255,0.7);">
                        Verificá cómo machea cada Tipo de Labor de la planilla con el catálogo oficial del ERP. Podés confirmar las sugerencias o seleccionar el concepto correspondiente. El sistema memorizará la asociación automáticamente.
                    </span>
                    <div style="display: flex; gap: 8px;">
                        <Button Size="@ButtonSize.Small" OnClick="AcceptAllHighConfidenceLaborTypes" Style="border-radius: 6px; font-size: 12px;">
                            <Icon Type="check" /> Confirmar sugerencias altas
                        </Button>
                    </div>
                </div>

                <div style="max-height: 420px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead style="background: rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1;">
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;">
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Labor en Excel</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 120px;">Ocurrencias</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 160px;">Certeza / Semáforo</th>
                                <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Concepto ERP en Gestor-OT</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var map in Preview.LaborTypeMappings)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: @(map.ConfidenceLevel == "None" ? "rgba(231, 76, 60, 0.05)" : "transparent");">
                                    <td style="padding: 10px 12px;">
                                        <strong style="color: #fff; display: block;">@map.RawName</strong>
                                    </td>
                                    <td style="padding: 10px 12px; color: rgba(255,255,255,0.8);">
                                        <span>@map.Occurrences labores</span>
                                    </td>
                                    <td style="padding: 10px 12px;">
                                        @if (map.IsFromAlias)
                                        {
                                            <Tag Color="@("cyan")"><Icon Type="star" /> Alias Memorizado</Tag>
                                        }
                                        else if (map.Confidence >= 1.0 && map.MatchedLaborTypeId.HasValue)
                                        {
                                            <Tag Color="@("green")"><Icon Type="check" /> Exacto (100%)</Tag>
                                        }
                                        else if (map.SuggestedLaborTypeId.HasValue && !map.MatchedLaborTypeId.HasValue)
                                        {
                                            <Tag Color="@("orange")"><Icon Type="bulb" /> Sugerencia (@((int)(map.Confidence * 100))%)</Tag>
                                        }
                                        else if (map.SuggestedLaborTypeId.HasValue && map.MatchedLaborTypeId == map.SuggestedLaborTypeId)
                                        {
                                            <Tag Color="@("green")"><Icon Type="check" /> Sugerencia Aceptada</Tag>
                                        }
                                        else if (map.MatchedLaborTypeId.HasValue)
                                        {
                                            <Tag Color="@("blue")"><Icon Type="link" /> Asignado</Tag>
                                        }
                                        else
                                        {
                                            <Tag Color="@("red")"><Icon Type="close-circle" /> Sin coincidencia</Tag>
                                        }
                                    </td>
                                    <td style="padding: 10px 12px;">
                                        <div style="display: flex; flex-direction: column; gap: 6px;">
                                            @if (map.SuggestedLaborTypeId.HasValue && !map.MatchedLaborTypeId.HasValue)
                                            {
                                                <div>
                                                    <Button Size="@ButtonSize.Small" Type="@ButtonType.Dashed" OnClick="@(() => AcceptSuggestion(map))" Style="color: #F39C12; border-color: #F39C12; font-size: 12px;">
                                                        <Icon Type="check" /> Sugerido: Vincular con '@map.SuggestedLaborTypeName'
                                                    </Button>
                                                </div>
                                            }
                                            @{
                                                var modeFilter = ModeForMapping(map);
                                            }
                                            <Select TItem="LaborTypeDto" TItemValue="Guid?"
                                                    @bind-Value="map.MatchedLaborTypeId"
                                                    DataSource="@LaborTypesFor(map)"
                                                    ItemLabel="x => x.DisplayName"
                                                    ItemValue="x => (Guid?)x.Id"
                                                    Placeholder="Seleccionar concepto del ERP..."
                                                    EnableSearch="true"
                                                    Style="width: 100%;"
                                                    OnSelectedItemChanged="@(item => OnLaborTypeSelected(map, item))" />
                                            @if (modeFilter is not null)
                                            {
                                                <span style="font-size: 10px; color: rgba(255,255,255,0.45);">
                                                    Filtrado a tareas @(modeFilter == LaborExecutionMode.Contractor ? "de contratista" : "propias"),
                                                    según la columna Contratista del Excel
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="font-size: 10px; color: #F39C12;">
                                                    Este nombre aparece en filas propias y de contratista: se muestran todas las tareas
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TabPane>

        <!-- TAB: RECONCILIACIÓN DE PROVEEDORES DE INSUMOS (OT-26) -->
        @if (Preview.SupplierMappings.Count > 0)
        {
            <TabPane Key="suppliers">
                <TabTemplate>
                    <span>
                        <Icon Type="shop" /> Proveedores de Insumos (@Preview.SupplierMappings.Count)
                        @if (Preview.UnmatchedSuppliersCount > 0)
                        {
                            <Badge Count="@Preview.UnmatchedSuppliersCount" Style="margin-left: 6px; background-color: #F39C12;" />
                        }
                        else
                        {
                            <Icon Type="check-circle" Theme="IconThemeType.Fill" Style="color: #2ECC71; margin-left: 6px;" />
                        }
                    </span>
                </TabTemplate>
                <ChildContent>
                    <div style="margin-bottom: 12px;">
                        <span style="font-size: 13px; color: rgba(255,255,255,0.7);">
                            Nombres detectados en la columna "Contr/Prove" de las filas de insumo. Podés vincularlos a un contacto existente;
                            si dejás alguno sin vincular, la fila queda pendiente de revisión.
                        </span>
                    </div>

                    <div style="max-height: 420px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                            <thead style="background: rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1;">
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;">
                                    <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Proveedor en Excel</th>
                                    <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 100px;">Ocurrencias</th>
                                    <th style="padding: 10px 12px; color: rgba(255,255,255,0.8); width: 150px;">Certeza</th>
                                    <th style="padding: 10px 12px; color: rgba(255,255,255,0.8);">Contacto en Gestor-OT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var map in Preview.SupplierMappings)
                                {
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); background: @(map.ConfidenceLevel == "None" ? "rgba(243, 156, 18, 0.05)" : "transparent");">
                                        <td style="padding: 10px 12px;">
                                            <strong style="color: #fff;">@map.RawName</strong>
                                        </td>
                                        <td style="padding: 10px 12px; color: rgba(255,255,255,0.8);">
                                            @map.Occurrences
                                        </td>
                                        <td style="padding: 10px 12px;">
                                            @if (map.ConfidenceLevel == "High")
                                            {
                                                <Tag Color="@("green")"><Icon Type="check" /> Coincidencia</Tag>
                                            }
                                            else
                                            {
                                                <Tag Color="@("orange")"><Icon Type="question-circle" /> Sin coincidencia</Tag>
                                            }
                                        </td>
                                        <td style="padding: 10px 12px;">
                                            <Select TItem="ContactDto" TItemValue="Guid?"
                                                    @bind-Value="map.MatchedContactId"
                                                    DataSource="@_contactsList"
                                                    ItemLabel="x => x.FullName"
                                                    ItemValue="x => (Guid?)x.Id"
                                                    Placeholder="Sin proveedor asignado"
                                                    AllowClear="true"
                                                    EnableSearch="true"
                                                    Style="width: 100%;"
                                                    OnSelectedItemChanged="@(item => OnSupplierSelected(map, item))" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </TabPane>
        }

        <!-- TAB: LABORES DETECTADAS -->
        <TabPane Key="labors">
            <TabTemplate>
                <span><Icon Type="unordered-list" /> Labores Detectadas (@Preview.TotalLabors)</span>
            </TabTemplate>
            <ChildContent>
                <div style="max-height: 420px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <thead style="background: rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 1;">
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); text-align: left;">
                                @if (ShowSelection)
                                {
                                    <th style="padding: 8px 12px; width: 36px;"></th>
                                }
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8); width: 90px;">Fecha</th>
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8);">Establecimiento / Lote</th>
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8);">Labor y Sup.</th>
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8);">Receta de Insumos</th>
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8); width: 140px;">Responsable</th>
                                <th style="padding: 8px 12px; color: rgba(255,255,255,0.8); width: 100px;">Modo</th>
                                @if (RowStates != null)
                                {
                                    <th style="padding: 8px 12px; color: rgba(255,255,255,0.8); width: 110px;">Estado</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var labor in Preview.Labors)
                            {
                                var state = GetRowState(labor.RowIndex);
                                var isUnresolved = state == null || state == "Unresolved";
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: top; @(isUnresolved ? "" : "opacity: 0.65;")">
                                    @if (ShowSelection)
                                    {
                                        <td style="padding: 8px 12px;">
                                            @if (isUnresolved)
                                            {
                                                <Checkbox Checked="@SelectedRows.Contains(labor.RowIndex)" CheckedChanged="@(() => ToggleSelection(labor.RowIndex))" />
                                            }
                                        </td>
                                    }
                                    <td style="padding: 8px 12px; color: rgba(255,255,255,0.7);">
                                        @(labor.Date?.ToString("dd/MM/yyyy") ?? "-")
                                        <span style="font-size: 10px; color: rgba(255,255,255,0.4); display: block;">fila @labor.RowIndex</span>
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        <strong style="color: #fff;">@labor.LotName</strong>
                                        @if (!string.IsNullOrWhiteSpace(labor.FieldName))
                                        {
                                            <span style="font-size: 11px; color: rgba(255,255,255,0.5); display: block;">@labor.FieldName</span>
                                        }
                                        @if (!labor.LotId.HasValue)
                                        {
                                            <Tag Color="@("red")" Style="font-size: 10px; margin-top: 2px;">Lote no encontrado</Tag>
                                        }
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        <span style="color: #2ECC71; font-weight: 600;">@labor.LaborTypeName</span>
                                        <span style="font-size: 11px; color: rgba(255,255,255,0.6); display: block;">@labor.Hectares.ToString("N1") ha</span>
                                        @foreach (var err in labor.Errors)
                                        {
                                            <Tag Color="@("red")" Style="font-size: 10px; margin-top: 2px; display: block; width: fit-content;">@err</Tag>
                                        }
                                        @if (!IsLaborTypeMapped(labor))
                                        {
                                            <Tag Color="@("orange")" Style="font-size: 10px; margin-top: 2px; display: block; width: fit-content;">Tipo sin vincular al ERP</Tag>
                                        }
                                        @if (HasUnlinkedRefs(labor))
                                        {
                                            <Tag Color="@("gold")" Style="font-size: 10px; margin-top: 2px; display: block; width: fit-content;">Responsable o proveedor sin vincular</Tag>
                                        }
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        @if (labor.Supplies.Count == 0)
                                        {
                                            <span style="color: rgba(255,255,255,0.4); font-style: italic;">Sin insumos</span>
                                        }
                                        else
                                        {
                                            <ul style="margin: 0; padding-left: 16px; color: rgba(255,255,255,0.8); font-size: 12px;">
                                                @foreach (var s in labor.Supplies)
                                                {
                                                    <li>
                                                        <strong>@s.SupplyName:</strong> @s.Dose @s.Unit
                                                        @if (s.MatchedSupplyId.HasValue)
                                                        {
                                                            <Icon Type="check" Style="color: #2ECC71; font-size: 11px; margin-left: 2px;" />
                                                        }
                                                        else
                                                        {
                                                            <Icon Type="close" Style="color: #E74C3C; font-size: 11px; margin-left: 2px;" />
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(s.SupplierRawName))
                                                        {
                                                            <span style="color: rgba(255,255,255,0.5);">
                                                                &bull; Prov: @(s.MatchedSupplierName ?? s.SupplierRawName)
                                                                @if (!s.SupplierContactId.HasValue)
                                                                {
                                                                    <Icon Type="warning" Style="color: #F39C12; font-size: 11px; margin-left: 2px;" />
                                                                }
                                                            </span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        @if (!string.IsNullOrWhiteSpace(labor.MatchedContactName))
                                        {
                                            <span style="color: #fff; font-weight: 500;">@labor.MatchedContactName</span>
                                            <Tag Color="@(labor.IsExternalBilling ? "orange" : "green")" Style="font-size: 10px; margin-top: 2px; display: block; width: fit-content;">
                                                @(labor.IsExternalBilling ? "Contratista" : "Propio")
                                            </Tag>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(labor.Contractor))
                                        {
                                            <span style="color: rgba(255,255,255,0.8);">@labor.Contractor</span>
                                            <Tag Color="@(labor.IsExternalBilling ? "orange" : "default")" Style="font-size: 10px; margin-top: 2px; display: block; width: fit-content;">
                                                @(labor.IsExternalBilling ? "Contratista" : "Propio")
                                            </Tag>
                                        }
                                        else
                                        {
                                            <span style="color: rgba(255,255,255,0.3);">—</span>
                                        }
                                    </td>
                                    <td style="padding: 8px 12px;">
                                        <Tag Color="@(labor.Mode == "Realized" ? "blue" : "default")">
                                            @(labor.Mode == "Realized" ? "Realizada" : "Planeada")
                                        </Tag>
                                    </td>
                                    @if (RowStates != null)
                                    {
                                        <td style="padding: 8px 12px;">
                                            @if (state == "Imported")
                                            {
                                                <Tag Color="@("green")">Importada</Tag>
                                            }
                                            else if (state == "Excluded")
                                            {
                                                <Tag Color="@("default")">Descartada</Tag>
                                            }
                                            else
                                            {
                                                <Tag Color="@("orange")">Pendiente</Tag>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </TabPane>

        <!-- TAB: DIAGNÓSTICO -->
        @if (Preview.Diagnostics.Count > 0)
        {
            <TabPane Key="diagnostics">
                <TabTemplate>
                    <span><Icon Type="warning" Style="color: #F39C12;" /> Diagnósticos (@Preview.Diagnostics.Count)</span>
                </TabTemplate>
                <ChildContent>
                    <div style="background: rgba(243, 156, 18, 0.08); border: 1px solid rgba(243, 156, 18, 0.2); border-radius: 8px; padding: 16px;">
                        <ul style="margin: 0; padding-left: 20px; color: rgba(255,255,255,0.85); font-size: 13px; line-height: 1.8;">
                            @foreach (var d in Preview.Diagnostics)
                            {
                                <li>@d</li>
                            }
                        </ul>
                    </div>
                </ChildContent>
            </TabPane>
        }
    </Tabs>
}

@code {
    [Parameter] public LaborImportPreviewDto? Preview { get; set; }
    /// <summary>Estado de resolución por fila (RowIndex → Unresolved/Imported/Excluded). Null = sin columna de estado.</summary>
    [Parameter] public Dictionary<int, string>? RowStates { get; set; }
    [Parameter] public bool ShowSelection { get; set; }
    [Parameter] public HashSet<int> SelectedRows { get; set; } = new();
    [Parameter] public EventCallback<HashSet<int>> SelectedRowsChanged { get; set; }
    [Parameter] public EventCallback OnMappingsChanged { get; set; }

    private List<InventoryDto> _inventoryList = new();
    private List<LaborTypeDto> _laborTypesList = new();
    private List<ContactDto> _contactsList = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadInventory(), LoadLaborTypes(), LoadContacts());
    }

    private string? GetRowState(int rowIndex)
    {
        if (RowStates == null) return null;
        return RowStates.TryGetValue(rowIndex, out var state) ? state : "Unresolved";
    }

    private async Task ToggleSelection(int rowIndex)
    {
        if (SelectedRows.Contains(rowIndex))
            SelectedRows.Remove(rowIndex);
        else
            SelectedRows.Add(rowIndex);
        await SelectedRowsChanged.InvokeAsync(SelectedRows);
    }

    private bool IsLaborTypeMapped(LaborImportParsedLaborDto labor)
    {
        if (labor.LaborTypeId.HasValue) return true;
        if (Preview == null) return false;
        var map = Preview.LaborTypeMappings.FirstOrDefault(m =>
            string.Equals(m.RawName?.Trim(), labor.LaborTypeName?.Trim(), StringComparison.OrdinalIgnoreCase));
        return map?.MatchedLaborTypeId.HasValue == true;
    }

    private bool HasUnlinkedRefs(LaborImportParsedLaborDto labor)
    {
        if (!string.IsNullOrWhiteSpace(labor.Contractor) && !labor.ContactId.HasValue
            && !IsPropioLike(labor.Contractor))
            return true;
        return labor.Supplies.Any(s => !string.IsNullOrWhiteSpace(s.SupplierRawName) && !s.SupplierContactId.HasValue);
    }

    private static bool IsPropioLike(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return true;
        var norm = raw.Trim().ToLowerInvariant();
        return norm == "propio" || norm == "equipo propio" || norm == "personal propio" || norm == "propia";
    }

    private LaborExecutionMode? ModeForMapping(LaborImportTypeMappingDto map)
    {
        if (Preview == null) return null;

        var rows = Preview.Labors
            .Where(l => string.Equals(l.LaborTypeName?.Trim(), map.RawName?.Trim(),
                StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (rows.Count == 0) return null;

        var external = rows.Select(l => l.IsExternalBilling).Distinct().ToList();
        if (external.Count != 1) return null;

        return external[0] ? LaborExecutionMode.Contractor : LaborExecutionMode.Own;
    }

    private List<LaborTypeDto> LaborTypesFor(LaborImportTypeMappingDto map)
    {
        var mode = ModeForMapping(map);
        if (mode is null) return _laborTypesList;

        var matching = _laborTypesList
            .Where(t => t.ExecutionMode.MatchesFilter(mode.Value))
            .ToList();

        if (map.MatchedLaborTypeId.HasValue && matching.All(t => t.Id != map.MatchedLaborTypeId.Value))
        {
            var current = _laborTypesList.FirstOrDefault(t => t.Id == map.MatchedLaborTypeId.Value);
            if (current != null)
            {
                matching.Insert(0, current);
            }
        }

        return matching;
    }

