    private async Task NotifyMappingsChanged()
    {
        await OnMappingsChanged.InvokeAsync();
    }

    private async Task OnActionChanged(LaborImportSupplyMappingDto map, object? val)
    {
        map.Action = val?.ToString() ?? "Match";
        // El usuario tocó la fila a mano: recién acá "CreateNew" puede crear inventario
        // al importar. El default del algoritmo llega con Confirmed=false.
        map.Confirmed = true;
        if (map.Action == "CreateNew")
        {
            map.NewItemName ??= map.RawName;
            map.NewCategory ??= (!string.IsNullOrWhiteSpace(map.DetectedCategory) ? map.DetectedCategory : "Insumos");
            map.NewUnit ??= (!string.IsNullOrWhiteSpace(map.DetectedUnit) ? map.DetectedUnit : "unidad");
        }
        await NotifyMappingsChanged();
    }

    private async Task OnSupplySelected(LaborImportSupplyMappingDto map, InventoryDto? selected)
    {
        if (selected != null)
        {
            map.MatchedSupplyId = selected.Id;
            map.MatchedSupplyName = selected.ItemName;
            map.Confidence = 1.0;
            map.ConfidenceLevel = "High";
            map.Confirmed = true;
        }
        await NotifyMappingsChanged();
    }

    private async Task AcceptAllHighConfidence()
    {
        if (Preview == null) return;
        foreach (var map in Preview.SupplyMappings)
        {
            if (map.Confidence >= 0.70 && map.MatchedSupplyId.HasValue)
            {
                map.Action = "Match";
                map.Confirmed = true;
            }
        }
        Message.Success("Sugerencias de insumos confirmadas.");
        await NotifyMappingsChanged();
    }

    private async Task OnSupplierSelected(LaborImportSupplierMappingDto map, ContactDto? selected)
    {
        map.MatchedContactId = selected?.Id;
        map.MatchedContactName = selected?.FullName;
        map.Confidence = selected != null ? 1.0 : 0.0;
        map.ConfidenceLevel = selected != null ? "High" : "None";
        map.Action = "Match";
        await NotifyMappingsChanged();
    }

    private async Task OnLaborTypeSelected(LaborImportTypeMappingDto map, LaborTypeDto? selected)
    {
        if (selected != null)
        {
            map.MatchedLaborTypeId = selected.Id;
            map.MatchedLaborTypeName = selected.Name;
            map.Confidence = 1.0;
            map.ConfidenceLevel = "High";
        }
        await NotifyMappingsChanged();
    }

    private async Task AcceptSuggestion(LaborImportTypeMappingDto map)
    {
        if (map.SuggestedLaborTypeId.HasValue)
        {
            map.MatchedLaborTypeId = map.SuggestedLaborTypeId;
            map.MatchedLaborTypeName = map.SuggestedLaborTypeName;
        }
        await NotifyMappingsChanged();
    }

    private async Task AcceptAllHighConfidenceLaborTypes()
    {
        if (Preview == null) return;
        foreach (var map in Preview.LaborTypeMappings)
        {
            if (map.SuggestedLaborTypeId.HasValue && !map.MatchedLaborTypeId.HasValue)
            {
                map.MatchedLaborTypeId = map.SuggestedLaborTypeId;
                map.MatchedLaborTypeName = map.SuggestedLaborTypeName;
            }
        }
        Message.Success("Sugerencias de tipos de labor vinculadas.");
        await NotifyMappingsChanged();
    }
