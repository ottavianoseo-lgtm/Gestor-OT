@using GestorOT.Shared.Dtos

@ChildContent

@code {
    // La empresa elegida se guarda en localStorage y se recupera en Program.cs al arrancar.
    // Antes se intentaba con [PersistentState], que solo funciona cuando el servidor prerenderiza:
    // App.razor usa prerender: false, asi que no se persistia nada y cada recarga dejaba al
    // SuperAdmin sin empresa seleccionada, viendo datos de todas.

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
