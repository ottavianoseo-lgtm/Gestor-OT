@inherits LayoutComponentBase

<div class="auth-layout">
    <main class="auth-content">
        @Body
    </main>
</div>

<style>
    .auth-layout {
        min-height: 100vh;
        width: 100vw;
        background: radial-gradient(circle at 50% 30%, #1e1e2e 0%, #0f0f1a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
    }

    .auth-content {
        width: 100%;
        max-width: 440px;
    }
</style>
